@namespace CarStoreManager.Web.Components.Concessionaria

<div class="vcard" data-tour="conc-card-exemplo" @onclick="OnClick">
    <div class="vcard-img">
        @if (Veiculo.FotoPrincipal is not null)
        {
            <img src="@Veiculo.FotoPrincipal" alt="@Veiculo.Marca @Veiculo.Modelo" />
        }
        else
        {
            <div class="vcard-no-foto">Sem foto</div>
        }
        <span class="badge @BadgeClass">@RotuloStatus</span>
        @if (Veiculo.IsConsignado)
        {
            <span class="badge badge-consignado">Consignado</span>
        }
    </div>

    <div class="vcard-body">
        <div class="vcard-nome">@Veiculo.Marca @Veiculo.Modelo</div>
        <div class="vcard-sub">@Veiculo.Ano · @Veiculo.Combustivel · @RotuloStatus</div>
        <div class="vcard-preco">@Veiculo.Valor.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
        <div class="vcard-tags">
            <span class="vtag">@Veiculo.Quilometragem.ToString("N0") km</span>
            @if (Veiculo.IsConsignado && Veiculo.EstaVencido)
            {
                <span class="vtag vtag-vencido">Consignação vencida</span>
            }
            else if (Veiculo.IsConsignado && Veiculo.StatusLabel == "Ativa" && Veiculo.DiasRestantes <= 7)
            {
                <span class="vtag vtag-vencendo">Vence em @Veiculo.DiasRestantes dia(s)</span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public VeiculoListaUnificadoDTO Veiculo { get; set; } = null!;
    [Parameter] public EventCallback OnClick { get; set; }

    private string RotuloStatus => Veiculo.IsConsignado ? RotuloStatusConsignacao(Veiculo.StatusLabel) : Veiculo.StatusLabel;

    private static string RotuloStatusConsignacao(string status) => status switch
    {
        "Ativa" => "Disponível",
        "Expirada" => "Prazo expirado",
        "VendidoAguardandoPagamento" => "Vendido (aguard. pagamento)",
        "Concluida" => "Vendido",
        "Devolvida" => "Devolvida",
        "Cancelada" => "Cancelada",
        _ => status
    };

    private string BadgeClass
    {
        get
        {
            if (Veiculo.IsConsignado)
            {
                return Veiculo.StatusLabel switch
                {
                    "Ativa" => "badge-disponivel",
                    "Concluida" or "VendidoAguardandoPagamento" => "badge-vendido",
                    _ => "badge-reservado"
                };
            }

            return Veiculo.StatusLabel switch
            {
                "Disponivel" => "badge-disponivel",
                "Vendido" => "badge-vendido",
                _ => "badge-reservado"
            };
        }
    }
}

<style>
    .vcard {
        background: #fff;
        border-radius: 10px;
        border: 0.5px solid #e0e0e0;
        overflow: hidden;
        cursor: pointer;
        transition: border-color 0.2s, transform 0.15s;
    }

    .vcard:hover {
        border-color: #e02020;
        transform: translateY(-2px);
    }

    .vcard-img {
        position: relative;
        height: 160px;
        background: #1a1a1a;
        overflow: hidden;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .vcard-img img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .vcard-no-foto {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        font-size: 13px;
    }

    .vcard-img .badge {
        position: relative;
        margin: 10px 0 0 10px;
        z-index: 1;
    }
    .vcard-img .badge-consignado {
        margin: 10px 10px 0 0;
        margin-left: auto;
    }

    .vcard-body { padding: 12px 14px; }

    .vcard-nome {
        font-size: 15px;
        font-weight: 500;
        color: #1a1a1a;
        margin-bottom: 2px;
    }

    .vcard-sub {
        font-size: 12px;
        color: #888;
        margin-bottom: 8px;
    }

    .vcard-preco {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .vcard-tags { display: flex; gap: 6px; flex-wrap: wrap; }

    .vtag {
        background: #f4f4f4;
        border: 0.5px solid #e0e0e0;
        border-radius: 4px;
        font-size: 11px;
        color: #555;
        padding: 2px 8px;
    }
    .vtag-vencido { background: #fff5f5; color: #e02020; border-color: #fca5a5; }
    .vtag-vencendo { background: #fff7ed; color: #ea580c; border-color: #fed7aa; }

    .badge {
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 500;
    }
    .badge-disponivel { background: #dcfce7; color: #166534; }
    .badge-vendido { background: #f1f1f1; color: #666; }
    .badge-reservado { background: #fef9c3; color: #854d0e; }
    .badge-consignado { background: #eef2ff; color: #3730a3; }
</style>
