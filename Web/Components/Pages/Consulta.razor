@page "/consulta"
@page "/consulta/{Codigo}"
@layout CarStoreManager.Web.Layout.LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer

@namespace CarStoreManager.Web.Components.Pages

@inject IConsultaPublicaService ConsultaService
@inject NavigationManager Nav
@inject CarStoreManager.Web.Tours.TourEstadoService TourEstado

@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.DTOs.Oficina.OrdemServico
@using Microsoft.AspNetCore.Components.Web

<PageTitle>DELORE — Consultar ordem de serviço</PageTitle>

<CarStoreManager.Web.Components.Shared.TourGuiado />

<div class="consulta-page">
    <div class="consulta-topo">
        <div class="logo-topo">
            <span class="logo-texto">DE</span><span class="logo-destaque">LORE</span>
        </div>
        <div class="topo-acoes">
            <button class="tour-btn-ajuda" @onclick="AbrirTourAsync" title="Ajuda desta tela" aria-label="Ajuda desta tela">?</button>
            <a class="link-login" href="/login">Acesso interno →</a>
        </div>
    </div>

    <div class="consulta-container">
        <div class="busca-card" data-tour="consulta-busca">
            <h1 class="busca-titulo">Acompanhe seu veículo na oficina</h1>
            <p class="busca-sub">
                Informe seu <strong>CPF</strong> e a <strong>placa</strong> de um dos seus veículos
                para ver as ordens de serviço e o histórico de atendimentos.
            </p>

            <div class="busca-campos">
                <input class="busca-input @(erro is not null ? "erro" : "")" type="text"
                       placeholder="CPF" maxlength="14" @bind="cpf" @bind:event="oninput" @onkeydown="TeclaPressionada" />
                <input class="busca-input @(erro is not null ? "erro" : "")" type="text"
                       placeholder="Placa (ex: ABC1D23)" maxlength="8" @bind="placa" @bind:event="oninput"
                       @onkeydown="TeclaPressionada" style="text-transform:uppercase" />
                <button class="btn-buscar" @onclick="Buscar" disabled="@buscando">
                    @(buscando ? "Buscando..." : "Consultar")
                </button>
            </div>

            @if (erro is not null)
            {
                <div class="erro-banner">@erro</div>
            }
        </div>

        @if (resultado is not null)
        {
            <div class="resultado">
                <p class="ola">Olá, @resultado.PrimeiroNome 👋</p>

                @if (resultado.OrdemEmAberto is not null)
                {
                    var os = resultado.OrdemEmAberto;
                    <div class="destaque-card" data-tour="consulta-aberta">
                        <div class="destaque-head">
                            <span class="rot">Ordem em andamento</span>
                            <span class="os-num">@os.NumeroPublico</span>
                        </div>
                        <div class="trilha">
                            @foreach (var e in Trilha(os.Status))
                            {
                                <div class="trilha-etapa @e.status">
                                    <span class="trilha-bola">@(e.status == "ok" ? "✓" : e.numero.ToString())</span>
                                    <span class="trilha-label">@e.label</span>
                                </div>
                            }
                        </div>
                        <div class="os-info">
                            <div><span class="k">Serviço</span><span class="v">@os.Tipo</span></div>
                            <div><span class="k">Aberta em</span><span class="v">@os.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</span></div>
                            <div><span class="k">Prazo estimado</span><span class="v">@os.PrazoEstimado.ToLocalTime().ToString("dd/MM/yyyy")</span></div>
                            <div><span class="k">Valor</span><span class="v destaque">@Moeda(os.ValorTotal)</span></div>
                        </div>
                        @if (os.Checklist.Any())
                        {
                            <div class="checklist">
                                <span class="k">Etapas do serviço (@os.Checklist.Count(c => c.Status == "Concluido")/@os.Checklist.Count concluídas)</span>
                                @foreach (var c in os.Checklist)
                                {
                                    <div class="check @(c.Status == "Concluido" ? "feito" : "")">
                                        <span class="cb">@(c.Status == "Concluido" ? "✓" : c.Status == "EmAndamento" ? "●" : "")</span>
                                        @c.Descricao
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="veiculos" data-tour="consulta-veiculos">
                    @foreach (var v in resultado.Veiculos)
                    {
                        <div class="veiculo-card">
                            <div class="veiculo-head">
                                <div>
                                    <span class="veiculo-nome">@v.Descricao</span>
                                    <span class="veiculo-placa">@v.Placa</span>
                                </div>
                                <span class="veiculo-count">@v.Historico.Count atendimento(s)</span>
                            </div>
                            @if (!v.Historico.Any())
                            {
                                <p class="sem-hist">Nenhum atendimento registrado para este veículo.</p>
                            }
                            else
                            {
                                <div class="hist">
                                    @foreach (var h in v.Historico)
                                    {
                                        <div class="hist-linha">
                                            <span class="hl-data">@h.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                            <span class="hl-os">@h.NumeroPublico</span>
                                            <span class="hl-tipo">@h.Tipo</span>
                                            <span class="hl-status">@StatusLabel(h.Status)</span>
                                            <span class="hl-valor">@Moeda(h.ValorTotal)</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <p class="rodape">Consulta feita em @DateTime.Now.ToString("dd/MM/yyyy HH:mm"). Dúvidas? Fale com a oficina.</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Codigo { get; set; }

    private string cpf = "";
    private string placa = "";
    private string? erro;
    private bool buscando;
    private ConsultaPublicaResultadoDTO? resultado;

    private static string Moeda(decimal v) => v.ToString("C", new System.Globalization.CultureInfo("pt-BR"));

    private async Task Buscar()
    {
        erro = null;
        resultado = null;
        buscando = true;
        try
        {
            var r = await ConsultaService.ConsultarPorCpfEPlacaAsync(cpf, placa);
            if (r.IsSuccess) resultado = r.Value;
            else erro = r.Error;
        }
        finally { buscando = false; }
    }

    private async Task TeclaPressionada(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Buscar();
    }

    private async Task AbrirTourAsync() => await TourEstado.SolicitarTourAsync();

    private static string StatusLabel(string s) => s switch
    {
        "Pendente" or "BuscandoPecasParaOrcamento" => "Em orçamento",
        "EmAnalise" => "Em revisão",
        "AguardandoCliente" or "Pausada" => "Aguardando você",
        "Aprovada" => "Aprovada",
        "EmAndamento" => "Em andamento",
        "PagamentoPendente" => "Aguardando pagamento",
        "Finalizada" => "Pronta para retirada",
        "Entregue" => "Entregue",
        "Cancelada" => "Cancelada",
        _ => s
    };

    private static IEnumerable<(int numero, string label, string status)> Trilha(string status)
    {
        int atual = status switch
        {
            "Pendente" or "BuscandoPecasParaOrcamento" => 1,
            "EmAnalise" => 2,
            "AguardandoCliente" => 3,
            "Aprovada" => 4,
            "EmAndamento" or "Pausada" => 5,
            "PagamentoPendente" or "Finalizada" or "Entregue" => 6,
            "Cancelada" => 0,
            _ => 1
        };
        var etapas = new (int, string)[]
        {
            (1, "Orçamento"), (2, "Em revisão"), (3, "Aguardando você"),
            (4, "Aprovada"), (5, "Em andamento"), (6, "Concluída")
        };
        foreach (var (n, l) in etapas)
        {
            var st = atual == 0 ? "cancelada" : n < atual ? "ok" : n == atual ? "atual" : "pendente";
            yield return (n, l, st);
        }
    }
}

<style>
    .consulta-page { min-height: 100vh; background: #f7f7f8; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
    .consulta-topo { background: #111; padding: 18px 32px; display: flex; align-items: center; justify-content: space-between; }
    .logo-topo { font-size: 20px; font-weight: 700; letter-spacing: 2px; }
    .logo-texto { color: #fff; } .logo-destaque { color: #e02020; }
    .topo-acoes { display: flex; align-items: center; gap: 14px; }
    .link-login { color: #aaa; font-size: 13px; text-decoration: none; }
    .link-login:hover { color: #fff; }
    .tour-btn-ajuda { width: 26px; height: 26px; border-radius: 50%; border: 1px solid #555; background: transparent; color: #ccc; font-size: 13px; font-weight: 600; cursor: pointer; }
    .tour-btn-ajuda:hover { background: #2a2a2a; color: #fff; }

    .consulta-container { max-width: 860px; margin: 0 auto; padding: 40px 24px; }
    .busca-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 16px; padding: 36px 32px; text-align: center; }
    .busca-titulo { font-size: 24px; font-weight: 600; margin: 0 0 8px; color: #1a1a1a; }
    .busca-sub { color: #666; font-size: 14px; margin: 0 0 24px; line-height: 1.5; }
    .busca-campos { display: flex; gap: 10px; max-width: 560px; margin: 0 auto; flex-wrap: wrap; }
    .busca-input { flex: 1; min-width: 140px; background: #fff; border: 1px solid #ccc; border-radius: 10px; padding: 12px 16px; font-size: 15px; outline: none; }
    .busca-input:focus { border-color: #2563eb; }
    .busca-input.erro { border-color: #e02020; }
    .btn-buscar { background: #e02020; color: #fff; border: none; border-radius: 10px; padding: 12px 22px; font-size: 14px; font-weight: 500; cursor: pointer; }
    .btn-buscar:hover:not(:disabled) { background: #c01818; }
    .btn-buscar:disabled { opacity: .6; cursor: not-allowed; }
    .erro-banner { background: rgba(224,32,32,.08); border: 1px solid rgba(224,32,32,.3); border-radius: 8px; padding: 10px 14px; font-size: 13px; color: #e02020; margin: 16px auto 0; max-width: 560px; }

    .resultado { margin-top: 24px; display: flex; flex-direction: column; gap: 16px; }
    .ola { font-size: 16px; font-weight: 500; color: #1a1a1a; margin: 0; }

    .destaque-card { background: #fff; border: 1px solid #fdba74; border-radius: 14px; padding: 20px; }
    .destaque-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    .destaque-head .rot { font-size: 12px; color: #c2410c; text-transform: uppercase; font-weight: 600; letter-spacing: .5px; }
    .os-num { font-family: monospace; font-weight: 700; color: #2563eb; background: #eff6ff; padding: 3px 10px; border-radius: 6px; }

    .trilha { display: flex; gap: 4px; overflow-x: auto; padding: 12px 0; }
    .trilha-etapa { display: flex; align-items: center; gap: 6px; padding: 4px 10px; font-size: 12px; white-space: nowrap; flex: 1; justify-content: center; }
    .trilha-bola { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 12px; }
    .trilha-etapa.pendente .trilha-bola { background: #f4f4f4; color: #aaa; } .trilha-etapa.pendente .trilha-label { color: #aaa; }
    .trilha-etapa.ok .trilha-bola { background: #dcfce7; color: #16a34a; } .trilha-etapa.ok .trilha-label { color: #16a34a; }
    .trilha-etapa.atual .trilha-bola { background: #2563eb; color: #fff; } .trilha-etapa.atual .trilha-label { color: #2563eb; font-weight: 600; }
    .trilha-etapa.cancelada .trilha-bola { background: #fff5f5; color: #e02020; }

    .os-info { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-top: 8px; }
    .os-info .k { display: block; font-size: 11px; color: #888; } .os-info .v { font-size: 14px; font-weight: 500; color: #1a1a1a; }
    .os-info .v.destaque { font-size: 16px; font-weight: 700; }
    .checklist { margin-top: 14px; padding-top: 14px; border-top: 1px solid #f0f0f0; display: flex; flex-direction: column; gap: 6px; }
    .checklist .k { font-size: 12px; color: #888; margin-bottom: 4px; }
    .check { display: flex; align-items: center; gap: 8px; font-size: 13px; padding: 6px 10px; background: #fafafa; border-radius: 8px; }
    .check.feito { color: #666; text-decoration: line-through; background: #f0fdf4; }
    .check .cb { width: 18px; display: inline-block; text-align: center; color: #16a34a; }

    .veiculos { display: flex; flex-direction: column; gap: 14px; }
    .veiculo-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 14px; padding: 18px; }
    .veiculo-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
    .veiculo-nome { font-size: 15px; font-weight: 600; color: #1a1a1a; }
    .veiculo-placa { font-family: monospace; font-size: 13px; color: #888; margin-left: 8px; }
    .veiculo-count { font-size: 12px; color: #888; }
    .sem-hist { font-size: 13px; color: #888; margin: 0; }
    .hist { display: flex; flex-direction: column; }
    .hist-linha { display: grid; grid-template-columns: 90px 100px 1fr auto auto; gap: 10px; align-items: center; padding: 8px 0; border-top: 1px solid #f0f0f0; font-size: 13px; }
    .hl-data { color: #888; } .hl-os { font-family: monospace; color: #2563eb; } .hl-tipo { color: #1a1a1a; }
    .hl-status { font-size: 11px; color: #666; background: #f4f4f4; padding: 2px 8px; border-radius: 10px; white-space: nowrap; }
    .hl-valor { font-weight: 700; color: #1a1a1a; white-space: nowrap; }
    .rodape { font-size: 12px; color: #888; text-align: center; margin: 8px 0 0; }

    @@media (max-width: 600px) {
        .hist-linha { grid-template-columns: 1fr 1fr; }
        .busca-campos { flex-direction: column; }
    }
</style>
