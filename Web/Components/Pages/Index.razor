@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@namespace CarStoreManager.Web.Components.Pages
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.DTOs.Admin
@using CarStoreManager.Web.Components.Shared
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IOrdemServicoService OrdemService
@inject IVeiculoVendaService VeiculoService
@inject IVeiculoConsignacaoService ConsignacaoService
@inject IPropostaVendaService PropostaService
@inject IEstoqueService EstoqueService
@inject IDashboardService DashboardService
@inject IJSRuntime JS
@inject CarStoreManager.Application.Interfaces.Sistema.IBalancoMensalDespesaService BalancoService
@inject CarStoreManager.Application.Interfaces.Sistema.IConfiguracaoSistemaService ConfiguracaoService

<div class="pagina">
    <PageHeader Titulo="@saudacao" Subtitulo="@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))">
        <Acao>
            @if (podeVerFinanceiro)
            {
                <div data-tour="inicio-periodo">
                    <SeletorPeriodo @bind-Inicio="inicio" @bind-Fim="fim" OnAlterado="RecarregarPeriodoAsync" />
                </div>
            }
        </Acao>
    </PageHeader>

    @if (carregando)
    {
        <div class="estado-carregando">Carregando...</div>
    }
    else
    {
    <div class="hub-layout">
        <MenuAtalhos Itens="atalhos" data-tour="inicio-hub-atalhos" />
        <div class="hub-conteudo">
        <div data-tour="inicio-alertas"><FaixaAlertas Alertas="alertas" /></div>

        @if (podeVerFinanceiro && metricas is not null)
        {
            <StatCardGrid MinColuna="200" data-tour="inicio-kpis">
                <MetricCard Rotulo="Receita do período" Valor="@FBRL(metricas.TotalReceitasMes)" Tom="ok" Href="/financeiro" />
                <MetricCard Rotulo="Despesa do período" Valor="@FBRL(metricas.TotalDespesasMes)" Tom="alerta" Href="/financeiro" />
                <MetricCard Rotulo="Lucro líquido" Valor="@FBRL(metricas.LucroLiquidoMes)" Tom="@(metricas.LucroLiquidoMes >= 0 ? "ok" : "erro")" Href="/financeiro" />
                <MetricCard Rotulo="Capital em estoque" Valor="@FBRL(metricas.CapitalEstoqueVeiculos + metricas.CapitalEstoqueComponentes)" Href="/financeiro" />
            </StatCardGrid>
        }

        @if (podeVerFinanceiro && serieFaturamento.Count >= 1)
        {
            <Secao Titulo="@($"Receitas e despesas — {inicio:dd/MM} a {fim:dd/MM}")" data-tour="inicio-faturamento">
                <div class="grafico-inicio-grid">
                    @if (temOficina)
                    {
                        <div class="grafico-inicio-item">
                            <h3>Oficina</h3>
                            <div class="grafico-inicio"><canvas id="inicioFaturamentoOficina"></canvas></div>
                        </div>
                    }
                    @if (temConcessionaria)
                    {
                        <div class="grafico-inicio-item">
                            <h3>Concessionária</h3>
                            <div class="grafico-inicio"><canvas id="inicioFaturamentoConcessionaria"></canvas></div>
                        </div>
                    }
                </div>
            </Secao>
        }

        <div class="areas" data-tour="inicio-areas">
            @if (temConcessionaria)
            {
                <div class="area-card">
                    <div class="area-head"><h2>Concessionária</h2><a href="/concessionaria">Abrir →</a></div>
                    <div class="area-kpis">
                        <div><strong>@veiculosDisponiveis</strong><span>disponíveis</span></div>
                        <div><strong>@propostasAbertas</strong><span>propostas abertas</span></div>
                        <div><strong>@consignacoesVencendo</strong><span>consig. vencendo</span></div>
                    </div>
                </div>
            }
            @if (temOficina)
            {
                <div class="area-card">
                    <div class="area-head"><h2>Oficina</h2><a href="/oficina">Abrir →</a></div>
                    <div class="area-kpis">
                        <div><strong>@osAbertas</strong><span>OS abertas</span></div>
                        <div><strong>@osCobranca</strong><span>aguard. cobrança</span></div>
                        <div><strong>@pecasBaixas</strong><span>peças no mínimo</span></div>
                    </div>
                </div>
            }
            @if (podeVerFinanceiro)
            {
                <div class="area-card">
                    <div class="area-head"><h2>Financeiro</h2><a href="/financeiro">Abrir →</a></div>
                    <div class="area-kpis">
                        <div><strong>@(metricas is not null ? FBRL(metricas.LucroLiquidoMes) : "—")</strong><span>lucro do período</span></div>
                        <div><strong>@osCobranca</strong><span>OS a receber</span></div>
                    </div>
                </div>
            }
            @if (podeVerAnalises)
            {
                <div class="area-card">
                    <div class="area-head"><h2>Análises</h2><a href="/dashboard">Abrir →</a></div>
                    <p class="muted">
                        @if (temOficina && temConcessionaria)
                        {
                            <text>Gráficos e comparativos de oficina e concessionária.</text>
                        }
                        else if (temOficina)
                        {
                            <text>Gráficos e comparativos da oficina.</text>
                        }
                        else
                        {
                            <text>Gráficos e comparativos da concessionária.</text>
                        }
                    </p>
                </div>
            }
        </div>

        
        @if (!temConcessionaria && !temOficina && !podeVerFinanceiro)
        {
            <EstadoVazio Mensagem="Use o menu acima para navegar." Icone="👋" />
        }
        </div>
    </div>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo Cultura = new("pt-BR");
    private static string FBRL(decimal v) => v.ToString("C", Cultura);

    private string saudacao = "Bem-vindo";
    private bool carregando = true;
    private bool temConcessionaria, temOficina, podeVerFinanceiro, podeVerAnalises, ehAdmin;

    // metricas = recortado pelo período do SeletorPeriodo — alimenta tanto os
    // KPIs quanto os gráficos de faturamento (oficina e concessionária em
    // gráficos separados, lado a lado — nunca somados numa linha só, ver
    // docs/redesign/27-graficos-receita-por-setor.md).
    private DashboardMetricasDTO? metricas;
    private DateOnly inicio, fim;
    private List<(string Label, decimal ReceitaOficina, decimal DespesaOficina, decimal ReceitaConcessionaria, decimal DespesaConcessionaria)> serieFaturamento = new();
    private bool graficoPendente;
    private List<FaixaAlertas.Alerta> alertas = new();
    private int veiculosDisponiveis, propostasAbertas, consignacoesVencendo;
    private int osAbertas, osCobranca, pecasBaixas;

    private IEnumerable<MenuAtalhos.Item> atalhos
    {
        get
        {
            if (temConcessionaria)
                yield return new("Concessionária", "🚗", "/concessionaria", "Salão, propostas, test drives, consignações.");
            if (temOficina)
                yield return new("Oficina", "🔧", "/oficina", "Ordens de serviço, recepção, estoque.");
            yield return new("Clientes", "👤", "/clientes", "Buscar e abrir a ficha de um cliente.");
            if (podeVerFinanceiro)
            {
                yield return new("Financeiro", "💰", "/financeiro", "Receita, despesas, lucro.");
                yield return new("Análises", "📊", "/dashboard", "Gráficos e comparativos.");
            }
            if (ehAdmin)
            {
                yield return new("Equipe", "🧑‍🔧", "/equipe", "Funcionários do sistema.");
                yield return new("Configurações", "⚙️", "/configuracoes", "Parâmetros do sistema.");
            }
            yield return new("Consulta do cliente", "🔎", "/consulta", "Página pública de acompanhamento de OS.");
        }
    }

    private static readonly string[] StatusOsAbertas =
        { "Pendente", "EmVistoria", "AguardandoCliente", "BuscandoPecasParaOrcamento", "Aprovada", "EmAndamento", "Pausada" };
    private static readonly string[] PropTerminal = { "Concluida", "Rejeitada", "Cancelada", "Expirada" };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;

        if (!(user.Identity?.IsAuthenticated ?? false))
        {
            Nav.NavigateTo("/login");
            return;
        }

        var nome = user.FindFirst("name")?.Value
                   ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                   ?? "";
        var h = DateTime.Now.Hour;
        var parte = h < 12 ? "Bom dia" : h < 18 ? "Boa tarde" : "Boa noite";
        saudacao = string.IsNullOrWhiteSpace(nome) ? parte : $"{parte}, {nome.Split(' ')[0]}";

        var rModulos = await ConfiguracaoService.ObterModulosAtivosAsync();
        var moduloConcessionaria = !rModulos.IsSuccess || rModulos.Value.Concessionaria;
        var moduloOficina = !rModulos.IsSuccess || rModulos.Value.Oficina;

        temConcessionaria = moduloConcessionaria && (user.IsInRole("Admin") || user.IsInRole("GerenteVendas") || user.IsInRole("Vendedor"));
        temOficina = moduloOficina && (user.IsInRole("Admin") || user.IsInRole("ChefeOficina") || user.IsInRole("Mecanico") || user.IsInRole("Recepcionista"));
        podeVerFinanceiro = user.IsInRole("Admin") || user.IsInRole("GerenteVendas") || user.IsInRole("ChefeOficina");
        podeVerAnalises = podeVerFinanceiro;
        ehAdmin = user.IsInRole("Admin");

        var hoje = DateOnly.FromDateTime(DateTime.Today);
        inicio = hoje.AddDays(-14);
        fim = hoje;

        try
        {
            var tOrdens = temOficina ? OrdemService.GetAllAsync() : NullList<CarStoreManager.Application.DTOs.Oficina.OrdemServico.OrdemServicoListaDTO>();
            var tVeic = temConcessionaria ? VeiculoService.GetAllAsync() : NullList<CarStoreManager.Application.DTOs.Concessionaria.VeiculoVenda.VeiculoVendaListaDTO>();
            var tConsig = temConcessionaria ? ConsignacaoService.GetAllAsync() : NullList<CarStoreManager.Application.DTOs.Concessionaria.VeiculoConsignacao.VeiculoConsignacaoListaDTO>();
            var tProp = temConcessionaria ? PropostaService.GetAllAsync() : NullList<CarStoreManager.Application.DTOs.Concessionaria.PropostaVenda.PropostaVendaListaDTO>();
            var tEstoque = temOficina ? EstoqueService.ListarComEstoqueBaixoAsync() : NullList<CarStoreManager.Application.DTOs.Oficina.Componente.EstoqueComponenteDTO>();
            var tMetr = podeVerFinanceiro
                ? DashboardService.ObterMetricasPeriodoAsync(inicio.ToDateTime(TimeOnly.MinValue), fim.ToDateTime(TimeOnly.MaxValue))
                : Task.FromResult<CarStoreManager.Application.Common.Result<DashboardMetricasDTO>>(null!);

            await Task.WhenAll(tOrdens, tVeic, tConsig, tProp, tEstoque, tMetr);

            var ordens = tOrdens.Result?.Value?.ToList() ?? new();
            var veic = tVeic.Result?.Value?.ToList() ?? new();
            var consig = tConsig.Result?.Value?.ToList() ?? new();
            var props = tProp.Result?.Value?.ToList() ?? new();
            var pecas = tEstoque.Result?.Value?.ToList() ?? new();
            if (podeVerFinanceiro && tMetr.Result is { IsSuccess: true, Value: not null })
            {
                metricas = tMetr.Result.Value;
                AtualizarSerieFaturamento(metricas);
            }

            osAbertas = ordens.Count(o => StatusOsAbertas.Contains(o.Status));
            osCobranca = ordens.Count(o => o.Status == "PagamentoPendente");
            pecasBaixas = pecas.Count;
            veiculosDisponiveis = veic.Count(v => v.Disponibilidade == "Disponivel");
            propostasAbertas = props.Count(p => !PropTerminal.Contains(p.Status));
            consignacoesVencendo = consig.Count(c => c.Status == "Ativa" && (c.EstaVencido || c.DiasRestantes <= 7));

            if (osCobranca > 0) alertas.Add(new($"{osCobranca} OS aguardando cobrança", "/oficina/recepcao", "atencao", "💰"));
            if (consignacoesVencendo > 0) alertas.Add(new($"{consignacoesVencendo} consignação(ões) vencendo", "/concessionaria/consignacoes", "atencao", "⏳"));
            if (pecasBaixas > 0) alertas.Add(new($"{pecasBaixas} peça(s) abaixo do mínimo", "/oficina/componentes", "alerta", "📦"));

            if (podeVerFinanceiro)
            {
                var dias = await BalancoService.DiasParaFechamentoAsync();
                if (dias is { } d)
                {
                    var txt = d == 0 ? "Hoje é a data de fechamento de despesas"
                        : d == 1 ? "1 dia para a data de fechamento de despesas"
                        : $"{d} dias para a data de fechamento de despesas";
                    alertas.Add(new(txt, "/financeiro/despesas", "atencao", "🧾"));
                }
            }
        }
        catch { }

        carregando = false;
    }

    private static Task<CarStoreManager.Application.Common.Result<IEnumerable<T>>> NullList<T>()
        => Task.FromResult(CarStoreManager.Application.Common.Result<IEnumerable<T>>.Ok(Enumerable.Empty<T>()));

    /// <summary>Recalcula os KPIs financeiros e o gráfico de faturamento pro
    /// novo período — os demais dados da tela (OS, veículos, alertas) são
    /// estado atual, não mudam com o período escolhido.</summary>
    private async Task RecarregarPeriodoAsync()
    {
        if (!podeVerFinanceiro) return;
        var r = await DashboardService.ObterMetricasPeriodoAsync(inicio.ToDateTime(TimeOnly.MinValue), fim.ToDateTime(TimeOnly.MaxValue));
        if (r.IsSuccess && r.Value is not null)
        {
            metricas = r.Value;
            AtualizarSerieFaturamento(metricas);
        }
        graficoPendente = true;
        StateHasChanged();
    }

    /// <summary>Receita de serviços (oficina) e de vendas (concessionária),
    /// cada uma com sua própria despesa — nunca somadas num número só
    /// (dinheiro de setores diferentes confunde o usuário). Despesa "Geral"
    /// (sem setor específico, ex. despesas administrativas) não tem série
    /// própria — divide-se meio a meio entre os dois setores.</summary>
    private void AtualizarSerieFaturamento(DashboardMetricasDTO dto)
    {
        var servicos = dto.SerieReceitaServicos ?? new();
        var vendas = dto.SerieReceitaVendas ?? new();
        var despesaTotal = dto.SerieDespesas ?? new();
        var despesaOficina = dto.SerieDespesasOficina ?? new();
        var despesaConcessionaria = dto.SerieDespesasConcessionaria ?? new();
        var meses = servicos.Select(s => s.Label)
            .Union(vendas.Select(v => v.Label))
            .Union(despesaTotal.Select(d => d.Label))
            .ToList();
        serieFaturamento = meses.Select(m =>
        {
            var total = despesaTotal.FirstOrDefault(d => d.Label == m)?.Valor ?? 0m;
            var ofi = despesaOficina.FirstOrDefault(d => d.Label == m)?.Valor ?? 0m;
            var conc = despesaConcessionaria.FirstOrDefault(d => d.Label == m)?.Valor ?? 0m;
            var geralMetade = (total - ofi - conc) / 2m;
            return (
                Label: m,
                ReceitaOficina: servicos.FirstOrDefault(s => s.Label == m)?.Valor ?? 0m,
                DespesaOficina: ofi + geralMetade,
                ReceitaConcessionaria: vendas.FirstOrDefault(v => v.Label == m)?.Valor ?? 0m,
                DespesaConcessionaria: conc + geralMetade
            );
        }).ToList();
        graficoPendente = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (carregando || !graficoPendente || serieFaturamento.Count < 1) return;
        graficoPendente = false;
        try
        {
            var labels = serieFaturamento.Select(p => p.Label).ToArray();
            await JS.InvokeVoidAsync("carstoreChart.linhaTempo", "inicioFaturamentoOficina", labels,
                new[]
                {
                    new { nome = "Receita", dados = serieFaturamento.Select(p => p.ReceitaOficina).ToArray(), cor = "#16a34a" },
                    new { nome = "Despesa", dados = serieFaturamento.Select(p => p.DespesaOficina).ToArray(), cor = "#ea580c" },
                },
                "R$");
            await JS.InvokeVoidAsync("carstoreChart.linhaTempo", "inicioFaturamentoConcessionaria", labels,
                new[]
                {
                    new { nome = "Receita", dados = serieFaturamento.Select(p => p.ReceitaConcessionaria).ToArray(), cor = "#2563eb" },
                    new { nome = "Despesa", dados = serieFaturamento.Select(p => p.DespesaConcessionaria).ToArray(), cor = "#ea580c" },
                },
                "R$");
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("carstoreChart.destroy", "inicioFaturamentoOficina");
            await JS.InvokeVoidAsync("carstoreChart.destroy", "inicioFaturamentoConcessionaria");
        }
        catch { }
    }
}

<style>
    /* Mesmo padrão de sidebar de atalhos usado nos hubs de Oficina e
       Concessionária — ver docs/redesign/12-padronizacao-paineis.md. */
    .hub-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: var(--sp-5); align-items: start; }
    .hub-conteudo { min-width: 0; }
    @@media (max-width: 1000px) { .hub-layout { grid-template-columns: 1fr; } }

    .areas { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--sp-4); margin-bottom: var(--sp-6); }
    .atalhos { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--sp-3); }
    .grafico-inicio-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-5); }
    .grafico-inicio-item h3 { font-size: var(--txt-sm); font-weight: var(--peso-medio); color: var(--cor-tinta-2); margin: 0 0 var(--sp-2); }
    .grafico-inicio { position: relative; height: 240px; }
    .grafico-inicio canvas { max-height: 240px; }
    @@media (max-width: 900px) { .grafico-inicio-grid { grid-template-columns: 1fr; } }
    .area-card { background: var(--cor-superficie); border: 1px solid var(--cor-linha); border-radius: var(--raio-lg); padding: var(--sp-5); }
    .area-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--sp-4); }
    .area-head h2 { font-size: var(--txt-lg); margin: 0; }
    .area-head a { font-size: var(--txt-sm); color: var(--cor-acao); text-decoration: none; }
    .area-kpis { display: flex; gap: var(--sp-5); }
    .area-kpis > div { display: flex; flex-direction: column; }
    .area-kpis strong { font-size: var(--txt-xl); font-weight: var(--peso-medio); }
    .area-kpis span { font-size: var(--txt-xs); color: var(--cor-tinta-3); }
</style>
