@page "/admin/usuarios"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@namespace CarStoreManager.Web.Components.Pages

@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthState
@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.DTOs.Auth
@using CarStoreManager.Domain.Enums
@using CarStoreManager.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization

@using Microsoft.AspNetCore.Components.Web

<div class="usuarios-page">
    <div class="page-header">
        <div>
            <h1 class="page-titulo">Usuários</h1>
            <p class="page-sub">Gerenciamento de funcionários do sistema</p>
        </div>
        <button class="btn-novo" data-tour="usuarios-btn-novo" @onclick="AbrirModalNovoUsuario">+ Novo usuário</button>
    </div>

    <div class="toolbar">
        <input class="campo-input busca-input" data-tour="usuarios-busca" placeholder="Buscar por nome ou telefone..."
               @bind="termoBusca" @bind:event="oninput" @bind:after="AplicarFiltro" />
        <select class="campo-input filtro-select" data-tour="usuarios-filtro-tipo" @bind="filtroTipo" @bind:after="AplicarFiltro">
            <option value="Todos">Todos os tipos</option>
            <option value="Vendedor">Vendedor</option>
            <option value="Mecanico">Mecânico</option>
            <option value="Recepcionista">Recepcionista</option>
            <option value="ChefeOficina">Chefe de oficina</option>
            <option value="GerenteVendas">Gerente de vendas</option>
            <option value="Admin">Administrador</option>
        </select>
    </div>

    @if (carregando)
    {
        <div class="loading">Carregando...</div>
    }
    else
    {
        <div class="usuarios-lista">
            @foreach (var u in usuariosFiltrados)
            {
                <div class="usuario-card" data-tour="usuarios-card-exemplo">
                    <div class="usuario-avatar @RoleSlug(u.Role)">@u.Nome[0].ToString().ToUpper()</div>
                    <div class="usuario-info">
                        <span class="usuario-nome">@u.Nome</span>
                        <span class="usuario-detalhe">@u.Telefone · @u.Email</span>
                    </div>
                    <span class="usuario-role @(RoleSlug(u.Role))-badge">@RoleLabel(u.Role)</span>
                    @if (u.Id != usuarioAtualId)
                    {
                        <button class="btn-desativar" data-tour="usuarios-btn-desativar"
                                @onclick="() => ConfirmarDesativar(u.Id, u.Nome)">
                            Desativar
                        </button>
                    }
                    else
                    {
                        <span class="self-tag">você</span>
                    }
                </div>
            }
            @if (!usuariosFiltrados.Any())
            {
                <div class="vazio-aba">Nenhum usuário encontrado.</div>
            }
        </div>
    }
</div>

@if (modalNovoUsuarioVisivel)
{
    <div class="modal-overlay" @onclick="() => modalNovoUsuarioVisivel = false">
        <div class="modal-form" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-titulo">Novo usuário</span>
                <button class="modal-fechar"
                        @onclick="() => modalNovoUsuarioVisivel = false">×</button>
            </div>

            <div class="form-grid">
                <div class="form-campo span-2">
                    <label class="campo-label">Tipo *</label>
                    <select class="campo-input" @bind="novoUsuario.Role">
                        <option value="" disabled>Selecione o tipo...</option>
                        <option value="Vendedor">Vendedor</option>
                        <option value="Mecanico">Mecânico</option>
                        <option value="Recepcionista">Recepcionista</option>
                        <option value="ChefeOficina">Chefe de oficina</option>
                        <option value="GerenteVendas">Gerente de vendas</option>
                        <option value="Admin">Administrador</option>
                    </select>
                </div>
                <div class="form-campo span-2">
                    <label class="campo-label">Nome completo *</label>
                    <input class="campo-input" @bind="novoUsuario.Nome" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">E-mail *</label>
                    <input type="email" class="campo-input" @bind="novoUsuario.Email" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Telefone *</label>
                    <input class="campo-input" @bind="novoUsuario.Telefone"
                           placeholder="(11) 90000-0000" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Senha inicial *</label>
                    <input type="password" class="campo-input" @bind="novoUsuario.Senha" />
                </div>

                @if (novoUsuario.Role != "Admin" && novoUsuario.Role != "")
                {
                    <div class="form-campo">
                        <label class="campo-label">Data de contratação *</label>
                        <input type="date" class="campo-input" @bind="novoUsuario.DataContratacao" />
                    </div>
                }

                @if (novoUsuario.Role == "Mecanico")
                {
                    <div class="form-campo span-2">
                        <label class="campo-label">Especialidade *</label>
                        <select class="campo-input" @bind="novoUsuario.Especialidade">
                            @foreach (var esp in Enum.GetValues<EspecialidadeMecanico>())
                            {
                                <option value="@esp">@LabelEspecialidade(esp)</option>
                            }
                        </select>
                    </div>
                }
            </div>

            @if (erroNovo is not null)
            {
                <div class="erro-banner">@erroNovo</div>
            }

            <div class="modal-acoes">
                <button class="btn-cancelar"
                        @onclick="() => modalNovoUsuarioVisivel = false">
                    Cancelar
                </button>
                <button class="btn-confirmar"
                        @onclick="CriarUsuario"
                        disabled="@salvando">
                    @(salvando ? "Criando..." : "Criar usuário")
                </button>
            </div>
        </div>
    </div>
}

<ConfirmacaoSenhaModal
    Visivel="modalDesativarVisivel"
    Titulo="Desativar usuário"
    Descricao="@($"Desativar {nomeParaDesativar}? O usuário perderá acesso ao sistema.")"
    TextoBotao="Desativar"
    Destrutivo="true"
    ApenasAdmin="true"
    OnConfirmar="ConfirmarDesativacao"
    OnCancelar="() => modalDesativarVisivel = false"
    @ref="modalDesativarRef" />

@code {
    private List<UsuarioDTO> todosUsuarios = new();
    private List<UsuarioDTO> usuariosFiltrados = new();
    private string termoBusca = string.Empty;
    private string filtroTipo = "Todos";
    private bool carregando = true;
    private bool modalNovoUsuarioVisivel = false;
    private bool modalDesativarVisivel = false;
    private bool salvando = false;
    private string? erroNovo;
    private string nomeParaDesativar = string.Empty;
    private Guid idParaDesativar;
    private Guid usuarioAtualId;
    private ConfirmacaoSenhaModal? modalDesativarRef;

    private CriarUsuarioDTO novoUsuario = NovoFormPadrao();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (claim is not null)
            usuarioAtualId = Guid.Parse(claim.Value);

        await CarregarUsuarios();
    }

    private async Task CarregarUsuarios()
    {
        carregando = true;

        var r = await AuthService.ListarUsuariosAsync();
        todosUsuarios = r.IsSuccess ? r.Value?.ToList() ?? new() : new();

        AplicarFiltro();
        carregando = false;
    }

    private void AplicarFiltro()
    {
        var baseLista = filtroTipo == "Todos"
            ? todosUsuarios.AsEnumerable()
            : todosUsuarios.Where(u => u.Role == filtroTipo);

        if (!string.IsNullOrWhiteSpace(termoBusca))
        {
            var termo = termoBusca.Trim();
            baseLista = baseLista.Where(u =>
                u.Nome.Contains(termo, StringComparison.OrdinalIgnoreCase)
                || u.Telefone.Contains(termo, StringComparison.OrdinalIgnoreCase));
        }

        usuariosFiltrados = baseLista
            .OrderBy(u => u.Nome, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void AbrirModalNovoUsuario()
    {
        novoUsuario = NovoFormPadrao();
        erroNovo = null;
        modalNovoUsuarioVisivel = true;
    }

    private async Task CriarUsuario()
    {
        if (string.IsNullOrWhiteSpace(novoUsuario.Role))
        {
            erroNovo = "Selecione o tipo de usuário.";
            return;
        }

        salvando = true;
        erroNovo = null;

        try
        {
            // Limpa campos não usados conforme o tipo escolhido
            if (novoUsuario.Role == "Admin")
            {
                novoUsuario.Nivel = null;
                novoUsuario.Especialidade = null;
                novoUsuario.DataContratacao = null;
            }
            else if (novoUsuario.Role != "Mecanico")
            {
                novoUsuario.Especialidade = null;
            }

            var resultado = await AuthService.CriarUsuarioAsync(novoUsuario);
            if (resultado.IsSuccess)
            {
                modalNovoUsuarioVisivel = false;
                await CarregarUsuarios();
            }
            else
            {
                erroNovo = resultado.Error;
            }
        }
        catch (Exception ex)
        {
            erroNovo = $"Erro ao criar usuário: {ex.Message}";
        }
        finally { salvando = false; }
    }

    private void ConfirmarDesativar(Guid id, string nome)
    {
        idParaDesativar = id;
        nomeParaDesativar = nome;
        modalDesativarVisivel = true;
    }

    private async Task ConfirmarDesativacao(string senha)
    {
        var resultado = await AuthService.VerificarSenhaAsync(usuarioAtualId, senha);
        if (!resultado.IsSuccess) { modalDesativarRef?.MostrarErro(); return; }

        var desativar = await AuthService.DesativarUsuarioAsync(idParaDesativar);
        if (desativar.IsSuccess)
        {
            modalDesativarVisivel = false;
            await CarregarUsuarios();
        }
        else
        {
            modalDesativarRef?.MostrarErro();
        }
    }

    private static string RoleLabel(string role) => role switch
    {
        "Vendedor" => "Vendedor",
        "Mecanico" => "Mecânico",
        "Recepcionista" => "Recepcionista",
        "ChefeOficina" => "Chefe de oficina",
        "GerenteVendas" => "Gerente de vendas",
        "Admin" => "Administrador",
        _ => role
    };

    private static string RoleSlug(string role) => role switch
    {
        "Vendedor" => "vendedor",
        "Mecanico" => "mecanico",
        "Recepcionista" => "recepcionista",
        "ChefeOficina" => "chefe-oficina",
        "GerenteVendas" => "gerente-vendas",
        "Admin" => "admin",
        _ => "vendedor"
    };

    private static CriarUsuarioDTO NovoFormPadrao() => new()
    {
        Role = "",
        Nivel = "Pleno",
        Especialidade = nameof(EspecialidadeMecanico.Motor),
        DataContratacao = DateTime.Today
    };

    private static string LabelEspecialidade(EspecialidadeMecanico esp) => esp switch
    {
        EspecialidadeMecanico.Mecanica       => "Mecânica geral",
        EspecialidadeMecanico.Funilaria      => "Funilaria",
        EspecialidadeMecanico.Eletrica       => "Elétrica",
        EspecialidadeMecanico.Pintura        => "Pintura",
        EspecialidadeMecanico.Interior       => "Interior",
        EspecialidadeMecanico.Motor          => "Motor",
        EspecialidadeMecanico.Suspensao      => "Suspensão",
        EspecialidadeMecanico.Freios         => "Freios",
        EspecialidadeMecanico.Transmissao    => "Transmissão",
        EspecialidadeMecanico.ArCondicionado => "Ar-condicionado",
        _ => esp.ToString()
    };
}

<style>
    .usuarios-page {
        max-width: 980px;
        margin: 0 auto;
        padding: 32px 24px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .page-titulo { font-size: 24px; font-weight: 500; margin-bottom: 4px; }
    .page-sub { font-size: 14px; color: #888; }

    .btn-novo {
        background: #e02020;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
    }

    .btn-novo:hover { background: #c01818; }

    .toolbar {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .busca-input { flex: 1; }
    .filtro-select { max-width: 220px; }

    .usuarios-lista {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .vazio-aba {
        text-align: center;
        padding: 40px;
        color: #888;
        font-size: 14px;
    }

    .usuario-card {
        background: #fff;
        border: 0.5px solid #e0e0e0;
        border-radius: 10px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .usuario-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 500;
        flex-shrink: 0;
    }

    .usuario-avatar.vendedor       { background: #fff0f0; color: #e02020; }
    .usuario-avatar.mecanico       { background: #f0f4ff; color: #3b5bdb; }
    .usuario-avatar.recepcionista  { background: #fff7ed; color: #ea580c; }
    .usuario-avatar.chefe-oficina  { background: #ede9fe; color: #6d28d9; }
    .usuario-avatar.gerente-vendas { background: #fef3c7; color: #92400e; }
    .usuario-avatar.admin          { background: #f0fdf4; color: #16a34a; }

    .usuario-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        flex: 1;
    }

    .usuario-nome { font-size: 14px; font-weight: 500; }
    .usuario-detalhe { font-size: 12px; color: #888; }

    .usuario-role {
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 500;
    }

    .vendedor-badge       { background: #fff0f0; color: #c01818; }
    .mecanico-badge       { background: #f0f4ff; color: #3b5bdb; }
    .recepcionista-badge  { background: #fff7ed; color: #ea580c; }
    .chefe-oficina-badge  { background: #ede9fe; color: #6d28d9; }
    .gerente-vendas-badge { background: #fef3c7; color: #92400e; }
    .admin-badge          { background: #f0fdf4; color: #16a34a; }

    .self-tag {
        font-size: 11px;
        color: #888;
        font-style: italic;
        padding: 5px 12px;
    }

    .btn-desativar {
        background: none;
        border: 0.5px solid #e0e0e0;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 12px;
        color: #888;
        cursor: pointer;
    }

    .btn-desativar:hover { border-color: #e02020; color: #e02020; }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-form {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        width: 100%;
        max-width: 580px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .modal-titulo { font-size: 16px; font-weight: 500; }

    .modal-fechar {
        background: none;
        border: none;
        font-size: 20px;
        color: #888;
        cursor: pointer;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
    }

    .form-campo { display: flex; flex-direction: column; gap: 6px; }
    .span-2 { grid-column: span 2; }

    .campo-label { font-size: 12px; color: #555; font-weight: 500; }

    .campo-input {
        border: 0.5px solid #ccc;
        border-radius: 8px;
        padding: 9px 12px;
        font-size: 14px;
        outline: none;
        width: 100%;
    }

    .campo-input:focus { border-color: #e02020; }

    .erro-banner {
        background: #fff5f5;
        border: 0.5px solid #fca5a5;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        color: #e02020;
        margin-bottom: 12px;
    }

    .modal-acoes {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 16px;
    }

    .btn-cancelar {
        background: #fff;
        border: 0.5px solid #ccc;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 13px;
        cursor: pointer;
    }

    .btn-confirmar {
        background: #1a1a1a;
        border: none;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 13px;
        font-weight: 500;
        color: #fff;
        cursor: pointer;
    }

    .btn-confirmar:disabled { opacity: 0.5; cursor: not-allowed; }
    .loading { text-align: center; padding: 60px; color: #888; font-size: 14px; }

    @@media (max-width: 640px) {
        .usuario-card { flex-wrap: wrap; }
        .usuario-info { min-width: 55%; }
        .btn-desativar { flex-basis: 100%; text-align: center; }
    }
</style>
