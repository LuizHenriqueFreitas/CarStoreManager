@page "/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "pagina:/dashboard")]

@namespace CarStoreManager.Web.Components.Pages

@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@inject IVeiculoVendaService VeiculoService
@inject IVeiculoConsignacaoService ConsignacaoService
@inject IOrdemServicoService OrdemService
@inject IClienteService ClienteService
@inject IPropostaVendaService PropostaService
@inject IMecanicoService MecanicoService
@inject IVendedorService VendedorService
@inject IEstoqueService EstoqueService
@inject IDashboardService DashboardService
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject CarStoreManager.Application.Interfaces.Sistema.IConfiguracaoSistemaService ConfiguracaoService
@implements IAsyncDisposable
@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.DTOs.Admin
@using CarStoreManager.Application.DTOs.Oficina.OrdemServico
@using CarStoreManager.Application.DTOs.Oficina.Componente
@using CarStoreManager.Application.DTOs.Concessionaria.VeiculoConsignacao
@using CarStoreManager.Web.Components.Shared
@using System.Globalization
@using System.Text.Json
@using Microsoft.JSInterop

<div class="dash-page">
    <div class="dash-header">
        <div>
            <h1 class="dash-titulo">Análises</h1>
            <p class="dash-sub">Indicadores e gráficos comparativos · @DateTime.Now.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="dash-header-acoes">
            <div data-tour="dashboard-periodo">
                <SeletorPeriodo @bind-Inicio="inicio" @bind-Fim="fim" OnAlterado="OnPeriodoAlterado" />
            </div>
            <button type="button" class="btn-relatorio" data-tour="dashboard-relatorio" @onclick='() => Nav.NavigateTo("/dashboard/relatorios")'>
                📄 Relatório
            </button>
            <a class="btn-usuarios" href="/financeiro">Financeiro →</a>
        </div>
    </div>

    <SubNav Itens="SubNavAnalises.Itens" />

    <div class="dash-abas" data-tour="dashboard-abas">
        @if (PodeVerOficina && PodeVerConcessionaria)
        {
            <button type="button" class="@AbaClass("geral")" @onclick='() => SetAba("geral")'>Geral</button>
        }
        @if (PodeVerOficina)
        {
            <button type="button" class="@AbaClass("oficina")" @onclick='() => SetAba("oficina")'>Oficina</button>
        }
        @if (PodeVerConcessionaria)
        {
            <button type="button" class="@AbaClass("concessionaria")" @onclick='() => SetAba("concessionaria")'>Concessionária</button>
        }
    </div>

    <div class="hub-layout">
    <MenuAtalhos Itens="atalhos" data-tour="dash-hub-atalhos" />
    <div class="hub-conteudo">

    @* ===================== ABA GERAL ===================== *@
    @if (abaAtiva == "geral")
    {
        <div class="aviso-financeiro">
            Os números financeiros (receita, despesa, lucro, capital, contas a receber) agora ficam no
            <a href="/financeiro"><strong>Financeiro</strong></a>. Esta tela concentra os gráficos e comparativos.
        </div>
        @if (metricas is not null)
        {
            <div class="grafico-row">
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Oficina — @PeriodoLabel</h3>
                    <div class="grafico-area"><canvas id="chartFaturamentoOficina6m"></canvas></div>
                </div>
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Concessionária — @PeriodoLabel</h3>
                    <div class="grafico-area"><canvas id="chartFaturamentoConcessionaria6m"></canvas></div>
                </div>
            </div>

            <div class="grafico-row">
                <div class="grafico-card grafico-largo" data-tour="dashboard-analises">
                    <div class="analise-header">
                        <h3 class="grafico-titulo">Comparativos</h3>
                        <select class="analise-select" value="@graficoSelecionadoId" @onchange="OnGraficoSelecionado">
                            @foreach (var grupo in metricas.Graficos.GroupBy(g => g.Categoria))
                            {
                                <optgroup label="@grupo.Key">
                                    @foreach (var g in grupo)
                                    {
                                        <option value="@g.Id">@g.Titulo</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="grafico-area"><canvas id="chartAnaliseSelecionada"></canvas></div>
                </div>
            </div>

            <div class="grafico-row">
                <div class="grafico-card grafico-largo">
                    <h3 class="grafico-titulo">Receita Oficina vs Concessionária — @PeriodoLabel</h3>
                    <div class="grafico-area"><canvas id="chartComparacaoReceita"></canvas></div>
                </div>
            </div>
        }
    }

    @* ===================== ABA OFICINA ===================== *@
    @if (abaAtiva == "oficina")
    {
        <h2 class="grupo-titulo">Oficina — operação</h2>
        <div class="metricas-grid" data-tour="dashboard-oficina-metricas">
            <div class="metrica-card">
                <span class="metrica-label">OS pendentes</span>
                <span class="metrica-valor warn">@osPendentes</span>
            </div>
            <div class="metrica-card">
                <span class="metrica-label">OS em andamento</span>
                <span class="metrica-valor info">@osEmAndamento</span>
            </div>
            <div class="metrica-card">
                <span class="metrica-label">OS finalizadas em @FormatoData.MesAno(DateTime.Today)</span>
                <span class="metrica-valor sucesso">@osFinalizadasMes</span>
            </div>
            <div class="metrica-card destaque">
                <span class="metrica-label">Peças com estoque baixo</span>
                <span class="metrica-valor alerta">@pecasEstoqueBaixo</span>
            </div>
        </div>

        @if (metricas is not null)
        {
            <h2 class="grupo-titulo">Oficina — financeiro (@PeriodoLabel)</h2>
            <div class="metricas-grid">
                <div class="metrica-card">
                    <span class="metrica-label">Receita de serviços</span>
                    <span class="metrica-valor sucesso">@FormatBRL(metricas.ReceitaServicosMesAtual)</span>
                </div>
                <div class="metrica-card">
                    <span class="metrica-label">Despesas da oficina</span>
                    <span class="metrica-valor alerta">@FormatBRL(metricas.TotalDespesasOficinaMensal)</span>
                    <span class="metrica-sub muted">Despesas com setor "Oficina"</span>
                </div>
                <div class="metrica-card destaque-lucro">
                    <span class="metrica-label">Lucro operacional da oficina</span>
                    <span class="metrica-valor @(metricas.LucroOficinaMes >= 0 ? "sucesso" : "alerta")">
                        @FormatBRL(metricas.LucroOficinaMes)
                    </span>
                    <span class="metrica-sub muted">Serviços − Despesas da oficina</span>
                </div>
            </div>

            <div class="capital-imobilizado-bloco">
                <div class="capital-card">
                    <div class="capital-titulo">🔩 Capital investido em estoque de peças</div>
                    <div class="capital-valor">@FormatBRL(metricas.CapitalEstoqueComponentes)</div>
                    <div class="capital-nota">
                        Custo de aquisição × quantidade atual de todos os componentes cadastrados.
                        <strong>Não entra no fluxo de caixa</strong> — é dinheiro parado em peças até serem usadas numa OS.
                    </div>
                </div>
            </div>

            <div class="grafico-row">
                <div class="grafico-card grafico-largo">
                    <h3 class="grafico-titulo">Oficina — receitas vs gastos com peças (@PeriodoLabel)</h3>
                    <div class="grafico-area"><canvas id="chartOficina6m"></canvas></div>
                </div>
            </div>

            <div class="grafico-row">
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Ordens de serviço por status</h3>
                    <div class="grafico-area"><canvas id="chartOSStatusOf"></canvas></div>
                </div>
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Receita por mecânico (top 5)</h3>
                    <div class="grafico-area"><canvas id="chartReceitaMecanico"></canvas></div>
                </div>
            </div>

            <h2 class="grupo-titulo">Oficina — principais comparativos</h2>
            <div class="grafico-row">
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Mecânicos por especialização</h3>
                    <div class="grafico-area"><canvas id="chartMecanicosEspecializacao"></canvas></div>
                </div>
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Tipos de serviço mais realizados</h3>
                    <div class="grafico-area"><canvas id="chartServicosTipo"></canvas></div>
                </div>
            </div>
            <div class="grafico-row">
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Marcas que mais visitam a oficina</h3>
                    <div class="grafico-area"><canvas id="chartMarcasVisitamOficina"></canvas></div>
                </div>
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Componentes em estoque por sistema</h3>
                    <div class="grafico-area"><canvas id="chartEstoquePorSistema"></canvas></div>
                </div>
            </div>
            <div class="grafico-row">
                <div class="grafico-card grafico-largo">
                    <h3 class="grafico-titulo">Prazo médio estimado por tipo de serviço (dias)</h3>
                    <div class="grafico-area"><canvas id="chartPrazoMedioServico"></canvas></div>
                </div>
            </div>

            <div class="grafico-row">
                <div class="grafico-card grafico-largo" data-tour="dashboard-analises-oficina">
                    <div class="analise-header">
                        <h3 class="grafico-titulo">Mais análises da oficina</h3>
                        <select class="analise-select" value="@graficoSelecionadoOficinaId" @onchange="OnGraficoSelecionadoOficina">
                            @foreach (var g in GraficosOficina)
                            {
                                <option value="@g.Id">@g.Titulo</option>
                            }
                        </select>
                    </div>
                    <div class="grafico-area"><canvas id="chartAnaliseSelecionadaOficina"></canvas></div>
                </div>
            </div>
        }

        <div class="duas-colunas">
            <div class="card">
                <h3 class="card-titulo">Ordens de serviço recentes</h3>
                @if (!osRecentes.Any())
                {
                    <p class="vazio">Nenhuma OS cadastrada ainda.</p>
                }
                else
                {
                    <ul class="lista-recente">
                        @foreach (var os in osRecentes)
                        {
                            <li class="item-recente" @onclick='() => Nav.NavigateTo($"/oficina/os/{os.Id}")'>
                                <span class="numero">@os.NumeroPublico</span>
                                <span class="info">@os.Tipo</span>
                                <span class="@StatusClass(os.Status)">@os.Status</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="card">
                <h3 class="card-titulo">Peças com estoque crítico</h3>
                @if (!estoquesCriticos.Any())
                {
                    <p class="vazio">Nenhuma peça abaixo do mínimo.</p>
                }
                else
                {
                    <ul class="lista-recente">
                        @foreach (var e in estoquesCriticos)
                        {
                            <li class="item-recente">
                                <span class="info">@e.ComponenteNome</span>
                                <span class="qtd-baixo">@e.QuantidadeAtual / @e.QuantidadeMinima</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    @* ===================== ABA CONCESSIONÁRIA ===================== *@
    @if (abaAtiva == "concessionaria")
    {
        <h2 class="grupo-titulo">Concessionária — operação</h2>

        @if (consignacoesVencendoEmBreve.Any())
        {
            <div class="banner-vencimento-consignacao">
                <span class="banner-texto">
                    ⚠ @consignacoesVencendoEmBreve.Count consignação(ões) vencendo em breve:
                    @string.Join(", ", consignacoesVencendoEmBreve.Take(LimiteBannerVencimento).Select(c =>
                        $"{c.Marca} {c.Modelo} ({(c.EstaVencido ? "vencida" : $"{c.DiasRestantes}d")})"))
                    @if (consignacoesVencendoEmBreve.Count > LimiteBannerVencimento)
                    {
                        <text> e mais @(consignacoesVencendoEmBreve.Count - LimiteBannerVencimento)</text>
                    }
                </span>
                <a href='/concessionaria/consignacoes' class="link-ver-consignacoes">Ver mais →</a>
            </div>
        }

        <div class="metricas-grid" data-tour="dashboard-concessionaria-metricas">
            <div class="metrica-card">
                <span class="metrica-label">Veículos disponíveis</span>
                <span class="metrica-valor">@veiculosDisponiveis</span>
            </div>
            <div class="metrica-card">
                <span class="metrica-label">Veículos vendidos</span>
                <span class="metrica-valor sucesso">@veiculosVendidos</span>
            </div>
            <div class="metrica-card">
                <span class="metrica-label">Propostas em aberto</span>
                <span class="metrica-valor warn">@propostasAbertas</span>
            </div>
        </div>

        @if (metricas is not null)
        {
            <h2 class="grupo-titulo">Concessionária — financeiro (@PeriodoLabel)</h2>
            <div class="metricas-grid">
                <div class="metrica-card">
                    <span class="metrica-label">Receita de vendas</span>
                    <span class="metrica-valor sucesso">@FormatBRL(metricas.ReceitaVendasMesAtual)</span>
                </div>
                <div class="metrica-card">
                    <span class="metrica-label">Despesas da concessionária</span>
                    <span class="metrica-valor alerta">@FormatBRL(metricas.TotalDespesasConcessionariaMensal)</span>
                    <span class="metrica-sub muted">Despesas com setor "Concessionária"</span>
                </div>
                <div class="metrica-card destaque-lucro">
                    <span class="metrica-label">Lucro operacional da concessionária</span>
                    <span class="metrica-valor @(metricas.LucroConcessionariaMes >= 0 ? "sucesso" : "alerta")">
                        @FormatBRL(metricas.LucroConcessionariaMes)
                    </span>
                    <span class="metrica-sub muted">Vendas − Despesas da concessionária (excl. capital imobilizado)</span>
                </div>
            </div>

            <div class="capital-imobilizado-bloco">
                <div class="capital-card">
                    <div class="capital-titulo">💎 Capital imobilizado em veículos</div>
                    <div class="capital-valor">@FormatBRL(metricas.CapitalEstoqueVeiculos)</div>
                    <div class="capital-nota">
                        Valor dos veículos disponíveis no pátio. <strong>Não entra no fluxo de caixa</strong> —
                        é dinheiro investido aguardando a venda para virar receita.
                        <br />Custo de aquisição desses veículos: <strong>@FormatBRL(metricas.CapitalAquisicaoVeiculosDisponiveis)</strong>
                        (margem potencial de @FormatBRL(metricas.CapitalEstoqueVeiculos - metricas.CapitalAquisicaoVeiculosDisponiveis) se vendidos pelo preço anunciado).
                    </div>
                </div>
            </div>

            <div class="grafico-row">
                <div class="grafico-card grafico-largo">
                    <h3 class="grafico-titulo">Receita de vendas — @PeriodoLabel</h3>
                    <div class="grafico-area"><canvas id="chartConcessionaria6m"></canvas></div>
                </div>
            </div>

            <div class="grafico-row">
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Veículos por status</h3>
                    <div class="grafico-area"><canvas id="chartVeiculosStatus"></canvas></div>
                </div>
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Marca mais vendida</h3>
                    <div class="grafico-area"><canvas id="chartVendasMarca"></canvas></div>
                </div>
            </div>

            <h2 class="grupo-titulo">Concessionária — principais comparativos</h2>
            <div class="grafico-row">
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Modelo mais vendido</h3>
                    <div class="grafico-area"><canvas id="chartModelosVendidos"></canvas></div>
                </div>
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Cores mais vendidas</h3>
                    <div class="grafico-area"><canvas id="chartCoresVendidas"></canvas></div>
                </div>
            </div>
            <div class="grafico-row">
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Consignação vs. loja própria</h3>
                    <div class="grafico-area"><canvas id="chartConsignacaoLoja"></canvas></div>
                </div>
                <div class="grafico-card">
                    <h3 class="grafico-titulo">Modos de pagamento</h3>
                    <div class="grafico-area"><canvas id="chartModosPagamento"></canvas></div>
                </div>
            </div>

            <div class="grafico-row">
                <div class="grafico-card grafico-largo">
                    <h3 class="grafico-titulo">Propostas aprovadas vs rejeitadas — @PeriodoLabel</h3>
                    <div class="grafico-area"><canvas id="chartPropostasTimeline"></canvas></div>
                </div>
            </div>

            <div class="grafico-row">
                <div class="grafico-card grafico-largo" data-tour="dashboard-analises-concessionaria">
                    <div class="analise-header">
                        <h3 class="grafico-titulo">Mais análises da concessionária</h3>
                        <select class="analise-select" value="@graficoSelecionadoConcessionariaId" @onchange="OnGraficoSelecionadoConcessionaria">
                            @foreach (var g in GraficosConcessionaria)
                            {
                                <option value="@g.Id">@g.Titulo</option>
                            }
                        </select>
                    </div>
                    <div class="grafico-area"><canvas id="chartAnaliseSelecionadaConcessionaria"></canvas></div>
                </div>
            </div>
        }
    }

    </div>
    </div>
</div>

@code {
    private string abaAtiva = "geral";
    private string roleUsuario = string.Empty;

    // ChefeOficina e GerenteVendas veem apenas a aba/relatórios do seu setor.
    // Admin enxerga tudo. Módulo desativado sempre vence, mesmo pro Admin.
    private bool moduloOficinaAtivo = true;
    private bool moduloConcessionariaAtivo = true;
    private bool PodeVerOficina         => roleUsuario is "Admin" or "ChefeOficina" && moduloOficinaAtivo;
    private bool PodeVerConcessionaria  => roleUsuario is "Admin" or "GerenteVendas" && moduloConcessionariaAtivo;
    private bool PodeGerenciarUsuarios  => roleUsuario is "Admin";

    private int veiculosDisponiveis;
    private int veiculosVendidos;
    private decimal valorTotalEstoqueVeiculos;
    private int propostasAbertas;
    private int osPendentes;
    private int osEmAndamento;
    private int osFinalizadasMes;
    private int pecasEstoqueBaixo;
    private int totalClientes;
    private int totalMecanicos;
    private int totalVendedores;

    private List<OrdemServicoListaDTO> osRecentes = new();
    private List<EstoqueComponenteDTO> estoquesCriticos = new();
    private List<VeiculoConsignacaoListaDTO> consignacoesVencendoEmBreve = new();

    // O banner tem altura fixa (2.5cm) — só cabem uns 3 nomes antes de
    // estourar; o resto fica atrás do link "Ver mais".
    private const int LimiteBannerVencimento = 3;
    private DashboardMetricasDTO? metricas;

    // Aba Geral: seletor de qual gráfico comparativo mostrar — dados
    // financeiros básicos por padrão, trocável por qualquer outro gráfico
    // do catálogo modular (ver DashboardService.MontarGraficos).
    private string graficoSelecionadoId = "financeiro-composicao";

    // Abas Oficina/Concessionária: mesmo catálogo modular, mas cada seletor só
    // lista gráficos do próprio setor — oficina não pode ver/escolher gráficos
    // da concessionária e vice-versa.
    private string graficoSelecionadoOficinaId = "modelos-visitam-oficina";
    private string graficoSelecionadoConcessionariaId = "combustivel-vendido";

    private IEnumerable<GraficoAnaliseDTO> GraficosOficina =>
        metricas?.Graficos.Where(g => g.Categoria is "Oficina" or "Estoque") ?? Enumerable.Empty<GraficoAnaliseDTO>();
    private IEnumerable<GraficoAnaliseDTO> GraficosConcessionaria =>
        metricas?.Graficos.Where(g => g.Categoria == "Concessionária") ?? Enumerable.Empty<GraficoAnaliseDTO>();

    // Período (em dias) das séries temporais — compartilhado entre as 3 abas,
    // mesmo padrão de seletor (SeletorPeriodo) usado em Financeiro.razor.
    private DateOnly inicio, fim;
    private string PeriodoLabel => $"{inicio:dd/MM} a {fim:dd/MM}";

    private static IEnumerable<MenuAtalhos.Item> atalhos
    {
        get
        {
            yield return new("Financeiro", "💰", "/financeiro", "Receita, despesas, lucro.");
            yield return new("Oficina", "🔧", "/oficina", "Ordens de serviço, recepção, estoque.");
            yield return new("Concessionária", "🚗", "/concessionaria", "Salão, propostas, consignações.");
            yield return new("Relatórios", "📑", "/dashboard/relatorios", "Exportar dados por período.");
            yield return new("Início", "🏠", "/", "Painel geral do sistema.");
        }
    }

    private string AbaClass(string aba) => aba == abaAtiva ? "dash-aba dash-aba-ativa" : "dash-aba";

    private async Task SetAba(string aba)
    {
        if (abaAtiva == aba) return;
        abaAtiva = aba;
        StateHasChanged();
        // Re-render dos gráficos da aba que acabou de aparecer (canvases só
        // existem no DOM depois do StateHasChanged).
        await Task.Yield();
        await RenderizarGraficos();
    }

    private async Task OnGraficoSelecionado(ChangeEventArgs e)
    {
        graficoSelecionadoId = e.Value?.ToString() ?? "financeiro-composicao";
        await RenderizarGraficoSelecionado();
    }

    private async Task OnGraficoSelecionadoOficina(ChangeEventArgs e)
    {
        graficoSelecionadoOficinaId = e.Value?.ToString() ?? graficoSelecionadoOficinaId;
        await RenderizarGraficoPorId(graficoSelecionadoOficinaId, "chartAnaliseSelecionadaOficina");
    }

    private async Task OnGraficoSelecionadoConcessionaria(ChangeEventArgs e)
    {
        graficoSelecionadoConcessionariaId = e.Value?.ToString() ?? graficoSelecionadoConcessionariaId;
        await RenderizarGraficoPorId(graficoSelecionadoConcessionariaId, "chartAnaliseSelecionadaConcessionaria");
    }

    private async Task OnPeriodoAlterado()
    {
        var rMetricas = await DashboardService.ObterMetricasPeriodoAsync(inicio.ToDateTime(TimeOnly.MinValue), fim.ToDateTime(TimeOnly.MaxValue));
        if (rMetricas.IsSuccess) metricas = rMetricas.Value;

        StateHasChanged();
        // Canvases dependem do StateHasChanged já ter aplicado os novos
        // labels/valores antes de renderizar (mesmo padrão de SetAba).
        await Task.Yield();
        await RenderizarGraficos();
    }

    protected override async Task OnInitializedAsync()
    {
        // Detecta a role do usuário para decidir quais abas/relatórios mostrar.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        roleUsuario = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;

        var rModulos = await ConfiguracaoService.ObterModulosAtivosAsync();
        if (rModulos.IsSuccess)
        {
            moduloOficinaAtivo = rModulos.Value.Oficina;
            moduloConcessionariaAtivo = rModulos.Value.Concessionaria;
        }

        // Aba padrão por perfil: ChefeOficina cai na aba Oficina,
        // GerenteVendas cai na aba Concessionária. Admin segue em "geral".
        if (!PodeVerOficina && PodeVerConcessionaria)
            abaAtiva = "concessionaria";
        else if (PodeVerOficina && !PodeVerConcessionaria)
            abaAtiva = "oficina";

        var hoje = DateOnly.FromDateTime(DateTime.Today);
        inicio = hoje.AddDays(-14);
        fim = hoje;

        var todosVeiculos = await VeiculoService.GetAllAsync();
        if (todosVeiculos.IsSuccess && todosVeiculos.Value is not null)
        {
            var v = todosVeiculos.Value.ToList();
            veiculosDisponiveis = v.Count(x => x.Disponibilidade == "Disponivel");
            veiculosVendidos = v.Count(x => x.Disponibilidade == "Vendido");
            valorTotalEstoqueVeiculos = v.Where(x => x.Disponibilidade == "Disponivel").Sum(x => x.Valor);
        }

        var ordens = await OrdemService.GetAllAsync();
        if (ordens.IsSuccess && ordens.Value is not null)
        {
            var todas = ordens.Value.ToList();
            osPendentes = todas.Count(o => o.Status == "Pendente");
            osEmAndamento = todas.Count(o => o.Status == "EmAndamento");
            var inicioMes = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            osFinalizadasMes = todas.Count(o =>
                (o.Status == "Finalizada" || o.Status == "PagamentoPendente") && o.PrazoEstimado >= inicioMes);
            osRecentes = todas.OrderByDescending(o => o.PrazoEstimado).Take(6).ToList();
        }

        var clientes = await ClienteService.GetAllAsync();
        if (clientes.IsSuccess) totalClientes = clientes.Value?.Count() ?? 0;

        var mecanicos = await MecanicoService.GetAllAsync();
        if (mecanicos.IsSuccess) totalMecanicos = mecanicos.Value?.Count() ?? 0;

        var vendedores = await VendedorService.GetAllAsync();
        if (vendedores.IsSuccess) totalVendedores = vendedores.Value?.Count() ?? 0;

        var propostas = await PropostaService.GetAllAsync();
        if (propostas.IsSuccess && propostas.Value is not null)
            propostasAbertas = propostas.Value.Count(p =>
                p.Status != "Aprovada" && p.Status != "Rejeitada" && p.Status != "Cancelada");

        var baixos = await EstoqueService.ListarComEstoqueBaixoAsync();
        if (baixos.IsSuccess && baixos.Value is not null)
        {
            estoquesCriticos = baixos.Value.Take(6).ToList();
            pecasEstoqueBaixo = baixos.Value.Count();
        }

        var consignacoesAtivas = await ConsignacaoService.ObterAtivasAsync();
        if (consignacoesAtivas.IsSuccess && consignacoesAtivas.Value is not null)
            consignacoesVencendoEmBreve = consignacoesAtivas.Value
                .Where(c => c.EstaVencido || c.DiasRestantes <= 7)
                .OrderBy(c => c.DiasRestantes)
                .ToList();

        var rMetricas = await DashboardService.ObterMetricasPeriodoAsync(inicio.ToDateTime(TimeOnly.MinValue), fim.ToDateTime(TimeOnly.MaxValue));
        if (rMetricas.IsSuccess) metricas = rMetricas.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (metricas is null) return;
        // Renderiza apenas no primeiro render — trocas de aba chamam
        // RenderizarGraficos() diretamente via SetAba.
        if (firstRender) await RenderizarGraficos();
    }

    /// <summary>Despesa "Geral" (sem setor específico) não tem série própria
    /// — sobra como resíduo (Total - Oficina - Concessionaria) em cada ponto
    /// e é dividida meio a meio entre os dois setores. Mesmo cálculo de
    /// Financeiro.razor (docs/redesign/27-graficos-receita-por-setor.md).</summary>
    private static decimal[] DespesaComMetadeDoGeral(
        IReadOnlyList<MesValorDTO> setor, IReadOnlyList<MesValorDTO> total, IReadOnlyList<MesValorDTO> outroSetor)
    {
        var resultado = new decimal[setor.Count];
        for (var i = 0; i < setor.Count; i++)
        {
            var totalPonto = i < total.Count ? total[i].Valor : 0m;
            var outroPonto = i < outroSetor.Count ? outroSetor[i].Valor : 0m;
            var geralMetade = (totalPonto - setor[i].Valor - outroPonto) / 2m;
            resultado[i] = setor[i].Valor + geralMetade;
        }
        return resultado;
    }

    private async Task RenderizarGraficos()
    {
        if (metricas is null) return;

        var labels6m = metricas.SerieReceitaServicos.Select(s => s.Label).ToArray();
        var commonOpts = new {
            responsive = true,
            maintainAspectRatio = false,
            plugins = new { legend = new { position = "bottom" } }
        };

        // Rótulo da série de despesa — quando o período é curto o bastante
        // pra granularidade diária, cada ponto é uma fatia pro-rateada do
        // mês (nunca o mês inteiro repetido em cada dia — ver
        // docs/redesign/16-granularidade-despesas.md), não uma "estimativa".
        var rotuloDespesa = (fim.DayNumber - inicio.DayNumber + 1) <= 62
            ? "Despesa (rateada por dia)"
            : "Despesa";

        // ========== ABA GERAL ==========
        if (abaAtiva == "geral")
        {
            // Oficina e concessionária em gráficos separados — escalas muito
            // diferentes ficam ilegíveis no mesmo canvas (ver docs/redesign/
            // 27-graficos-receita-por-setor.md, mesmo padrão do Financeiro).
            // Despesa "Geral" (sem setor específico) não tem série própria —
            // divide-se meio a meio entre os dois setores.
            var despesaOficina6m = DespesaComMetadeDoGeral(metricas.SerieDespesasOficina, metricas.SerieDespesas, metricas.SerieDespesasConcessionaria);
            var datasetsOficina6m = new object[]
            {
                new {
                    label = "Receita",
                    data = metricas.SerieReceitaServicos.Select(s => s.Valor).ToArray(),
                    borderColor = "#16a34a",
                    backgroundColor = "rgba(22, 163, 74, 0.1)",
                    tension = 0.3, fill = true
                },
                new {
                    label = rotuloDespesa,
                    data = despesaOficina6m,
                    borderColor = "#ea580c",
                    backgroundColor = "rgba(234, 88, 12, 0.05)",
                    borderDash = new[] { 6, 4 },
                    tension = 0, fill = false
                }
            };
            await JS.InvokeVoidAsync("carstoreChart.render",
                "chartFaturamentoOficina6m", "line", labels6m, datasetsOficina6m, commonOpts);

            var despesaConcessionaria6m = DespesaComMetadeDoGeral(metricas.SerieDespesasConcessionaria, metricas.SerieDespesas, metricas.SerieDespesasOficina);
            var datasetsConcessionaria6m = new object[]
            {
                new {
                    label = "Receita",
                    data = metricas.SerieReceitaVendas.Select(s => s.Valor).ToArray(),
                    borderColor = "#2563eb",
                    backgroundColor = "rgba(37, 99, 235, 0.1)",
                    tension = 0.3, fill = true
                },
                new {
                    label = rotuloDespesa,
                    data = despesaConcessionaria6m,
                    borderColor = "#ea580c",
                    backgroundColor = "rgba(234, 88, 12, 0.05)",
                    borderDash = new[] { 6, 4 },
                    tension = 0, fill = false
                }
            };
            await JS.InvokeVoidAsync("carstoreChart.render",
                "chartFaturamentoConcessionaria6m", "line", labels6m, datasetsConcessionaria6m, commonOpts);

            await RenderizarGraficoSelecionado();

            var datasetsComparacao = new object[]
            {
                new {
                    label = "Oficina",
                    data = metricas.SerieReceitaServicos.Select(s => s.Valor).ToArray(),
                    backgroundColor = "#16a34a"
                },
                new {
                    label = "Concessionária",
                    data = metricas.SerieReceitaVendas.Select(s => s.Valor).ToArray(),
                    backgroundColor = "#2563eb"
                }
            };
            await JS.InvokeVoidAsync("carstoreChart.render",
                "chartComparacaoReceita", "bar", labels6m, datasetsComparacao, commonOpts);
        }

        // ========== ABA OFICINA ==========
        if (abaAtiva == "oficina")
        {
            var datasetsOf = new object[]
            {
                new {
                    label = "Receita de serviços",
                    data = metricas.SerieReceitaServicos.Select(s => s.Valor).ToArray(),
                    borderColor = "#16a34a",
                    backgroundColor = "rgba(22, 163, 74, 0.1)",
                    tension = 0.3, fill = true
                },
                new {
                    label = rotuloDespesa,
                    data = metricas.SerieDespesasOficina.Select(s => s.Valor).ToArray(),
                    borderColor = "#ea580c",
                    backgroundColor = "rgba(234, 88, 12, 0.05)",
                    borderDash = new[] { 6, 4 },
                    tension = 0, fill = false
                }
            };
            await JS.InvokeVoidAsync("carstoreChart.render",
                "chartOficina6m", "line", labels6m, datasetsOf, commonOpts);

            var (labelsOS, dadosOS, _) = MontarOSDataset();
            await JS.InvokeVoidAsync("carstoreChart.comparativo", "chartOSStatusOf",
                labelsOS.Zip(dadosOS, (l, v) => new { rotulo = l, valor = (decimal)v }).ToArray(), "");

            await JS.InvokeVoidAsync("carstoreChart.comparativo", "chartReceitaMecanico",
                metricas.ReceitaPorMecanico.Select(m => new { rotulo = m.MecanicoNome, valor = m.Receita }).ToArray(), "R$");

            await RenderizarGraficoPorId("mecanicos-por-especializacao", "chartMecanicosEspecializacao");
            await RenderizarGraficoPorId("servicos-tipo", "chartServicosTipo");
            await RenderizarGraficoPorId("marcas-visitam-oficina", "chartMarcasVisitamOficina");
            await RenderizarGraficoPorId("estoque-por-sistema", "chartEstoquePorSistema");
            await RenderizarGraficoPorId("prazo-medio-servico", "chartPrazoMedioServico");
            await RenderizarGraficoPorId(graficoSelecionadoOficinaId, "chartAnaliseSelecionadaOficina");
        }

        // ========== ABA CONCESSIONÁRIA ==========
        if (abaAtiva == "concessionaria")
        {
            var datasetsCo = new object[]
            {
                new {
                    label = "Receita de vendas",
                    data = metricas.SerieReceitaVendas.Select(s => s.Valor).ToArray(),
                    borderColor = "#2563eb",
                    backgroundColor = "rgba(37, 99, 235, 0.15)",
                    tension = 0.3, fill = true
                },
                new {
                    label = rotuloDespesa,
                    data = metricas.SerieDespesasConcessionaria.Select(s => s.Valor).ToArray(),
                    borderColor = "#ea580c",
                    backgroundColor = "rgba(234, 88, 12, 0.05)",
                    borderDash = new[] { 6, 4 },
                    tension = 0, fill = false
                }
            };
            await JS.InvokeVoidAsync("carstoreChart.render",
                "chartConcessionaria6m", "line", labels6m, datasetsCo, commonOpts);

            var (labelsVeic, dadosVeic, _) = MontarVeiculoStatusDataset();
            await JS.InvokeVoidAsync("carstoreChart.comparativo", "chartVeiculosStatus",
                labelsVeic.Zip(dadosVeic, (l, v) => new { rotulo = l, valor = (decimal)v }).ToArray(), "");

            await RenderizarGraficoPorId("marcas-vendidas", "chartVendasMarca");
            await RenderizarGraficoPorId("modelos-vendidos", "chartModelosVendidos");
            await RenderizarGraficoPorId("cores-vendidas", "chartCoresVendidas");
            await RenderizarGraficoPorId("vendas-consignacao-loja", "chartConsignacaoLoja");
            await RenderizarGraficoPorId("modos-pagamento", "chartModosPagamento");

            var labelsTimeline = metricas.PropostasTimeline.Select(t => t.Label).ToArray();
            var datasetsTimeline = new object[]
            {
                new {
                    label = "Aprovadas",
                    data = metricas.PropostasTimeline.Select(t => t.Aprovadas).ToArray(),
                    borderColor = "#16a34a",
                    backgroundColor = "rgba(22, 163, 74, 0.1)",
                    tension = 0.3, fill = true
                },
                new {
                    label = "Rejeitadas",
                    data = metricas.PropostasTimeline.Select(t => t.Rejeitadas).ToArray(),
                    borderColor = "#ef4444",
                    backgroundColor = "rgba(239, 68, 68, 0.1)",
                    tension = 0.3, fill = true
                }
            };
            await JS.InvokeVoidAsync("carstoreChart.render",
                "chartPropostasTimeline", "line", labelsTimeline, datasetsTimeline, commonOpts);

            await RenderizarGraficoPorId(graficoSelecionadoConcessionariaId, "chartAnaliseSelecionadaConcessionaria");
        }
    }

    // ========== CATÁLOGO MODULAR DE GRÁFICOS (metricas.Graficos) ==========
    // Um único caminho de render para qualquer entrada do catálogo — a aba
    // Geral usa isso via seletor (troca o id, chama de novo); Oficina e
    // Concessionária fixam um id por cartão. Adicionar um gráfico novo no
    // DashboardService não exige nenhuma mudança aqui.

    private async Task RenderizarGraficoSelecionado()
        => await RenderizarGraficoPorId(graficoSelecionadoId, "chartAnaliseSelecionada");

    private async Task RenderizarGraficoPorId(string graficoId, string canvasId)
    {
        var grafico = metricas?.Graficos.FirstOrDefault(g => g.Id == graficoId);
        if (grafico is null) return;

        // Ver docs/redesign/13-padrao-graficos.md — padrão único de comparação
        // categórica: até 6 tipos vira rosca (com hover de %), mais de 6 vira
        // barra horizontal só com os 10 maiores, sem "Outros". A escolha entre
        // rosca/barra não é mais decidida aqui nem por TipoGrafico — é
        // automática, pelo JS, com base em quantas categorias sobrevivem.
        var dados = grafico.Dados.Select(d => new { rotulo = d.Rotulo, valor = d.Valor }).ToArray();
        await JS.InvokeVoidAsync("carstoreChart.comparativo", canvasId, dados,
            grafico.Categoria == "Financeiro" ? "R$" : "");
    }

    /// <summary>
    /// Paleta categórica validada (8 tons distinguíveis para daltonismo, na
    /// ordem que passa nos pares adjacentes) — "Outros" sempre cinza neutro,
    /// fora da rotação, para não competir com as categorias reais.
    /// </summary>
    private static readonly string[] CoresCategoricas =
        { "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948" };
    private const string CorOutros = "#898781";

    private static string CorCategorica(string rotulo, int indice)
        => rotulo == "Outros" ? CorOutros : CoresCategoricas[indice % CoresCategoricas.Length];

    private (string[] labels, int[] dados, string[] cores) MontarOSDataset()
    {
        var corStatus = new Dictionary<string, string>
        {
            ["Pendente"]                    = "#eab308",
            ["EmVistoria"]                  = "#f97316",
            ["AguardandoCliente"]           = "#fbbf24",
            ["Aprovada"]                    = "#0ea5e9",
            ["EmAndamento"]                 = "#2563eb",
            ["BuscandoPecasParaOrcamento"]  = "#a855f7",
            ["Pausada"]                     = "#c026d3",
            ["PagamentoPendente"]           = "#ea580c",
            ["Finalizada"]                  = "#16a34a",
            ["Entregue"]                    = "#0d9488",
            ["Cancelada"]                   = "#ef4444"
        };

        var labels = metricas!.OrdensServicoPorStatus.Keys.ToArray();
        var dados = metricas.OrdensServicoPorStatus.Values.ToArray();
        var cores = labels.Select(l => corStatus.TryGetValue(l, out var c) ? c : "#888888").ToArray();
        return (labels, dados, cores);
    }

    private (string[] labels, int[] dados, string[] cores) MontarVeiculoStatusDataset()
    {
        var corStatus = new Dictionary<string, string>
        {
            ["EmPreparacao"] = "#fbbf24",
            ["Disponivel"]   = "#16a34a",
            ["Reservado"]    = "#eab308",
            ["Vendido"]      = "#2563eb"
        };

        var labels = metricas!.VeiculosPorStatus.Keys.ToArray();
        var dados = metricas.VeiculosPorStatus.Values.ToArray();
        var cores = labels.Select(l => corStatus.TryGetValue(l, out var c) ? c : "#888888").ToArray();
        return (labels, dados, cores);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            foreach (var id in new[] {
                "chartFaturamentoOficina6m", "chartFaturamentoConcessionaria6m", "chartAnaliseSelecionada", "chartComparacaoReceita",
                "chartOficina6m", "chartOSStatusOf", "chartReceitaMecanico",
                "chartMecanicosEspecializacao", "chartServicosTipo", "chartMarcasVisitamOficina",
                "chartEstoquePorSistema", "chartPrazoMedioServico", "chartAnaliseSelecionadaOficina",
                "chartConcessionaria6m", "chartVeiculosStatus", "chartVendasMarca", "chartPropostasTimeline",
                "chartModelosVendidos", "chartCoresVendidas", "chartConsignacaoLoja", "chartModosPagamento",
                "chartAnaliseSelecionadaConcessionaria"
            })
            {
                await JS.InvokeVoidAsync("carstoreChart.destroy", id);
            }
        }
        catch { /* circuito já fechado */ }
    }

    private static string FormatBRL(decimal v)
        => v.ToString("C", new CultureInfo("pt-BR"));

    private static string StatusClass(string status) => status switch
    {
        "Pendente" => "tag tag-amarelo",
        "EmAndamento" => "tag tag-azul",
        "PagamentoPendente" => "tag tag-laranja",
        "Finalizada" => "tag tag-verde",
        "Cancelada" => "tag tag-vermelho",
        _ => "tag"
    };
}

