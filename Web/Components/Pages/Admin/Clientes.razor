@page "/clientes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,ChefeOficina,GerenteVendas,Vendedor,Recepcionista")]

@namespace CarStoreManager.Web.Components.Pages

@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@inject IClienteService ClienteService
@inject IVeiculoClienteService VeiculoClienteService
@inject IVeiculoConsignacaoService ConsignacaoService
@inject NavigationManager Nav
@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.DTOs.Shared.Cliente
@using CarStoreManager.Application.DTOs.Oficina.VeiculoCliente
@using CarStoreManager.Application.DTOs.Concessionaria.VeiculoConsignacao
@using CarStoreManager.Web.Components.Shared

@using Microsoft.AspNetCore.Components.Web

<div class="pagina clientes-page">
    <PageHeader Titulo="Clientes" Subtitulo="@($"{todosClientes.Count} cliente(s) cadastrado(s) · oficina e concessionária")">
        <Acao>
            <button type="button" class="btn btn-primario" data-tour="clientes-btn-novo" @onclick="AbrirModalNovo">+ Adicionar cliente</button>
        </Acao>
    </PageHeader>

    <div data-tour="clientes-busca">
        <FiltroBar @bind-Busca="termoBusca" BuscaPlaceholder="Buscar por nome, CPF, telefone ou e-mail..." OnBusca="AplicarFiltro" />
    </div>

    @if (carregando)
    {
        <div class="loading">Carregando...</div>
    }
    else if (!clientesFiltrados.Any())
    {
        <div class="vazio-aba">Nenhum cliente encontrado.</div>
    }
    else
    {
        <div class="table-scroll">
            <table class="tab" data-tour="clientes-card-exemplo">
                <thead>
                    <tr>
                        <ColunaOrdenavel Coluna="nome" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Nome</ColunaOrdenavel>
                        <ColunaOrdenavel Coluna="cpf" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">CPF</ColunaOrdenavel>
                        <ColunaOrdenavel Coluna="telefone" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Telefone</ColunaOrdenavel>
                        <ColunaOrdenavel Coluna="email" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">E-mail</ColunaOrdenavel>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in clientesFiltrados)
                    {
                        <tr class="linha" @onclick="() => AbrirFicha(c.Id)">
                            <td class="forte">@c.Nome</td>
                            <td class="mono">@c.Cpf</td>
                            <td>@c.Telefone</td>
                            <td>@c.Email</td>
                            <td class="acoes" @onclick:stopPropagation="true">
                                <button type="button" class="cliente-editar" @onclick="() => AbrirDetalhe(c)">Editar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (modalNovoVisivel)
{
    <div class="modal-overlay" @onclick="() => modalNovoVisivel = false">
        <div class="modal-form" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-titulo">Adicionar cliente</span>
                <button type="button" class="modal-fechar" @onclick="() => modalNovoVisivel = false">×</button>
            </div>

            <div class="form-grid">
                <div class="form-campo span-2">
                    <label class="campo-label">Nome completo *</label>
                    <input class="campo-input" @bind="novoCliente.Nome" placeholder="Nome completo" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">CPF *</label>
                    <input class="campo-input" @bind="novoCliente.Cpf" placeholder="000.000.000-00" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Telefone *</label>
                    <input class="campo-input" @bind="novoCliente.Telefone" placeholder="(11) 99999-9999" />
                </div>
                <div class="form-campo span-2">
                    <label class="campo-label">E-mail</label>
                    <input class="campo-input" @bind="novoCliente.Email" placeholder="cliente@email.com" />
                </div>
            </div>

            <h3 class="detalhe-secao-titulo">Endereço residencial</h3>
            <div class="form-grid">
                <div class="form-campo">
                    <label class="campo-label">CEP *</label>
                    <input class="campo-input" @bind="novoCliente.Endereco.Cep" placeholder="00000-000" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">UF *</label>
                    <input class="campo-input" @bind="novoCliente.Endereco.Uf" placeholder="SP" maxlength="2" />
                </div>
                <div class="form-campo span-2">
                    <label class="campo-label">Logradouro *</label>
                    <input class="campo-input" @bind="novoCliente.Endereco.Logradouro" placeholder="Rua, Avenida, etc." />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Número *</label>
                    <input class="campo-input" @bind="novoCliente.Endereco.Numero" placeholder="123" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Complemento</label>
                    <input class="campo-input" @bind="novoCliente.Endereco.Complemento" placeholder="Apto, bloco..." />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Bairro *</label>
                    <input class="campo-input" @bind="novoCliente.Endereco.Bairro" placeholder="Bairro" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Cidade *</label>
                    <input class="campo-input" @bind="novoCliente.Endereco.Cidade" placeholder="Cidade" />
                </div>
            </div>

            @if (erroNovo is not null)
            {
                <div class="erro-banner">@erroNovo</div>
            }

            <div class="modal-acoes">
                <button type="button" class="btn-cancelar" @onclick="() => modalNovoVisivel = false">Cancelar</button>
                <button type="button" class="btn-confirmar" @onclick="CriarCliente" disabled="@salvandoNovo">
                    @(salvandoNovo ? "Cadastrando..." : "Cadastrar cliente")
                </button>
            </div>
        </div>
    </div>
}

@if (modalDetalheVisivel)
{
    <div class="modal-overlay" @onclick="() => modalDetalheVisivel = false">
        <div class="modal-form" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-titulo">@clienteSelecionado?.Nome</span>
                <button type="button" class="modal-fechar" @onclick="() => modalDetalheVisivel = false">×</button>
            </div>

            @if (carregandoDetalhe)
            {
                <div class="loading">Carregando...</div>
            }
            else if (clienteSelecionado is not null)
            {
                <div class="detalhe-secao">
                    <h3 class="detalhe-secao-titulo">Dados cadastrados</h3>
                    <div class="specs-grid">
                        <div class="spec"><span class="spec-label">CPF</span><span class="spec-val">@clienteSelecionado.Cpf</span></div>
                        <div class="spec"><span class="spec-label">Telefone</span><span class="spec-val">@clienteSelecionado.Telefone</span></div>
                        <div class="spec"><span class="spec-label">E-mail</span><span class="spec-val">@clienteSelecionado.Email</span></div>
                        <div class="spec"><span class="spec-label">Cliente desde</span><span class="spec-val">@clienteSelecionadoDataCriacao?.ToString("dd/MM/yyyy")</span></div>
                    </div>
                    <div class="specs-grid">
                        <div class="spec span-2">
                            <span class="spec-label">Endereço</span>
                            <span class="spec-val">
                                @clienteSelecionado.Endereco.Logradouro, @clienteSelecionado.Endereco.Numero
                                @(string.IsNullOrWhiteSpace(clienteSelecionado.Endereco.Complemento) ? "" : $"- {clienteSelecionado.Endereco.Complemento}")
                                — @clienteSelecionado.Endereco.Bairro, @clienteSelecionado.Endereco.Cidade/@clienteSelecionado.Endereco.Uf — CEP @clienteSelecionado.Endereco.Cep
                            </span>
                        </div>
                    </div>
                </div>

                <div class="detalhe-secao">
                    <h3 class="detalhe-secao-titulo">Veículos na oficina (@veiculosOficina.Count)</h3>
                    @if (!veiculosOficina.Any())
                    {
                        <p class="vazio-veiculos">Nenhum veículo cadastrado na oficina.</p>
                    }
                    else
                    {
                        <div class="veiculos-resumo-lista">
                            @foreach (var v in veiculosOficina)
                            {
                                <div class="veiculo-resumo-card">
                                    <span class="veiculo-resumo-titulo">@v.Marca @v.Modelo</span>
                                    <span class="veiculo-resumo-detalhe">@v.Ano · @v.Placa</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="detalhe-secao">
                    <h3 class="detalhe-secao-titulo">Veículos consignados (@veiculosConsignados.Count)</h3>
                    @if (!veiculosConsignados.Any())
                    {
                        <p class="vazio-veiculos">Nenhum veículo consignado por este cliente.</p>
                    }
                    else
                    {
                        <div class="veiculos-resumo-lista">
                            @foreach (var v in veiculosConsignados)
                            {
                                <div class="veiculo-resumo-card">
                                    <span class="veiculo-resumo-titulo">@v.Marca @v.Modelo</span>
                                    <span class="veiculo-resumo-detalhe">@v.Ano · @v.Placa · @v.Status</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private List<ClienteListaDTO> todosClientes = new();
    private List<ClienteListaDTO> clientesFiltrados = new();
    private string termoBusca = string.Empty;
    private bool carregando = true;

    // Ordenação da tabela — clique na coluna ordena crescente; clique de
    // novo na mesma coluna inverte pra decrescente (ver ColunaOrdenavel).
    private string sortColuna = "nome";
    private bool sortAscendente = true;

    private bool modalNovoVisivel = false;
    private bool salvandoNovo = false;
    private string? erroNovo;
    private CriarClienteDTO novoCliente = NovoFormPadrao();

    private bool modalDetalheVisivel = false;
    private bool carregandoDetalhe = false;
    private ClienteDTO? clienteSelecionado;
    private DateTime? clienteSelecionadoDataCriacao;
    private List<VeiculoClienteListaDTO> veiculosOficina = new();
    private List<VeiculoConsignacaoListaDTO> veiculosConsignados = new();

    protected override async Task OnInitializedAsync()
    {
        carregando = true;
        var r = await ClienteService.GetAllAsync();
        todosClientes = r.IsSuccess ? r.Value?.ToList() ?? new() : new();
        AplicarFiltro();
        carregando = false;
    }

    private void AplicarFiltro()
    {
        var baseLista = todosClientes.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(termoBusca))
        {
            var termo = termoBusca.Trim();
            baseLista = baseLista.Where(c =>
                c.Nome.Contains(termo, StringComparison.OrdinalIgnoreCase)
                || c.Cpf.Contains(termo, StringComparison.OrdinalIgnoreCase)
                || c.Telefone.Contains(termo, StringComparison.OrdinalIgnoreCase)
                || c.Email.Contains(termo, StringComparison.OrdinalIgnoreCase));
        }

        clientesFiltrados = baseLista.ToList();
        OrdenarClientes();
    }

    private void Ordenar(string coluna)
    {
        if (sortColuna == coluna) sortAscendente = !sortAscendente;
        else { sortColuna = coluna; sortAscendente = true; }
        OrdenarClientes();
    }

    private void OrdenarClientes()
    {
        clientesFiltrados = sortColuna switch
        {
            "cpf" => Ordenacao.Por(clientesFiltrados, c => c.Cpf, sortAscendente),
            "telefone" => Ordenacao.Por(clientesFiltrados, c => c.Telefone, sortAscendente),
            "email" => Ordenacao.Por(clientesFiltrados, c => c.Email, sortAscendente),
            _ => Ordenacao.Por(clientesFiltrados, c => c.Nome, sortAscendente),
        };
    }

    private void AbrirModalNovo()
    {
        novoCliente = NovoFormPadrao();
        erroNovo = null;
        modalNovoVisivel = true;
    }

    private async Task CriarCliente()
    {
        erroNovo = null;

        if (string.IsNullOrWhiteSpace(novoCliente.Nome) || string.IsNullOrWhiteSpace(novoCliente.Cpf)
            || string.IsNullOrWhiteSpace(novoCliente.Telefone))
        {
            erroNovo = "Nome, CPF e telefone são obrigatórios.";
            return;
        }

        var end = novoCliente.Endereco;
        if (string.IsNullOrWhiteSpace(end.Cep) || string.IsNullOrWhiteSpace(end.Uf)
            || string.IsNullOrWhiteSpace(end.Logradouro) || string.IsNullOrWhiteSpace(end.Numero)
            || string.IsNullOrWhiteSpace(end.Bairro) || string.IsNullOrWhiteSpace(end.Cidade))
        {
            erroNovo = "Preencha os campos obrigatórios do endereço (CEP, UF, Logradouro, Número, Bairro, Cidade).";
            return;
        }

        salvandoNovo = true;
        try
        {
            var resultado = await ClienteService.AddAsync(novoCliente);
            if (resultado.IsSuccess)
            {
                modalNovoVisivel = false;
                carregando = true;
                var r = await ClienteService.GetAllAsync();
                todosClientes = r.IsSuccess ? r.Value?.ToList() ?? new() : new();
                AplicarFiltro();
                carregando = false;
            }
            else
            {
                erroNovo = resultado.Error;
            }
        }
        catch (Exception ex)
        {
            erroNovo = $"Erro ao cadastrar cliente: {ex.Message}";
        }
        finally { salvandoNovo = false; }
    }

    private static CriarClienteDTO NovoFormPadrao() => new() { Endereco = new EnderecoDTO() };

    private void AbrirFicha(Guid id) => Nav.NavigateTo($"/clientes/{id}");

    private async Task AbrirDetalhe(ClienteListaDTO cliente)
    {
        modalDetalheVisivel = true;
        carregandoDetalhe = true;
        clienteSelecionado = null;
        clienteSelecionadoDataCriacao = cliente.DataCriacao;
        veiculosOficina = new();
        veiculosConsignados = new();

        var rDetalhe = await ClienteService.GetByIdAsync(cliente.Id);
        if (rDetalhe.IsSuccess) clienteSelecionado = rDetalhe.Value;

        var rOficina = await VeiculoClienteService.ObterPorClienteAsync(cliente.Id);
        if (rOficina.IsSuccess && rOficina.Value is not null)
            veiculosOficina = rOficina.Value.ToList();

        var rConsignados = await ConsignacaoService.ObterPorClienteProprietarioAsync(cliente.Id);
        if (rConsignados.IsSuccess && rConsignados.Value is not null)
            veiculosConsignados = rConsignados.Value.ToList();

        carregandoDetalhe = false;
    }
}

<style>
    .clientes-page {
        max-width: 980px;
        margin: 0 auto;
        padding: 32px 24px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .page-titulo { font-size: 24px; font-weight: 500; margin-bottom: 4px; }
    .page-sub { font-size: 14px; color: #888; }

    .toolbar {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .busca-input { flex: 1; }

    .campo-input {
        border: 0.5px solid #ccc;
        border-radius: 8px;
        padding: 9px 12px;
        font-size: 14px;
        outline: none;
        width: 100%;
    }
    .campo-input:focus { border-color: #0a84ff; }

    /* Tabela — mesmo padrão de tabela HTML usado nas outras telas de lista
       (Recepção, Ordens de serviço, Estoque, Fornecedores, Equipe,
       Concessionária): cabeçalho clicável (ColunaOrdenavel) declara as
       colunas, o navegador garante o alinhamento com as linhas. Zebra pra
       facilitar a leitura. */
    .table-scroll { overflow-x: auto; }
    .tab { width: 100%; border-collapse: collapse; background: #fff; border: 0.5px solid #e0e0e0; border-radius: 10px; overflow: hidden; }
    .tab th, .tab td { padding: 11px 16px; text-align: left; border-bottom: 0.5px solid #f0f0f0; font-size: 13px; }
    .tab th { background: #f4f4f4; font-size: 11px; text-transform: uppercase; letter-spacing: .3px; color: #888; }
    .tab tbody tr:nth-child(even) { background: #e9e9e9; }
    .linha { cursor: pointer; }
    .linha:hover { background: #eef6ff; }
    .forte { font-weight: 500; }
    .mono { font-family: monospace; }
    .acoes { text-align: right; }

    .vazio-aba {
        text-align: center;
        padding: 40px;
        color: #888;
        font-size: 14px;
    }

    .cliente-editar { background: #f4f4f4; border: 1px solid #e0e0e0; border-radius: 6px; padding: 5px 12px; font-size: 12px; cursor: pointer; }
    .cliente-editar:hover { background: #eaeaea; }

    .loading { text-align: center; padding: 60px; color: #888; font-size: 14px; }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
    }

    .modal-form {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        width: 100%;
        max-width: 620px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .modal-titulo { font-size: 16px; font-weight: 500; }

    .modal-fechar {
        background: none;
        border: none;
        font-size: 20px;
        color: #888;
        cursor: pointer;
    }

    /* Formulário "Adicionar cliente" — mesmo padrão visual do cadastro de
       cliente embutido na abertura de OS (Web/Components/Shared/
       ClientSelector.razor), pra manter os dois formulários de cliente
       do sistema com a mesma cara. */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
    .form-campo { display: flex; flex-direction: column; gap: 6px; }
    .span-2 { grid-column: span 2; }
    .campo-label { font-size: 12px; color: #555; font-weight: 500; }
    .erro-banner {
        background: #fff5f5; border: 0.5px solid #fca5a5; border-radius: 8px;
        padding: 10px 14px; font-size: 13px; color: #e02020; margin-bottom: 12px;
    }
    .modal-acoes { display: flex; justify-content: flex-end; gap: 10px; margin-top: 16px; }
    .btn-cancelar {
        background: #fff; border: 0.5px solid #ccc; border-radius: 8px;
        padding: 10px 20px; font-size: 14px; cursor: pointer; color: #444;
    }
    .btn-cancelar:hover { background: #f5f5f5; }
    .btn-confirmar {
        background: #e02020; color: #fff; border: none; border-radius: 8px;
        padding: 10px 24px; font-size: 14px; font-weight: 500; cursor: pointer;
    }
    .btn-confirmar:hover:not(:disabled) { background: #c01818; }
    .btn-confirmar:disabled { opacity: 0.6; cursor: not-allowed; }

    .detalhe-secao { margin-bottom: 20px; }
    .detalhe-secao-titulo {
        font-size: 13px; font-weight: 500; color: #444;
        margin: 18px 0 10px; border-bottom: 0.5px solid #eee; padding-bottom: 8px;
    }

    .specs-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 10px;
    }
    .spec { display: flex; flex-direction: column; gap: 2px; }
    .spec.span-2 { grid-column: span 2; }
    .spec-label { font-size: 11px; color: #888; }
    .spec-val { font-size: 14px; font-weight: 500; }

    .vazio-veiculos { font-size: 13px; color: #888; }

    .veiculos-resumo-lista {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .veiculo-resumo-card {
        background: #f9f9f9;
        border: 0.5px solid #e8e8e8;
        border-radius: 8px;
        padding: 10px 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .veiculo-resumo-titulo { font-size: 13px; font-weight: 500; }
    .veiculo-resumo-detalhe { font-size: 12px; color: #888; white-space: nowrap; }

    @@media (max-width: 640px) {
        .specs-grid { grid-template-columns: 1fr; }
        .spec.span-2 { grid-column: span 1; }
        .veiculo-resumo-card { flex-direction: column; align-items: flex-start; gap: 2px; }
    }
</style>
