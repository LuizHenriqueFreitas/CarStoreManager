@page "/concessionaria/propostas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,GerenteVendas,Vendedor")]

@namespace CarStoreManager.Web.Components.Pages

@rendermode InteractiveServer

@inject IPropostaVendaService PropostaService
@inject NavigationManager Nav
@using System.Globalization
@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.DTOs.Concessionaria.PropostaVenda
@using CarStoreManager.Web.Components.Shared

<div class="pagina">
    <PageHeader Titulo="Propostas de venda"
                Subtitulo="@($"{propostas.Count} proposta(s) · {precisamAtencao} aguardando ação")" />

    <SubNav Itens="SubNavConcessionaria.Itens" />

    @if (precisamAtencao > 0)
    {
        <FaixaAlertas Alertas="@(new List<FaixaAlertas.Alerta> {
            new($"{precisamAtencao} proposta(s) precisam de uma ação sua", "/concessionaria/propostas", "atencao", "📄") })" />
    }

    <FiltroBar @bind-Busca="busca" BuscaPlaceholder="Buscar por cliente, veículo ou nº..." OnBusca="AplicarFiltro">
        <FiltroSelect Rotulo="Situação" @bind-Valor="filtroSituacao" OnMudou="AplicarFiltro" Opcoes="opcoesSituacao" />
        <FiltroSelect Rotulo="Status" @bind-Valor="filtroStatus" OnMudou="AplicarFiltro" Opcoes="opcoesStatus" />
        <FiltroSelect Rotulo="Pagamento" @bind-Valor="filtroPagamento" OnMudou="AplicarFiltro" Opcoes="opcoesPagamento" />
        <FiltroSelect Rotulo="Ordenar" @bind-Valor="ordenacao" OnMudou="AplicarFiltro" Opcoes="opcoesOrdem" />
    </FiltroBar>

    @if (carregando)
    {
        <div class="estado-carregando">Carregando...</div>
    }
    else if (!filtradas.Any())
    {
        <EstadoVazio Mensagem="Nenhuma proposta com esses filtros." Icone="📄" />
    }
    else
    {
        <div class="table-scroll">
            <table class="tab">
                <thead>
                    <tr>
                        <th>Nº</th><th>Cliente</th><th>Veículo</th><th>Pagamento</th>
                        <th class="r">Valor</th><th>Criada</th><th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in filtradas)
                    {
                        <tr class="linha @(PrecisaAtencao(p) ? "destaque" : "")" @onclick="() => Abrir(p.Id)">
                            <td class="num">#@p.Id.ToString()[..6].ToUpper()</td>
                            <td>@(string.IsNullOrEmpty(p.ClienteNome) ? "—" : p.ClienteNome)</td>
                            <td>@p.VeiculoMarca @p.VeiculoModelo</td>
                            <td><span class="pill">@ModoLabel(p.ModoPagamento)</span></td>
                            <td class="r valor">@p.ValorFinal.ToString("C", Cultura)</td>
                            <td>
                                <div>@p.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                @{ var info = DiasInfo(p); }
                                @if (!string.IsNullOrEmpty(info)) { <small class="muted">@info</small> }
                            </td>
                            <td><StatusBadge Status="@p.Status" Familia="proposta" /></td>
                            <td>@if (PrecisaAtencao(p)) { <span class="ping" title="Precisa de ação">●</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Cultura = new("pt-BR");

    private List<PropostaVendaListaDTO> propostas = new();
    private List<PropostaVendaListaDTO> filtradas = new();
    private bool carregando = true;
    private int precisamAtencao;

    private string busca = "";
    private string filtroSituacao = "abertas";
    private string filtroStatus = "";
    private string filtroPagamento = "";
    private string ordenacao = "recentes";

    private static readonly List<FiltroSelect.Opcao> opcoesSituacao = new()
    {
        new("abertas", "Em andamento"), new("todas", "Todas"),
        new("atencao", "Precisam de ação"), new("finalizadas", "Finalizadas")
    };
    private static readonly List<FiltroSelect.Opcao> opcoesStatus = new()
    {
        new("", "Qualquer status"),
        new("Criada", "Ativa"), new("AguardandoFinanciadora", "Aguardando financiadora"),
        new("PropostaFinanciadoraRecebida", "Resposta da financiadora"), new("Aprovada", "Aprovada"),
        new("AguardandoVistoria", "Aguardando vistoria"), new("VistoriaConcluida", "Vistoria concluída"),
        new("AguardandoAssinaturaTermo", "Aguardando assinatura"), new("Concluida", "Concluída"),
        new("Rejeitada", "Rejeitada"), new("Cancelada", "Cancelada"), new("Expirada", "Expirada")
    };
    private static readonly List<FiltroSelect.Opcao> opcoesPagamento = new()
    {
        new("", "Qualquer forma"), new("Dinheiro", "Dinheiro"), new("Pix", "Pix"),
        new("CartaoDebito", "Cartão débito"), new("CartaoCredito", "Cartão crédito"),
        new("Financiamento", "Financiamento"), new("Boleto", "Boleto"), new("Transferencia", "TED/DOC")
    };
    private static readonly List<FiltroSelect.Opcao> opcoesOrdem = new()
    {
        new("recentes", "Mais recentes"), new("antigas", "Mais antigas"),
        new("valor-desc", "Maior valor"), new("valor-asc", "Menor valor")
    };

    private static readonly string[] Atencao = { "PropostaFinanciadoraRecebida", "Aprovada", "VistoriaConcluida", "AguardandoAssinaturaTermo" };
    private static readonly string[] Terminal = { "Concluida", "Rejeitada", "Cancelada", "Expirada" };

    protected override async Task OnInitializedAsync()
    {
        var r = await PropostaService.GetAllAsync();
        propostas = r.IsSuccess ? r.Value?.ToList() ?? new() : new();
        precisamAtencao = propostas.Count(PrecisaAtencao);
        AplicarFiltro();
        carregando = false;
    }

    private void AplicarFiltro()
    {
        IEnumerable<PropostaVendaListaDTO> q = filtroSituacao switch
        {
            "abertas" => propostas.Where(p => !Terminal.Contains(p.Status)),
            "atencao" => propostas.Where(PrecisaAtencao),
            "finalizadas" => propostas.Where(p => Terminal.Contains(p.Status)),
            _ => propostas
        };

        if (!string.IsNullOrEmpty(filtroStatus))
            q = q.Where(p => p.Status == filtroStatus);
        if (!string.IsNullOrEmpty(filtroPagamento))
            q = q.Where(p => p.ModoPagamento == filtroPagamento);

        if (!string.IsNullOrWhiteSpace(busca))
        {
            var t = busca.Trim();
            q = q.Where(p =>
                p.Id.ToString().StartsWith(t, StringComparison.OrdinalIgnoreCase)
                || (p.ClienteNome?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)
                || ($"{p.VeiculoMarca} {p.VeiculoModelo}".Contains(t, StringComparison.OrdinalIgnoreCase)));
        }

        q = ordenacao switch
        {
            "antigas" => q.OrderBy(p => p.DataCriacao),
            "valor-desc" => q.OrderByDescending(p => p.ValorFinal),
            "valor-asc" => q.OrderBy(p => p.ValorFinal),
            _ => q.OrderByDescending(p => p.DataCriacao)
        };

        filtradas = q.ToList();
    }

    private void Abrir(Guid id) => Nav.NavigateTo($"/concessionaria/proposta/{id}");

    private static bool PrecisaAtencao(PropostaVendaListaDTO p) => Atencao.Contains(p.Status);

    private static string DiasInfo(PropostaVendaListaDTO p)
    {
        if (p.Status is "Criada" or "AguardandoFinanciadora" or "PropostaFinanciadoraRecebida")
            return p.DiasRestantes > 0 ? $"expira em {p.DiasRestantes}d" : "vencida";
        return "";
    }

    private static string ModoLabel(string m) => m switch
    {
        "Dinheiro" => "Dinheiro", "Pix" => "Pix", "CartaoDebito" => "Débito",
        "CartaoCredito" => "Crédito", "Financiamento" => "Financiamento",
        "Boleto" => "Boleto", "Transferencia" => "TED/DOC", _ => "—"
    };
}

<style>
    .tab { width: 100%; border-collapse: collapse; background: var(--cor-superficie); border: 1px solid var(--cor-linha); border-radius: var(--raio-lg); overflow: hidden; }
    .tab th, .tab td { padding: 11px 14px; text-align: left; border-bottom: 1px solid var(--cor-linha-suave); font-size: var(--txt-sm); vertical-align: middle; }
    .tab th { background: var(--cor-fundo); font-size: var(--txt-xs); text-transform: uppercase; color: var(--cor-tinta-3); letter-spacing: .3px; }
    .tab th.r, .tab td.r { text-align: right; }
    .linha { cursor: pointer; transition: background .1s; }
    .linha:hover { background: var(--cor-info-bg); }
    .linha.destaque { background: #fffbeb; }
    .num { font-family: monospace; font-weight: var(--peso-forte); color: var(--cor-acao); }
    .valor { font-weight: var(--peso-bold); }
    .pill { background: var(--cor-info-bg); color: var(--cor-info-tx); padding: 3px 9px; border-radius: var(--raio-full); font-size: var(--txt-xs); font-weight: var(--peso-medio); white-space: nowrap; }
    .ping { color: var(--dot-amarelo); font-size: 1.3em; }
    @@media (max-width: 900px) { .tab { min-width: 760px; } }
</style>
