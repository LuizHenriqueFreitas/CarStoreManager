@page "/concessionaria/veiculo/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,GerenteVendas,Vendedor")]

@namespace CarStoreManager.Web.Components.Pages

@inject IVeiculoVendaService VeiculoService
@inject IVeiculoConsignacaoService ConsignacaoService
@inject IFotoService FotoService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject IMercadoLivrePublicacaoService MercadoLivreService
@using CarStoreManager.Application.Common
@using CarStoreManager.Application.Interfaces
@inject NavigationManager Nav
@using CarStoreManager.Application.DTOs.Concessionaria.VeiculoVenda
@using CarStoreManager.Application.DTOs.Concessionaria.VeiculoConsignacao
@using CarStoreManager.Domain.Entities.Concessionaria
@using CarStoreManager.Application.DTOs.Integracoes.MercadoLivre
@using CarStoreManager.Application.DTOs
@using CarStoreManager.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.IO

@if (carregando)
{
    <div class="loading">Carregando...</div>
}
else if (!Encontrado)
{
    <div class="loading">Veículo não encontrado.</div>
}
else
{
    <div class="galeria-wrapper" data-tour="veiculo-detalhe-galeria">
        <div class="galeria-principal">
            @if (FotosUrls.Any())
            {
                @* Mostra a foto principal com object-fit contain (sem esticar/cortar)
                   e prévias parciais das fotos vizinhas nas margens. *@
                <button class="galeria-arr left" @onclick="FotoAnterior"
                        style="@(FotosUrls.Count > 1 ? "" : "display:none")">‹</button>

                @if (FotosUrls.Count > 1)
                {
                    var idxAnt = (fotoAtiva - 1 + FotosUrls.Count) % FotosUrls.Count;
                    <div class="galeria-vizinha esquerda" @onclick="FotoAnterior">
                        <img src="@FotosUrls[idxAnt]" alt="" />
                    </div>
                }

                <div class="galeria-foto" @onclick="() => AbrirFullscreen(fotoAtiva)">
                    <img src="@FotosUrls[fotoAtiva]" alt="Foto do veículo" />
                    <span class="galeria-zoom">🔍</span>
                </div>

                @if (FotosUrls.Count > 1)
                {
                    var idxProx = (fotoAtiva + 1) % FotosUrls.Count;
                    <div class="galeria-vizinha direita" @onclick="ProximaFoto">
                        <img src="@FotosUrls[idxProx]" alt="" />
                    </div>
                }

                <button class="galeria-arr right" @onclick="ProximaFoto"
                        style="@(FotosUrls.Count > 1 ? "" : "display:none")">›</button>
            }
            else
            {
                <div class="galeria-vazia">Sem fotos cadastradas</div>
            }
        </div>

        @if (FotosUrls.Count > 1)
        {
            <div class="galeria-dots">
                @for (int i = 0; i < FotosUrls.Count; i++)
                {
                    var idx = i;
                    <span class="@(i == fotoAtiva ? "dot ativo" : "dot")"
                          @onclick="() => fotoAtiva = idx"></span>
                }
            </div>
        }
    </div>

    @if (fotoFullscreenIdx is not null)
    {
        <div class="fs-overlay" @onclick="FecharFullscreen">
            <button class="fs-fechar" @onclick="FecharFullscreen" @onclick:stopPropagation="true">✕</button>
            @if (FotosUrls.Count > 1)
            {
                <button class="fs-arr left" @onclick:stopPropagation="true" @onclick="FsAnterior">‹</button>
                <button class="fs-arr right" @onclick:stopPropagation="true" @onclick="FsProxima">›</button>
            }
            <img src="@FotosUrls[fotoFullscreenIdx.Value]" class="fs-img" @onclick:stopPropagation="true" alt="Foto ampliada" />
        </div>
    }

    <div class="detalhe-content">
        <div class="detalhe-main">
            <div class="detalhe-header" data-tour="veiculo-detalhe-header">
                <div>
                    <h1 class="detalhe-titulo">@Marca @Modelo</h1>
                    <p class="detalhe-sub">@Ano · @Combustivel · @Cambio · @Motorizacao</p>
                </div>
                <span class="badge @BadgeClass">@StatusLabel</span>
            </div>

            @if (IsConsignado && consignacao is not null)
            {
                @if (consignacao.EstaVencido)
                {
                    <div class="banner-alerta">⚠ Prazo de consignação vencido há @Math.Abs(consignacao.DiasRestantes) dia(s).</div>
                }
                else if (consignacao.Status == "Ativa")
                {
                    <div class="banner-info">@consignacao.DiasRestantes dia(s) restantes até @consignacao.DataVencimento.ToString("dd/MM/yyyy")</div>
                }
            }

            <div class="detalhe-section" data-tour="veiculo-detalhe-especificacoes">
                <h2 class="section-titulo">Especificações</h2>
                <div class="specs-grid">
                    <div class="spec"><span class="spec-label">Ano</span><span class="spec-val">@Ano</span></div>
                    <div class="spec"><span class="spec-label">Quilometragem</span><span class="spec-val">@Quilometragem.ToString("N0") km</span></div>
                    <div class="spec"><span class="spec-label">Cor</span><span class="spec-val">@Cor</span></div>
                    <div class="spec"><span class="spec-label">Combustível</span><span class="spec-val">@Combustivel</span></div>
                    <div class="spec"><span class="spec-label">Câmbio</span><span class="spec-val">@Cambio</span></div>
                    <div class="spec"><span class="spec-label">Motorização</span><span class="spec-val">@Motorizacao</span></div>
                    <div class="spec"><span class="spec-label">Placa</span><span class="spec-val">@Placa</span></div>
                    @if (veiculo is not null)
                    {
                        <div class="spec"><span class="spec-label">Último IPVA pago</span><span class="spec-val">@veiculo.AnoUltimoIpvaPago</span></div>
                        <AuthorizeView Roles="Admin,GerenteVendas" Context="ctxValorAquisicao">
                            <Authorized>
                                <div class="spec"><span class="spec-label">Valor de aquisição</span><span class="spec-val">@FormatBRL(veiculo.ValorAquisicao)</span></div>
                            </Authorized>
                        </AuthorizeView>
                    }
                </div>
            </div>

            @if (Acessorios.Any())
            {
                <div class="detalhe-section">
                    <h2 class="section-titulo">Acessórios</h2>
                    <div class="acc-lista">
                        @foreach (var acc in Acessorios)
                        {
                            <span class="acc-tag">
                                <span class="acc-dot"></span>
                                @acc
                            </span>
                        }
                    </div>
                </div>
            }

            @if (IsConsignado && consignacao is not null)
            {
                <div class="detalhe-section" data-tour="consig-detalhe-info">
                    <h2 class="section-titulo">Consignação — proprietário e vendedor</h2>
                    <div class="specs-grid">
                        <div class="spec"><span class="spec-label">Proprietário</span><span class="spec-val">@consignacao.ClienteProprietarioNome</span></div>
                        <div class="spec"><span class="spec-label">Vendedor responsável</span><span class="spec-val">@consignacao.VendedorResponsavelNome</span></div>
                        <div class="spec"><span class="spec-label">Início da consignação</span><span class="spec-val">@consignacao.DataInicio.ToString("dd/MM/yyyy")</span></div>
                        <div class="spec"><span class="spec-label">Vencimento</span><span class="spec-val">@consignacao.DataVencimento.ToString("dd/MM/yyyy")</span></div>
                    </div>
                </div>

                <div class="detalhe-section" data-tour="consig-detalhe-comissao">
                    <h2 class="section-titulo">Consignação — comissão</h2>
                    <div class="specs-grid">
                        <div class="spec"><span class="spec-label">Valor de venda esperado</span><span class="spec-val">@FormatBRL(consignacao.ValorVendaEsperado)</span></div>
                        @if (consignacao.TipoComissao == "Fixo")
                        {
                            <div class="spec"><span class="spec-label">Repasse ao proprietário</span><span class="spec-val">@FormatBRL(consignacao.ValorFixoProprietario ?? 0)</span></div>
                        }
                        else
                        {
                            <div class="spec"><span class="spec-label">% do proprietário</span><span class="spec-val">@consignacao.PorcentagemProprietario%</span></div>
                        }
                    </div>
                </div>

                <div class="detalhe-section">
                    <h2 class="section-titulo">Consignação — contrato</h2>
                    <p class="contrato-texto">@(string.IsNullOrWhiteSpace(consignacao.TextoContrato) ? "Nenhum termo cadastrado." : consignacao.TextoContrato)</p>
                    @if (!string.IsNullOrWhiteSpace(consignacao.TextoContrato))
                    {
                        <BotaoExportarPdf Titulo="@($"Contrato de consignação - {Marca} {Modelo}")" Conteudo="@consignacao.TextoContrato" CssClass="btn-secondary" />
                    }
                    @if (!string.IsNullOrWhiteSpace(consignacao.UrlContratoPdf))
                    {
                        <a href="@consignacao.UrlContratoPdf" target="_blank" class="link-contrato">📄 Abrir contrato (PDF)</a>
                    }
                </div>

                <div class="detalhe-section">
                    <h2 class="section-titulo">Consignação — histórico</h2>
                    @if (consignacao.Historico.Any())
                    {
                        <ul class="historico-lista">
                            @foreach (var h in consignacao.Historico)
                            {
                                <li class="historico-item">
                                    <span class="historico-data">@h.Data.ToString("dd/MM/yyyy HH:mm")</span>
                                    <span class="historico-tipo">@h.TipoEvento</span>
                                    <span class="historico-desc">@h.Descricao</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="vazio">Nenhum evento registrado.</p>
                    }
                </div>
            }
        </div>

        <div class="detalhe-sidebar">
            <div class="preco-card">
                <span class="preco-label">@(IsConsignado ? "Valor de venda esperado" : "Valor")</span>
                <span class="preco-val">
                    @ValorPrincipal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                </span>

                @if (!IsConsignado)
                {
                    @if (veiculo!.Disponibilidade == "Disponivel")
                    {
                        <button class="btn-primary" data-tour="veiculo-detalhe-acao-principal" @onclick="GerarProposta">
                            Gerar proposta de venda
                        </button>
                    }
                    else if (veiculo.Disponibilidade == "EmPreparacao")
                    {
                        <div class="preparacao-aviso">
                            ⚙ Veículo em preparação (lavagem / ajustes / documentação)
                        </div>
                        <AuthorizeView Roles="Admin,GerenteVendas" Context="ctxLib">
                            <Authorized>
                                <button class="btn-primary" data-tour="veiculo-detalhe-acao-principal" @onclick="LiberarParaVenda">
                                    ✓ Liberar para venda
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    }

                    @if (veiculo.Disponibilidade == "Disponivel")
                    {
                        <AuthorizeView Roles="Admin,GerenteVendas" Context="ctxVolta">
                            <Authorized>
                                <button class="btn-secondary" @onclick="VoltarParaPreparacao">
                                    ⚙ Voltar para preparação
                                </button>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin,GerenteVendas" Context="ctxPublicarMl">
                            <Authorized>
                                <button class="btn-secondary" @onclick="PublicarNoMercadoLivre">
                                    Publicar no Mercado Livre
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    }

                    <button class="btn-secondary" @onclick="AbrirModalEdicao">
                        Editar veículo
                    </button>

                    <button class="btn-excluir" @onclick="AbrirModalExclusao">
                        Excluir veículo
                    </button>
                }
                else if (consignacao is not null)
                {
                    @if (consignacao.Status is "Ativa" or "Expirada")
                    {
                        @if (consignacao.Status == "Expirada" || consignacao.DiasRestantes <= VeiculoConsignacao.DiasParaHabilitarRenovacao)
                        {
                            <AuthorizeView Roles="Admin,GerenteVendas" Context="ctxRenovar">
                                <Authorized>
                                    <button class="btn-secondary" data-tour="consig-detalhe-renovar-btn" @onclick="AbrirModalRenovar" disabled="@processandoConsignacao">Renovar (+90 dias)</button>
                                </Authorized>
                            </AuthorizeView>
                        }
                        else
                        {
                            <span class="aviso-vencido" data-tour="consig-detalhe-renovar-btn" title="A renovação só fica disponível a partir de 10 dias antes do vencimento.">
                                Renovação disponível a partir de @VeiculoConsignacao.DiasParaHabilitarRenovacao dias antes do vencimento (faltam @consignacao.DiasRestantes)
                            </span>
                        }
                        @if (consignacao.Status == "Ativa")
                        {
                            <AuthorizeView Roles="Admin,GerenteVendas,Vendedor" Context="ctxGerarPropostaConsig">
                                <Authorized>
                                    <button class="btn-primary" data-tour="consig-detalhe-gerar-proposta-btn" @onclick="GerarPropostaConsignado">Gerar proposta de venda</button>
                                </Authorized>
                            </AuthorizeView>
                        }
                        else
                        {
                            <span class="aviso-vencido" data-tour="consig-detalhe-gerar-proposta-btn" title="O prazo da consignação venceu — renove o contrato antes de gerar uma proposta.">
                                Prazo vencido — renove pra poder gerar proposta
                            </span>
                        }
                        <AuthorizeView Roles="Admin,GerenteVendas,Vendedor" Context="ctxDevolver">
                            <Authorized>
                                <button class="btn-secondary" data-tour="consig-detalhe-devolver-btn" @onclick="Devolver" disabled="@processandoConsignacao">Devolver ao proprietário</button>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin,GerenteVendas" Context="ctxPublicarMlConsig">
                            <Authorized>
                                <button class="btn-secondary" @onclick="PublicarNoMercadoLivre">
                                    Publicar no Mercado Livre
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    }
                    @if (consignacao.Status == "VendidoAguardandoPagamento")
                    {
                        <AuthorizeView Roles="Admin,GerenteVendas" Context="ctxConcluir">
                            <Authorized>
                                <button class="btn-primary" @onclick="ConcluirVenda" disabled="@processandoConsignacao">Confirmar pagamento e concluir</button>
                            </Authorized>
                        </AuthorizeView>
                    }

                    <AuthorizeView Roles="Admin,GerenteVendas" Context="ctxEditarContrato">
                        <Authorized>
                            <button class="btn-secondary" @onclick="AbrirModalEdicao">
                                Editar contrato / fotos
                            </button>
                        </Authorized>
                    </AuthorizeView>

                    @if (consignacao.Status is "Ativa" or "Expirada")
                    {
                        <AuthorizeView Roles="Admin,GerenteVendas" Context="ctxCancelarConsig">
                            <Authorized>
                                @if (!mostrarCancelamento)
                                {
                                    <button class="btn-excluir" @onclick="() => mostrarCancelamento = true" disabled="@processandoConsignacao">
                                        Cancelar consignação
                                    </button>
                                }
                            </Authorized>
                        </AuthorizeView>
                    }

                    @if (mostrarCancelamento)
                    {
                        <div class="cancelamento-bloco">
                            <label class="campo-label">Motivo do cancelamento *</label>
                            <textarea class="campo-input" rows="3" @bind="motivoCancelamento"></textarea>
                            <div class="cancelamento-acoes">
                                <button class="btn-cancelar" @onclick="() => mostrarCancelamento = false">Voltar</button>
                                <button class="btn-excluir" @onclick="Cancelar" disabled="@processandoConsignacao">Confirmar</button>
                            </div>
                        </div>
                    }

                    @if (erroConsignacao is not null)
                    {
                        <div class="erro-banner">@erroConsignacao</div>
                    }
                }

                <button class="btn-voltar" @onclick='() => Nav.NavigateTo("/concessionaria")'>
                    ← Voltar ao estoque
                </button>
            </div>
        </div>
    </div>

    <ConfirmacaoModal
        Visivel="modalSalvarEdicaoVisivel"
        Titulo="Confirmar alterações"
        Mensagem="@($"Deseja salvar as alterações em {Marca} {Modelo}?")"
        TextoConfirmar="Salvar"
        OnConfirmar="SalvarAlteracoes"
        OnCancelar="() => modalSalvarEdicaoVisivel = false" />

    @if (IsConsignado)
    {
        <ConfirmacaoSenhaModal
            Visivel="modalRenovarVisivel"
            Titulo="Renovar consignação"
            Descricao="@($"Renovar a consignação de {Marca} {Modelo} por mais 90 dias? Confirme com sua senha.")"
            TextoBotao="Renovar"
            OnConfirmar="ConfirmarRenovar"
            OnCancelar="() => modalRenovarVisivel = false"
            @ref="modalRenovarRef" />
    }

    @if (!IsConsignado)
    {
        <ConfirmacaoSenhaModal
            Visivel="modalExclusaoVisivel"
            Titulo="Excluir veículo"
            Descricao="@($"Tem certeza que deseja excluir {Marca} {Modelo}? Esta ação não pode ser desfeita.")"
            TextoBotao="Excluir permanentemente"
            Destrutivo="true"
            ApenasAdmin="true"
            OnConfirmar="ConfirmarExclusao"
            OnCancelar="() => modalExclusaoVisivel = false"
            @ref="modalExclusaoRef" />
    }

    @if (modalFormEdicaoVisivel)
    {
        <div class="modal-overlay" @onclick="() => modalFormEdicaoVisivel = false">
            <div class="modal-form" @onclick:stopPropagation>
                <div class="modal-header">
                    <span class="modal-titulo">@(IsConsignado ? "Editar contrato / fotos" : "Editar veículo")</span>
                    <button class="modal-fechar" @onclick="() => modalFormEdicaoVisivel = false">×</button>
                </div>

                @if (!IsConsignado)
                {
                    <div class="form-grid">
                        <div class="form-campo">
                            <label class="campo-label">Valor (R$)</label>
                            <input type="number" class="campo-input" @bind="formEdicao.Valor" />
                        </div>
                        <div class="form-campo">
                            <label class="campo-label">Disponibilidade</label>
                            <select class="campo-input" @bind="formEdicao.Disponibilidade">
                                <option value="EmPreparacao">Em preparação</option>
                                <option value="Disponivel">Disponível</option>
                                <option value="Reservado">Reservado</option>
                                <option value="Vendido">Vendido</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-secao">
                        <label class="campo-label">Termo de entrega preliminar</label>
                        <p class="secao-sub" style="font-size:.85em; color:#666; margin:4px 0 6px;">
                            Será usado como base do termo final quando a proposta for gerada.
                        </p>
                        <SeletorTemplateDocumento Label="Substituir por um template"
                                                  OnTemplateAplicado="AplicarTemplateTermoEdicao" />
                        <textarea class="campo-input" rows="6"
                                  @bind="formEdicao.TextoTermoPreliminar"
                                  placeholder="Texto do termo de entrega..."></textarea>
                    </div>
                }
                else
                {
                    <div class="form-secao">
                        <label class="campo-label">Texto do contrato de consignação</label>
                        <SeletorTemplateDocumento Label="Substituir por um template"
                                                  OnTemplateAplicado="AplicarTemplateContratoEdicao" />
                        <textarea class="campo-input" rows="6"
                                  @bind="formEdicaoConsignacao.TextoContrato"
                                  placeholder="Texto do contrato..."></textarea>
                    </div>
                    <div class="form-secao">
                        <label class="campo-label">URL do contrato (PDF)</label>
                        <input class="campo-input" @bind="formEdicaoConsignacao.UrlContratoPdf" placeholder="https://..." />
                    </div>
                }

                <!-- SEÇÃO DE GERENCIAMENTO DE FOTOS -->
                <div class="form-secao">
                    <h3 class="secao-titulo">Fotos do veículo</h3>

                    @if (fotosEditaveis.Any())
                    {
                        <div class="fotos-lista">
                            @for (int i = 0; i < fotosEditaveis.Count; i++)
                            {
                                var foto = fotosEditaveis[i];
                                var idx = i;
                                <div class="foto-item">
                                    <img src="@foto.Url" class="foto-thumb" />
                                    <div class="foto-acoes">
                                        <button type="button" class="btn-ordem" @onclick="() => MoverFotoParaCima(idx)" disabled="@(idx == 0)">▲</button>
                                        <button type="button" class="btn-ordem" @onclick="() => MoverFotoParaBaixo(idx)" disabled="@(idx == fotosEditaveis.Count - 1)">▼</button>
                                        <button type="button" class="btn-remover-foto" @onclick="() => RemoverFoto(idx)">🗑️</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="sem-fotos-msg">Nenhuma foto cadastrada.</div>
                    }

                    <div class="upload-area">
                        <label class="upload-label">
                            <InputFile OnChange="OnArquivoSelecionado" multiple accept="image/jpeg,image/png" />
                            <span class="upload-icone">📸</span> Selecionar novas fotos
                        </label>
                        @if (arquivosSelecionados.Any())
                        {
                            <div class="preview-novas">
                                @foreach (var preview in previewsNovasFotos)
                                {
                                    <img src="@preview" class="preview-thumb" />
                                }
                                <button class="btn-upload" @onclick="UploadNovasFotos" disabled="@uploading">
                                    @(uploading ? "Enviando..." : $"Enviar {arquivosSelecionados.Count} foto(s)")
                                </button>
                                <button class="btn-cancelar-upload" @onclick="CancelarUpload">Cancelar</button>
                            </div>
                        }
                        @if (erroUpload != null)
                        {
                            <div class="erro-upload">@erroUpload</div>
                        }
                    </div>
                </div>

                @if (erroEdicao is not null)
                {
                    <div class="erro-banner">@erroEdicao</div>
                }

                <div class="modal-acoes">
                    <button class="btn-cancelar"
                            @onclick="() => modalFormEdicaoVisivel = false">
                        Cancelar
                    </button>
                    <button class="btn-confirmar"
                            @onclick="SalvarEdicao"
                            disabled="@salvando">
                        @(salvando ? "Salvando..." : "Salvar alterações")
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    // Só um dos dois é populado por vez — veiculo para estoque próprio,
    // consignacao para veículo consignado. A rota é a mesma para os dois
    // (não existe mais tela de detalhe separada para consignados).
    private void AplicarTemplateTermoEdicao(string texto) => formEdicao.TextoTermoPreliminar = texto;
    private void AplicarTemplateContratoEdicao(string texto) => formEdicaoConsignacao.TextoContrato = texto;

    private VeiculoVendaDTO? veiculo;
    private VeiculoConsignacaoDTO? consignacao;
    private bool carregando = true;
    private int fotoAtiva = 0;

    private bool IsConsignado => consignacao is not null;
    private bool Encontrado => veiculo is not null || consignacao is not null;
    private string EntidadeTipoAtual => IsConsignado ? "VeiculoConsignacao" : "VeiculoVenda";

    // === Campos unificados — leem de qualquer um dos dois DTOs carregados ===
    private string Marca => veiculo?.Marca ?? consignacao?.Marca ?? "";
    private string Modelo => veiculo?.Modelo ?? consignacao?.Modelo ?? "";
    private string Cor => veiculo?.Cor ?? consignacao?.Cor ?? "";
    private int Ano => veiculo?.Ano ?? consignacao?.Ano ?? 0;
    private int Quilometragem => veiculo?.Quilometragem ?? consignacao?.Quilometragem ?? 0;
