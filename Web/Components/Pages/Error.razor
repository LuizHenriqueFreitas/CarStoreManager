@page "/Error"

@namespace CarStoreManager.Web.Components.Pages

<PageTitle>Ops, algo deu errado</PageTitle>

<div class="erro-pagina">
    <h1>Ops, algo deu errado</h1>
    <p>
        Não foi possível concluir essa ação. O problema já foi registrado —
        tente novamente em instantes ou volte para o início.
    </p>
    <a href="/">Voltar ao início</a>
</div>

<style>
    .erro-pagina {
        max-width: 500px;
        margin: 80px auto;
        text-align: center;
        padding: 24px;
    }

    .erro-pagina h1 {
        font-size: 22px;
        font-weight: 500;
        margin-bottom: 8px;
        color: #1a1a1a;
    }

    .erro-pagina p {
        font-size: 14px;
        color: #888;
        margin-bottom: 20px;
        line-height: 1.5;
    }

    .erro-pagina a {
        display: inline-block;
        background: #e02020;
        color: #fff;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 14px;
        text-decoration: none;
    }
</style>
