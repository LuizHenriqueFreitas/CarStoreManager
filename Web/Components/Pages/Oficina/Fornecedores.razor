@page "/oficina/fornecedores"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "pagina:/oficina/fornecedores")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "modulo:oficina")]

@namespace CarStoreManager.Web.Components.Pages

@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@inject IFornecedorService FornecedorService
@inject AuthenticationStateProvider AuthState
@inject CarStoreManager.Application.Interfaces.Sistema.IPermissaoAcessoService PermissaoService
@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.DTOs.Oficina.Fornecedor
@using CarStoreManager.Application.DTOs.Shared.Cliente
@using CarStoreManager.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web

<div class="pagina">
    <PageHeader Titulo="Fornecedores" Subtitulo="@($"{todosFornecedores.Count} fornecedor(es) · {todosFornecedores.Count(f => f.Ativo)} ativo(s)")">
        <Acao>
            @if (podeNovoFornecedor)
            {
                <button type="button" class="btn btn-primario" data-tour="forn-btn-novo" @onclick="AbrirModalNovo">+ Novo fornecedor</button>
            }
        </Acao>
    </PageHeader>

    <SubNav Itens="subNavItens" />

    <FiltroBar @bind-Busca="termoBusca" BuscaPlaceholder="Buscar por nome ou CNPJ..." OnBusca="AplicarFiltro">
        <FiltroSelect Rotulo="Situação" @bind-Valor="filtroStatus" OnMudou="AplicarFiltro" Opcoes="opcoesStatus" />
    </FiltroBar>

    @if (carregando)
    {
        <div class="loading">Carregando fornecedores...</div>
    }
    else if (!fornecedoresFiltrados.Any())
    {
        <EstadoVazio Mensagem="Nenhum fornecedor com esses filtros." Icone="🏭" />
    }
    else
    {
        <div class="table-scroll">
            <table class="tab">
                <thead>
                    <tr>
                        <ColunaOrdenavel Coluna="nome" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Nome</ColunaOrdenavel>
                        <ColunaOrdenavel Coluna="cnpj" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">CNPJ</ColunaOrdenavel>
                        <th>Contato</th>
                        <ColunaOrdenavel Coluna="status" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Status</ColunaOrdenavel>
                        @if (ehAdmin)
                        {
                            <th>Ações</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in fornecedoresFiltrados)
                    {
                        <tr class="@(f.Ativo ? "" : "inativo")">
                            <td class="forte">@f.Nome</td>
                            <td class="mono">@f.Cnpj</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(f.Telefone)) { @FormatarTelefone(f.Telefone) }
                                @if (!string.IsNullOrWhiteSpace(f.Telefone) && !string.IsNullOrWhiteSpace(f.Email)) { <text> · </text> }
                                @if (!string.IsNullOrWhiteSpace(f.Email)) { @f.Email }
                            </td>
                            <td><span class="forn-status @(f.Ativo ? "ativo-badge" : "inativo-badge")">@(f.Ativo ? "Ativo" : "Inativo")</span></td>
                            @if (ehAdmin)
                            {
                                <td>
                                    <div class="forn-acoes">
                                        <button type="button" class="btn-mini" @onclick="() => AbrirModalEditar(f)">Editar contato</button>
                                        <button type="button" class="btn-mini" @onclick="() => AlternarAtivo(f)">@(f.Ativo ? "Desativar" : "Ativar")</button>
                                        <button type="button" class="btn-mini btn-remover" @onclick="() => ConfirmarExcluir(f.Id, f.Nome)">Excluir</button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (modalNovoVisivel)
{
    <div class="modal-overlay" @onclick="() => modalNovoVisivel = false">
        <div class="modal-form" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-titulo">Novo fornecedor</span>
                <button type="button" class="modal-fechar" @onclick="() => modalNovoVisivel = false">×</button>
            </div>

            <div class="form-grid">
                <div class="form-campo span-2">
                    <label class="campo-label">Nome / razão social *</label>
                    <input class="campo-input" @bind="novoFornecedor.Nome" placeholder="Nome do fornecedor" />
                </div>
                <div class="form-campo span-2">
                    <label class="campo-label">CNPJ *</label>
                    <input class="campo-input" @bind="novoFornecedor.Cnpj" placeholder="00.000.000/0000-00" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">E-mail</label>
                    <input type="email" class="campo-input" @bind="novoFornecedor.Email" placeholder="contato@fornecedor.com" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Telefone</label>
                    <input class="campo-input" @bind="novoFornecedor.Telefone" placeholder="(11) 90000-0000" />
                </div>
            </div>

            <h3 class="subsecao-titulo">Endereço (opcional)</h3>
            @if (novoFornecedor.Endereco is not null)
            {
                <div class="form-grid">
                    <div class="form-campo">
                        <label class="campo-label">CEP</label>
                        <input class="campo-input" @bind="novoFornecedor.Endereco.Cep" placeholder="00000-000" />
                    </div>
                    <div class="form-campo">
                        <label class="campo-label">UF</label>
                        <input class="campo-input" @bind="novoFornecedor.Endereco.Uf" placeholder="SP" maxlength="2" />
                    </div>
                    <div class="form-campo span-2">
                        <label class="campo-label">Logradouro</label>
                        <input class="campo-input" @bind="novoFornecedor.Endereco.Logradouro" placeholder="Rua, Avenida, etc." />
                    </div>
                    <div class="form-campo">
                        <label class="campo-label">Número</label>
                        <input class="campo-input" @bind="novoFornecedor.Endereco.Numero" placeholder="123" />
                    </div>
                    <div class="form-campo">
                        <label class="campo-label">Complemento</label>
                        <input class="campo-input" @bind="novoFornecedor.Endereco.Complemento" placeholder="Sala, bloco..." />
                    </div>
                    <div class="form-campo">
                        <label class="campo-label">Bairro</label>
                        <input class="campo-input" @bind="novoFornecedor.Endereco.Bairro" placeholder="Bairro" />
                    </div>
                    <div class="form-campo">
                        <label class="campo-label">Cidade</label>
                        <input class="campo-input" @bind="novoFornecedor.Endereco.Cidade" placeholder="Cidade" />
                    </div>
                </div>
            }

            @if (erroNovo is not null)
            {
                <div class="erro-banner">@erroNovo</div>
            }

            <div class="modal-acoes">
                <button type="button" class="btn-cancelar" @onclick="() => modalNovoVisivel = false">Cancelar</button>
                <button type="button" class="btn-confirmar" @onclick="CriarFornecedor" disabled="@salvandoNovo">
                    @(salvandoNovo ? "Criando..." : "Criar fornecedor")
                </button>
            </div>
        </div>
    </div>
}

@if (modalEditarVisivel && fornecedorEditando is not null)
{
    <div class="modal-overlay" @onclick="() => modalEditarVisivel = false">
        <div class="modal-form" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-titulo">Editar contato — @fornecedorEditando.Nome</span>
                <button type="button" class="modal-fechar" @onclick="() => modalEditarVisivel = false">×</button>
            </div>

            <p class="muted">CNPJ @fornecedorEditando.Cnpj</p>

            <div class="form-grid">
                <div class="form-campo">
                    <label class="campo-label">E-mail</label>
                    <input type="email" class="campo-input" @bind="fornecedorEditando.Email" placeholder="contato@fornecedor.com" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Telefone</label>
                    <input class="campo-input" @bind="fornecedorEditando.Telefone" placeholder="(11) 90000-0000" />
                </div>
            </div>

            <h3 class="subsecao-titulo">Endereço</h3>
            <div class="form-grid">
                <div class="form-campo">
                    <label class="campo-label">CEP</label>
                    <input class="campo-input" @bind="fornecedorEditando.Endereco!.Cep" placeholder="00000-000" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">UF</label>
                    <input class="campo-input" @bind="fornecedorEditando.Endereco!.Uf" placeholder="SP" maxlength="2" />
                </div>
                <div class="form-campo span-2">
                    <label class="campo-label">Logradouro</label>
                    <input class="campo-input" @bind="fornecedorEditando.Endereco!.Logradouro" placeholder="Rua, Avenida, etc." />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Número</label>
                    <input class="campo-input" @bind="fornecedorEditando.Endereco!.Numero" placeholder="123" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Complemento</label>
                    <input class="campo-input" @bind="fornecedorEditando.Endereco!.Complemento" placeholder="Sala, bloco..." />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Bairro</label>
                    <input class="campo-input" @bind="fornecedorEditando.Endereco!.Bairro" placeholder="Bairro" />
                </div>
                <div class="form-campo">
                    <label class="campo-label">Cidade</label>
                    <input class="campo-input" @bind="fornecedorEditando.Endereco!.Cidade" placeholder="Cidade" />
                </div>
            </div>

            @if (erroEdicao is not null)
            {
                <div class="erro-banner">@erroEdicao</div>
            }

            <div class="modal-acoes">
                <button type="button" class="btn-cancelar" @onclick="() => modalEditarVisivel = false">Cancelar</button>
                <button type="button" class="btn-confirmar" @onclick="SalvarEdicao" disabled="@salvandoEdicao">
                    @(salvandoEdicao ? "Salvando..." : "Salvar contato")
                </button>
            </div>
        </div>
    </div>
}

@if (modalExcluirVisivel)
{
    <div class="modal-overlay" @onclick="() => modalExcluirVisivel = false">
        <div class="modal-form modal-confirmacao" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-titulo">Excluir fornecedor</span>
                <button type="button" class="modal-fechar" @onclick="() => modalExcluirVisivel = false">×</button>
            </div>
            <p>Excluir <strong>@nomeParaExcluir</strong>? Essa ação não pode ser desfeita.</p>

            @if (erroExclusao is not null)
            {
                <div class="erro-banner">@erroExclusao</div>
            }

            <div class="modal-acoes">
                <button type="button" class="btn-cancelar" @onclick="() => modalExcluirVisivel = false">Cancelar</button>
                <button type="button" class="btn-confirmar btn-perigo" @onclick="ExecutarExclusao" disabled="@excluindo">
                    @(excluindo ? "Excluindo..." : "Excluir")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<FornecedorListaDTO> todosFornecedores = new();
    private List<FornecedorListaDTO> fornecedoresFiltrados = new();
    private string termoBusca = string.Empty;
    private string filtroStatus = "Todos";
    private static readonly List<FiltroSelect.Opcao> opcoesStatus = new()
    {
        new("Todos", "Todos"), new("Ativos", "Ativos"), new("Inativos", "Inativos"),
    };

    // Ordenação da tabela — clique na coluna ordena crescente; clique de
    // novo na mesma coluna inverte pra decrescente (ver ColunaOrdenavel).
    private string sortColuna = "nome";
    private bool sortAscendente = true;
    private bool carregando = true;
    private bool ehAdmin;
    private bool podeNovoFornecedor;
    private List<SubNav.Item> subNavItens = new();

    private bool modalNovoVisivel;
    private bool salvandoNovo;
    private string? erroNovo;
    private CriarFornecedorDTO novoFornecedor = NovoFormPadrao();

    private bool modalEditarVisivel;
    private bool salvandoEdicao;
    private string? erroEdicao;
    private FornecedorDTO? fornecedorEditando;

    private bool modalExcluirVisivel;
    private bool excluindo;
    private string? erroExclusao;
    private Guid idParaExcluir;
    private string nomeParaExcluir = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        ehAdmin = state.User.IsInRole("Admin");

        var roleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        var usuarioIdClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (Enum.TryParse<CarStoreManager.Domain.Enums.RoleUsuario>(roleClaim, out var role) && Guid.TryParse(usuarioIdClaim, out var usuarioId))
        {
            subNavItens = await SubNavOficina.ItensAsync(false, usuarioId, role, PermissaoService);
            podeNovoFornecedor = await PermissaoService.PodeAcessarAsync(usuarioId, role, "acao:oficina.novo-fornecedor");
        }

        await CarregarFornecedores();
    }

    private async Task CarregarFornecedores()
    {
        carregando = true;

        var r = await FornecedorService.GetAllAsync();
        todosFornecedores = r.IsSuccess ? r.Value?.ToList() ?? new() : new();

        AplicarFiltro();
        carregando = false;
    }

    private void AplicarFiltro()
    {
        var baseLista = filtroStatus switch
        {
            "Ativos" => todosFornecedores.Where(f => f.Ativo),
            "Inativos" => todosFornecedores.Where(f => !f.Ativo),
            _ => todosFornecedores.AsEnumerable()
        };

        if (!string.IsNullOrWhiteSpace(termoBusca))
        {
            var termo = termoBusca.Trim();
            baseLista = baseLista.Where(f =>
                f.Nome.Contains(termo, StringComparison.OrdinalIgnoreCase)
                || f.Cnpj.Contains(termo, StringComparison.OrdinalIgnoreCase));
        }

        fornecedoresFiltrados = baseLista.ToList();
        OrdenarFornecedores();
    }

    private void Ordenar(string coluna)
    {
        if (sortColuna == coluna) sortAscendente = !sortAscendente;
        else { sortColuna = coluna; sortAscendente = true; }
        OrdenarFornecedores();
    }

    private void OrdenarFornecedores()
    {
        fornecedoresFiltrados = sortColuna switch
        {
            "cnpj" => Ordenacao.Por(fornecedoresFiltrados, f => f.Cnpj, sortAscendente),
            "status" => Ordenacao.Por(fornecedoresFiltrados, f => f.Ativo, sortAscendente),
            _ => Ordenacao.Por(fornecedoresFiltrados, f => f.Nome, sortAscendente),
        };
    }

    private void AbrirModalNovo()
    {
        novoFornecedor = NovoFormPadrao();
        erroNovo = null;
        modalNovoVisivel = true;
    }

    private async Task CriarFornecedor()
    {
        if (string.IsNullOrWhiteSpace(novoFornecedor.Nome) || string.IsNullOrWhiteSpace(novoFornecedor.Cnpj))
        {
            erroNovo = "Nome e CNPJ são obrigatórios.";
            return;
        }

        salvandoNovo = true;
        erroNovo = null;

        try
        {
            var resultado = await FornecedorService.AddAsync(novoFornecedor);
            if (resultado.IsSuccess)
            {
                modalNovoVisivel = false;
                await CarregarFornecedores();
            }
            else
            {
                erroNovo = resultado.Error;
            }
        }
        catch (Exception ex)
        {
            erroNovo = $"Erro ao criar fornecedor: {ex.Message}";
        }
        finally { salvandoNovo = false; }
    }

    private async Task AbrirModalEditar(FornecedorListaDTO item)
    {
        var r = await FornecedorService.GetByIdAsync(item.Id);
        if (!r.IsSuccess || r.Value is null) return;

        fornecedorEditando = r.Value;
        fornecedorEditando.Endereco ??= new EnderecoDTO();
        erroEdicao = null;
        modalEditarVisivel = true;
    }

    private async Task SalvarEdicao()
    {
        if (fornecedorEditando is null) return;

        salvandoEdicao = true;
        erroEdicao = null;

        try
        {
            var dto = new AtualizarFornecedorDTO
            {
                Id = fornecedorEditando.Id,
                Email = fornecedorEditando.Email,
                Telefone = fornecedorEditando.Telefone,
                Endereco = fornecedorEditando.Endereco
            };

            var resultado = await FornecedorService.UpdateAsync(dto);
            if (resultado.IsSuccess)
            {
                modalEditarVisivel = false;
                await CarregarFornecedores();
            }
            else
            {
                erroEdicao = resultado.Error;
            }
        }
        catch (Exception ex)
        {
            erroEdicao = $"Erro ao salvar contato: {ex.Message}";
        }
        finally { salvandoEdicao = false; }
    }

    private async Task AlternarAtivo(FornecedorListaDTO item)
    {
        var resultado = item.Ativo
            ? await FornecedorService.DesativarAsync(item.Id)
            : await FornecedorService.AtivarAsync(item.Id);

        if (resultado.IsSuccess)
            await CarregarFornecedores();
    }

    private void ConfirmarExcluir(Guid id, string nome)
    {
        idParaExcluir = id;
        nomeParaExcluir = nome;
        erroExclusao = null;
        modalExcluirVisivel = true;
    }

    private async Task ExecutarExclusao()
    {
        excluindo = true;
        erroExclusao = null;

        var resultado = await FornecedorService.RemoveAsync(idParaExcluir);
        if (resultado.IsSuccess)
        {
            modalExcluirVisivel = false;
            await CarregarFornecedores();
        }
        else
        {
            erroExclusao = resultado.Error;
        }

        excluindo = false;
    }

    private static string FormatarTelefone(string tel)
    {
        var digitos = new string(tel.Where(char.IsDigit).ToArray());
        if (digitos.Length == 11)
            return $"({digitos[..2]}) {digitos[2..7]}-{digitos[7..]}";
        if (digitos.Length == 10)
            return $"({digitos[..2]}) {digitos[2..6]}-{digitos[6..]}";
        return tel;
    }

    private static CriarFornecedorDTO NovoFormPadrao() => new()
    {
        Endereco = new EnderecoDTO()
    };
}

<style>
    /* Tabela — mesmo padrão de tabela HTML usado em Recepção/Ordens de
       serviço/Estoque e em Propostas/Test drives/Consignações da
       Concessionária: cabeçalho clicável (ColunaOrdenavel) declara as
       colunas, o navegador garante o alinhamento com as linhas. Zebra pra
       facilitar a leitura. */
    .table-scroll { overflow-x: auto; }
    .tab { width: 100%; border-collapse: collapse; background: var(--cor-superficie); border: 1px solid var(--cor-linha); border-radius: var(--raio-lg); overflow: hidden; }
    .tab th, .tab td { padding: 11px 14px; text-align: left; border-bottom: 1px solid var(--cor-linha-suave); font-size: var(--txt-sm); }
    .tab th { background: var(--cor-fundo); font-size: var(--txt-xs); text-transform: uppercase; letter-spacing: .3px; color: var(--cor-tinta-3); }
    .tab tbody tr:nth-child(even) { background: var(--cor-zebra); }
    .tab tbody tr:hover { background: var(--cor-info-bg); }
    .tab tbody tr.inativo { opacity: 0.6; }
    .forte { font-weight: var(--peso-medio); }
    .mono { font-family: monospace; }

    .forn-status {
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 500;
        flex-shrink: 0;
    }

    .ativo-badge   { background: #f0fdf4; color: #16a34a; }
    .inativo-badge { background: #f5f5f5; color: #888; }

    .forn-acoes {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .btn-mini {
        background: none;
        border: 0.5px solid #e0e0e0;
        border-radius: 6px;
        padding: 5px 10px;
        font-size: 12px;
        color: #555;
        cursor: pointer;
        white-space: nowrap;
    }

    .btn-mini:hover { border-color: #1a1a1a; color: #1a1a1a; }
    .btn-mini.btn-remover:hover { border-color: #e02020; color: #e02020; }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-form {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        width: 100%;
        max-width: 580px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-confirmacao { max-width: 420px; }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .modal-titulo { font-size: 16px; font-weight: 500; }

    .modal-fechar {
        background: none;
        border: none;
        font-size: 20px;
        color: #888;
        cursor: pointer;
    }

    .muted { font-size: 12px; color: #888; margin: -12px 0 16px; }

    .subsecao-titulo { font-size: 13px; font-weight: 500; margin: 4px 0 10px; color: #555; }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
    }

    .form-campo { display: flex; flex-direction: column; gap: 6px; }
    .span-2 { grid-column: span 2; }

    .campo-label { font-size: 12px; color: #555; font-weight: 500; }

    .campo-input {
        border: 0.5px solid #ccc;
        border-radius: 8px;
        padding: 9px 12px;
        font-size: 14px;
        outline: none;
        width: 100%;
    }

    .campo-input:focus { border-color: #e02020; }

    .erro-banner {
        background: #fff5f5;
        border: 0.5px solid #fca5a5;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        color: #e02020;
        margin-bottom: 12px;
    }

    .modal-acoes {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 16px;
    }

    .btn-cancelar {
        background: #fff;
        border: 0.5px solid #ccc;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 13px;
        cursor: pointer;
    }

    .btn-confirmar {
        background: #1a1a1a;
        border: none;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 13px;
        font-weight: 500;
        color: #fff;
