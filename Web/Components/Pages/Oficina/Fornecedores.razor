    .forn-detalhe { font-size: 12px; color: #888; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .forn-status {
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 500;
        flex-shrink: 0;
    }

    .ativo-badge   { background: #f0fdf4; color: #16a34a; }
    .inativo-badge { background: #f5f5f5; color: #888; }

    .forn-acoes {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .btn-mini {
        background: none;
        border: 0.5px solid #e0e0e0;
        border-radius: 6px;
        padding: 5px 10px;
        font-size: 12px;
        color: #555;
        cursor: pointer;
        white-space: nowrap;
    }

