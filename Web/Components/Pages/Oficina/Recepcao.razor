@page "/oficina/recepcao"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,ChefeOficina,Recepcionista")]

@namespace CarStoreManager.Web.Components.Pages

@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@inject IOrdemServicoService OrdemService
@inject IClienteService ClienteService
@inject IMecanicoService MecanicoService
@inject IVeiculoClienteService VeiculoClienteService
@inject NavigationManager Nav
@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.DTOs.Oficina.OrdemServico
@using CarStoreManager.Application.DTOs.Oficina.Mecanico
@using CarStoreManager.Application.DTOs.Oficina.VeiculoCliente
@using CarStoreManager.Application.DTOs.Shared.Cliente
@using CarStoreManager.Web.Components.Shared

<div class="pagina">
    <PageHeader Titulo="Recepção" Subtitulo="Atendimento, abertura de OS, cobrança e entrega">
        <Acao>
            <button class="btn btn-primario" data-tour="recepcao-btn-nova" @onclick='() => Nav.NavigateTo("/oficina/os/nova")'>
                + Nova ordem de serviço
            </button>
        </Acao>
    </PageHeader>

    <SubNav Itens="SubNavOficina.Itens(false)" />

    <div class="recepcao-topo">
        <div class="busca-rapida">
            <label>Buscar OS</label>
            <input type="text" placeholder="Nº da OS, cliente ou placa..." @bind="buscaOs" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(buscaOs) && ResultadosBusca.Any())
            {
                <div class="busca-drop">
                    @foreach (var os in ResultadosBusca)
                    {
                        <a class="busca-item" href="@($"/oficina/os/{os.Id}")">
                            <span class="bi-num">@os.NumeroPublico</span>
                            <span class="bi-cli">@NomeCliente(os.ClienteId)</span>
                            <span class="bi-status">@os.Status</span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <div data-tour="recepcao-metricas">
        <StatCardGrid MinColuna="150">
            <MetricCard Rotulo="Aguardando cobrança" Valor="@prontasParaCobrar.Count.ToString()" Tom="@(prontasParaCobrar.Count > 0 ? "atencao" : "")" />
            <MetricCard Rotulo="Pendentes" Valor="@pendentes.ToString()" />
            <MetricCard Rotulo="Em andamento" Valor="@emAndamento.ToString()" Tom="info" />
            <MetricCard Rotulo="Atrasadas" Valor="@osAbertas.Count(EhAtrasada).ToString()" Tom="@(osAbertas.Count(EhAtrasada) > 0 ? "erro" : "")" />
            <MetricCard Rotulo="Mecânicos disponíveis" Valor="@($"{mecanicosDisponiveis}/{mapaMecanicos.Count}")" Tom="@(mecanicosDisponiveis == 0 ? "erro" : "ok")" />
            <MetricCard Rotulo="Entregues (mês)" Valor="@entreguesMes.ToString()" Tom="ok" Sub="@FormatoData.MesAno(DateTime.Today)" />
        </StatCardGrid>
    </div>

    <div class="secao" data-tour="recepcao-ocupacao">
        <div class="secao-header">
            <h2 class="secao-titulo">🔧 Ocupação da oficina</h2>
            <span class="muted">Quem está livre agora pra receber um carro novo</span>
        </div>
        <div class="mecanicos-grid">
            @foreach (var mec in mecanicosOrdenados)
            {
                <div class="mec-chip">
                    <div class="mec-info">
                        <strong>@mec.Nome</strong>
                        <span class="muted">@mec.Especialidade</span>
                    </div>
                    <StatusBadge Status="@mec.Ocupado" Familia="mecanico" />
                </div>
            }
        </div>
    </div>

    @if (prontasParaCobrar.Any())
    {
        <div class="secao" data-tour="recepcao-cobranca">
            <div class="secao-header">
                <h2 class="secao-titulo">🔔 Prontas para cobrança e entrega</h2>
                <span class="muted">Mecânico concluiu o serviço — receba o pagamento e marque como entregue</span>
            </div>
            <div class="table-scroll">
                <table class="tab">
                    <thead>
                        <tr>
                            <ColunaOrdenavel Coluna="numero" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Número</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="cliente" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Cliente</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="veiculo" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Veículo</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="mecanico" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Mecânico</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="valor" Class="r" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Total a cobrar</ColunaOrdenavel>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var os in prontasParaCobrar)
                        {
                            <tr class="linha" @onclick="() => AbrirOs(os.Id)">
                                <td class="num">@os.NumeroPublico</td>
                                <td>@NomeCliente(os.ClienteId)</td>
                                <td>@DescricaoVeiculo(os.VeiculoClienteId)</td>
                                <td>@NomeMecanico(os.MecanicoId)</td>
                                <td class="r valor">@os.ValorTotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="secao" data-tour="recepcao-abertas">
        <div class="secao-header">
            <h2 class="secao-titulo">Ordens de serviço abertas</h2>
            <a class="link-link" href="/oficina/ordens">Ver e filtrar todas →</a>
        </div>
        @if (!osAbertas.Any())
        {
            <EstadoVazio Mensagem="Nenhuma ordem de serviço aberta no momento." Icone="🔧" />
        }
        else
        {
            <div class="table-scroll">
                <table class="tab">
                    <thead>
                        <tr>
                            <ColunaOrdenavel Coluna="numero" ColunaAtiva="@sortColunaAbertas" Ascendente="@sortAscendenteAbertas" OnOrdenar="OrdenarAbertas">Número</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="cliente" ColunaAtiva="@sortColunaAbertas" Ascendente="@sortAscendenteAbertas" OnOrdenar="OrdenarAbertas">Cliente</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="veiculo" ColunaAtiva="@sortColunaAbertas" Ascendente="@sortAscendenteAbertas" OnOrdenar="OrdenarAbertas">Veículo</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="mecanico" ColunaAtiva="@sortColunaAbertas" Ascendente="@sortAscendenteAbertas" OnOrdenar="OrdenarAbertas">Mecânico</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="prazo" ColunaAtiva="@sortColunaAbertas" Ascendente="@sortAscendenteAbertas" OnOrdenar="OrdenarAbertas">Prazo</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="status" ColunaAtiva="@sortColunaAbertas" Ascendente="@sortAscendenteAbertas" OnOrdenar="OrdenarAbertas">Etapa</ColunaOrdenavel>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var os in osAbertas)
                        {
                            <tr class="linha" @onclick="() => AbrirOs(os.Id)">
                                <td class="num">@os.NumeroPublico</td>
                                <td>@NomeCliente(os.ClienteId)</td>
                                <td>@DescricaoVeiculo(os.VeiculoClienteId)</td>
                                <td>@NomeMecanico(os.MecanicoId)</td>
                                <td class="@(EhAtrasada(os) ? "vencido" : "")">@os.PrazoEstimado.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (EhAtrasada(os))
                                    {
                                        <span class="tag-atraso">Atrasada</span>
                                    }
                                    <StatusBadge Status="@os.Status" Familia="os" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<OrdemServicoListaDTO> todas = new();
    private List<OrdemServicoListaDTO> osAbertas = new();
    private List<OrdemServicoListaDTO> prontasParaCobrar = new();
    private Dictionary<Guid, ClienteListaDTO> mapaClientes = new();
    private Dictionary<Guid, MecanicoListaDTO> mapaMecanicos = new();
    private Dictionary<Guid, VeiculoClienteListaDTO> mapaVeiculos = new();
    private List<MecanicoListaDTO> mecanicosOrdenados = new();
    private int mecanicosDisponiveis;
    private int pendentes;
    private int emAndamento;
    private int entreguesMes;
    private bool carregando = true;
    private string buscaOs = "";

    // Etapas que ainda não chegaram em "aguardando cobrança"/entregue/cancelada
    // — mesma lista usada em OrdensServico.razor pra decidir o que conta como
    // "aberta" e o que conta como "atrasada" (prazo já vencido, ainda aberta).
    private static readonly string[] StatusAbertos =
        { "Pendente", "EmAnalise", "AguardandoCliente", "BuscandoPecasParaOrcamento", "Aprovada", "EmAndamento", "Pausada" };

    private bool EhAtrasada(OrdemServicoListaDTO o) =>
        StatusAbertos.Contains(o.Status) && o.PrazoEstimado.Date < DateTime.Today;

    // Ordenação da tabela "Prontas para cobrança" — clique na coluna ordena
    // crescente; clique de novo na mesma coluna inverte pra decrescente.
    private string sortColuna = "prazo";
    private bool sortAscendente = true;

    // Mesmo padrão pra tabela "Ordens de serviço abertas", ordenação própria.
    private string sortColunaAbertas = "prazo";
    private bool sortAscendenteAbertas = true;

    private void Ordenar(string coluna)
    {
        if (sortColuna == coluna) sortAscendente = !sortAscendente;
        else { sortColuna = coluna; sortAscendente = true; }
        OrdenarProntas();
    }

    private void OrdenarAbertas(string coluna)
    {
        if (sortColunaAbertas == coluna) sortAscendenteAbertas = !sortAscendenteAbertas;
        else { sortColunaAbertas = coluna; sortAscendenteAbertas = true; }
        OrdenarAbertasLista();
    }

    private void AbrirOs(Guid id) => Nav.NavigateTo($"/oficina/os/{id}");

    private void OrdenarProntas()
    {
        prontasParaCobrar = sortColuna switch
        {
            "numero" => Ordenacao.Por(prontasParaCobrar, o => o.NumeroPublico, sortAscendente),
            "cliente" => Ordenacao.Por(prontasParaCobrar, o => NomeCliente(o.ClienteId), sortAscendente),
            "veiculo" => Ordenacao.Por(prontasParaCobrar, o => DescricaoVeiculo(o.VeiculoClienteId), sortAscendente),
            "mecanico" => Ordenacao.Por(prontasParaCobrar, o => NomeMecanico(o.MecanicoId), sortAscendente),
            "valor" => Ordenacao.Por(prontasParaCobrar, o => o.ValorTotal, sortAscendente),
            _ => Ordenacao.Por(prontasParaCobrar, o => o.PrazoEstimado, sortAscendente),
        };
    }

    private void OrdenarAbertasLista()
    {
        osAbertas = sortColunaAbertas switch
        {
            "numero" => Ordenacao.Por(osAbertas, o => o.NumeroPublico, sortAscendenteAbertas),
            "cliente" => Ordenacao.Por(osAbertas, o => NomeCliente(o.ClienteId), sortAscendenteAbertas),
            "veiculo" => Ordenacao.Por(osAbertas, o => DescricaoVeiculo(o.VeiculoClienteId), sortAscendenteAbertas),
            "mecanico" => Ordenacao.Por(osAbertas, o => NomeMecanico(o.MecanicoId), sortAscendenteAbertas),
            "status" => Ordenacao.Por(osAbertas, o => o.Status, sortAscendenteAbertas),
            _ => Ordenacao.Por(osAbertas, o => o.PrazoEstimado, sortAscendenteAbertas),
        };
    }

    private IEnumerable<OrdemServicoListaDTO> ResultadosBusca
    {
        get
        {
            var t = buscaOs.Trim();
            if (t.Length < 2) return Enumerable.Empty<OrdemServicoListaDTO>();
            return todas.Where(o =>
                o.NumeroPublico.Contains(t, StringComparison.OrdinalIgnoreCase)
                || NomeCliente(o.ClienteId).Contains(t, StringComparison.OrdinalIgnoreCase)
                || PlacaVeic(o.VeiculoClienteId).Contains(t, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(o => o.DataCriacao).Take(6);
        }
    }

    private string PlacaVeic(Guid id) => mapaVeiculos.TryGetValue(id, out var v) ? v.Placa : "";

    protected override async Task OnInitializedAsync()
    {
        var tarefaOrdens = OrdemService.GetAllAsync();
        var tarefaClientes = ClienteService.GetAllAsync();
        var tarefaMecanicos = MecanicoService.GetAllAsync();
        var tarefaVeiculos = VeiculoClienteService.GetAllAsync();

        await Task.WhenAll(tarefaOrdens, tarefaClientes, tarefaMecanicos, tarefaVeiculos);

        var resultado = tarefaOrdens.Result;
        todas = resultado.IsSuccess ? resultado.Value?.ToList() ?? new() : new();

        var rc = tarefaClientes.Result;
        if (rc.IsSuccess && rc.Value is not null)
            mapaClientes = rc.Value.ToDictionary(c => c.Id);

        var rm = tarefaMecanicos.Result;
        if (rm.IsSuccess && rm.Value is not null)
            mapaMecanicos = rm.Value.ToDictionary(m => m.Id);

        var rv = tarefaVeiculos.Result;
        if (rv.IsSuccess && rv.Value is not null)
            mapaVeiculos = rv.Value.ToDictionary(v => v.Id);

        pendentes = todas.Count(o => o.Status == "Pendente");
        emAndamento = todas.Count(o => o.Status == "EmAndamento");

        var inicioMes = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        entreguesMes = todas.Count(o => o.Status == "Entregue"
            && o.PrazoEstimado >= inicioMes);

        // PagamentoPendente = mecânico concluiu, falta cobrança pela recepção.
        // "Finalizada" agora só significa trabalho pronto E já pago (ver
        // OrdemServico.ConfirmarPagamentoCompleto) — não entra mais aqui.
        prontasParaCobrar = todas
            .Where(o => o.Status == "PagamentoPendente")
            .ToList();
        OrdenarProntas();

        // Todas as OS ainda em curso, exceto as já destacadas acima em
        // "Prontas para cobrança" — é essa lista que dá pra recepção a visão
        // do que está rolando na oficina agora (interface entre cliente e
        // mecânico), sem precisar ir pra tela cheia de Ordens de Serviço.
        osAbertas = todas
            .Where(o => StatusAbertos.Contains(o.Status))
            .ToList();
        OrdenarAbertasLista();

        mecanicosOrdenados = mapaMecanicos.Values
            .OrderBy(m => m.Ocupado == "Disponivel" ? 0 : m.Ocupado == "Ocupado" ? 1 : 2)
            .ThenBy(m => m.Nome)
            .ToList();
        mecanicosDisponiveis = mapaMecanicos.Values.Count(m => m.Ocupado == "Disponivel");

        carregando = false;
    }

    private string NomeCliente(Guid id)
        => mapaClientes.TryGetValue(id, out var c) ? c.Nome : "Cliente não encontrado";

    private string DescricaoVeiculo(Guid id)
        => mapaVeiculos.TryGetValue(id, out var v) ? $"{v.Marca} {v.Modelo}" : "Veículo não encontrado";

    private string NomeMecanico(Guid id)
    {
        if (id == Guid.Empty) return "Não atribuído";
        return mapaMecanicos.TryGetValue(id, out var m) ? m.Nome : "Mecânico não encontrado";
    }

    private string EspecialidadeDoMecanico(Guid id)
        => mapaMecanicos.TryGetValue(id, out var m) ? m.Especialidade : "";
}

<style>
    /* Busca de OS centralizada vertical e horizontalmente no topo da tela —
       é a ação mais comum da recepção, ganha destaque em vez de ficar
       espremida num canto. */
    .recepcao-topo {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-bottom: var(--sp-5);
    }
    .busca-rapida { position: relative; width: 100%; max-width: 560px; }
    .busca-rapida label {
        display: block; text-align: center; font-size: var(--txt-sm); color: var(--cor-tinta-2);
        margin-bottom: var(--sp-2); font-weight: var(--peso-medio);
    }
    .busca-rapida input {
        width: 100%; border: 1px solid var(--cor-linha); border-radius: var(--raio-lg);
        padding: 16px 18px; font-size: var(--txt-lg); font-family: inherit;
        text-align: center; box-shadow: var(--sombra-menu);
    }
    .busca-rapida input:focus { border-color: var(--cor-acao); outline: none; }
    .busca-drop { position: absolute; top: 100%; left: 0; right: 0; z-index: 20; background: #fff; border: 1px solid var(--cor-linha); border-radius: var(--raio-md); box-shadow: var(--sombra-menu); margin-top: 4px; overflow: hidden; }
    .busca-item { display: grid; grid-template-columns: 90px 1fr auto; gap: var(--sp-2); align-items: center; padding: 8px 12px; text-decoration: none; color: inherit; font-size: var(--txt-sm); }
    .busca-item:hover { background: var(--cor-info-bg); }
    .bi-num { font-family: monospace; color: var(--cor-acao); font-weight: var(--peso-forte); }
    .bi-status { font-size: var(--txt-xs); color: var(--cor-tinta-3); }

    .secao { margin-bottom: var(--sp-6); }
    .secao-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: var(--sp-3);
    }
    .secao-titulo { font-size: var(--txt-lg); font-weight: var(--peso-medio); margin: 0; }
    .link-link { background: none; border: none; color: var(--cor-acao); font-size: var(--txt-sm); cursor: pointer; }
    .muted { color: var(--cor-tinta-3); font-size: var(--txt-xs); }

    /* Tabela — mesmo padrão de tabela HTML usado em Propostas/Test
       drives/Consignações (Concessionária): cabeçalho clicável
       (ColunaOrdenavel) declara as colunas, o navegador garante o
       alinhamento entre cabeçalho e linhas. Zebra pra facilitar a leitura. */
    .table-scroll { overflow-x: auto; }
    .tab { width: 100%; border-collapse: collapse; background: var(--cor-superficie); border: 1px solid var(--cor-linha); border-radius: var(--raio-lg); overflow: hidden; }
    .tab th, .tab td { padding: 11px 14px; text-align: left; border-bottom: 1px solid var(--cor-linha-suave); font-size: var(--txt-sm); }
    .tab th { background: var(--cor-fundo); font-size: var(--txt-xs); text-transform: uppercase; letter-spacing: .3px; color: var(--cor-tinta-3); }
    .tab th.r, .tab td.r { text-align: right; }
    .tab tbody tr:nth-child(even) { background: var(--cor-zebra); }
    .linha { cursor: pointer; transition: background .1s; }
    .linha:hover { background: var(--cor-info-bg); }
    .num { font-family: monospace; font-weight: var(--peso-forte); color: var(--cor-acao); }
    .valor { font-weight: var(--peso-forte); }
    .vencido { color: var(--cor-erro-tx); }
    .tag-atraso {
        font-size: var(--txt-xs); font-weight: var(--peso-forte);
        color: var(--cor-erro-tx); background: var(--cor-erro-bg);
        padding: 2px 8px; border-radius: var(--raio-full); margin-right: 6px;
    }

    /* Chips de ocupação dos mecânicos — visão rápida de quem está livre
       agora, sem precisar abrir a ficha de cada um. */
    .mecanicos-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--sp-3); }
    .mec-chip {
        background: var(--cor-superficie); border: 1px solid var(--cor-linha); border-radius: var(--raio-md);
        padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2);
    }
    .mec-info { display: flex; flex-direction: column; gap: 2px; }
    .mec-info strong { font-size: var(--txt-sm); }

    .loading, .vazio { text-align: center; padding: 60px; color: var(--cor-tinta-3); font-size: var(--txt-sm); }

    @@media (max-width: 700px) { .tab { min-width: 560px; } }
</style>
