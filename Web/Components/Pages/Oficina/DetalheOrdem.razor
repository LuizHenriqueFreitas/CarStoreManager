@page "/oficina/os/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,ChefeOficina,Mecanico,Recepcionista")]
@implements IDisposable

@namespace CarStoreManager.Web.Components.Pages

@inject IOrdemServicoService OrdemService
@inject IComponenteService ComponenteService
@inject AuthenticationStateProvider AuthState
@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.DTOs.Oficina.OrdemServico
@using CarStoreManager.Application.DTOs.Oficina.Componente
@using CarStoreManager.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web

@if (carregando)
{
    <div class="loading">Carregando...</div>
}
else if (os is null)
{
    <div class="loading">Ordem de serviço não encontrada.</div>
}
else
{
    <div class="detalhe-page">
        <div class="detalhe-header">
            <div class="header-info" data-tour="os-detalhe-header">
                <div class="os-numero-grande">OS @os.NumeroPublico</div>
                <span class="os-status @StatusClass(os.Status)">@StatusLabel(os.Status)</span>
            </div>
            <div class="header-acoes" data-tour="os-detalhe-acoes">
                @if (PodeEnviarRevisao)
                {
                    <button class="btn-acao azul" @onclick='() => PedirConfirmacao("Enviar para revisão", "Deseja enviar esta OS para revisão do mecânico?", EnviarRevisao)'>Enviar para revisão</button>
                }
                @if (PodeAprovarMecanico)
                {
                    <button class="btn-acao azul" @onclick='() => PedirConfirmacao("Aprovar orçamento", "Deseja aprovar este orçamento?", AprovarMecanico)'>Aprovar orçamento</button>
                    <button class="btn-acao laranja" @onclick='() => PedirConfirmacao("Pedir ajustes", "Deseja devolver esta OS para ajustes no orçamento?", Devolver)'>Pedir ajustes</button>
                }
                @if (PodeMarcarClienteAprovou)
                {
                    <button class="btn-acao verde" @onclick='() => PedirConfirmacao("Cliente aprovou", "Confirma que o cliente aprovou o orçamento?", ClienteAprovou)'>Cliente aprovou</button>
                }
                @if (PodeIniciar)
                {
                    <button class="btn-acao azul" @onclick='() => PedirConfirmacao("Iniciar serviço", "Deseja iniciar o serviço desta OS?", IniciarOS)'>Iniciar serviço</button>
                }
                @if (PodeFinalizar)
                {
                    <button class="btn-acao verde" @onclick='() => PedirConfirmacao("Finalizar serviço", "Deseja finalizar o serviço desta OS?", FinalizarOS)'>Finalizar serviço</button>
                }
                else if (os?.Status == "EmAndamento" && (ehAdmin || ehMecanico) && !ChecklistCompleto)
                {
                    <button class="btn-acao verde" disabled title="Conclua todos os itens do checklist para finalizar">
                        Finalizar serviço (checklist pendente)
                    </button>
                }
                @if (PodeEntregar)
                {
                    <button class="btn-acao verde" @onclick='() => PedirConfirmacao("Cobrar e entregar", "Deseja marcar esta OS como entregue ao cliente?", EntregarOS)'>💰 Cobrar e entregar</button>
                }
                @if (PodeCancelar)
                {
                    <button class="btn-acao vermelho" @onclick='() => PedirConfirmacao("Cancelar OS", "Deseja cancelar esta ordem de serviço? Essa ação não pode ser desfeita.", CancelarOS, destrutivo: true)'>Cancelar</button>
                }
            </div>
        </div>

        <!-- Trilha visual do fluxo -->
        <div class="trilha" data-tour="os-detalhe-trilha">
            @foreach (var etapa in trilha)
            {
                <div class="trilha-etapa @TrilhaClass(etapa.status)">
                    <span class="trilha-bola">@etapa.numero</span>
                    <span class="trilha-label">@etapa.label</span>
                </div>
            }
        </div>

        <div class="detalhe-content">
            <div class="detalhe-main">
                <div class="info-card" data-tour="os-detalhe-info-gerais">
                    <h2 class="card-titulo">Informações gerais</h2>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">Tipo</span>
                            <span class="info-val">@os.Tipo</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Descrição</span>
                            <span class="info-val">@os.Descricao</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Data de abertura</span>
                            <span class="info-val">@os.DataCriacao.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Prazo estimado</span>
                            <span class="info-val @(os.PrazoEstimado < DateTime.Now && os.Status != "PagamentoPendente" && os.Status != "Finalizada" ? "prazo-vencido" : "")">
                                @os.PrazoEstimado.ToString("dd/MM/yyyy")
                            </span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Custo do serviço</span>
                            <span class="info-val">
                                @os.CustoServico.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                            </span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Valor total</span>
                            <span class="info-val destaque">
                                @os.ValorTotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                            </span>
                        </div>
                    </div>
                </div>

                <div class="info-card" data-tour="os-detalhe-checklist">
                    <div class="card-header-row">
                        <h2 class="card-titulo">Checklist</h2>
                        @if (PodeEditarChecklist)
                        {
                            <button class="btn-mini" @onclick="() => mostrarAdicionarItem = true">
                                + Adicionar item
                            </button>
                        }
                    </div>

                    @if (mostrarAdicionarItem)
                    {
                        <div class="add-item-row">
                            <input class="campo-input-inline"
                                   placeholder="Descrição do item..."
                                   @bind="novoItemDescricao"
                                   @onkeydown="TeclaAdicionarItem" />
                            <button class="btn-mini azul" @onclick='() => PedirConfirmacao("Adicionar item", "Deseja adicionar este item ao checklist?", AdicionarItemChecklist)'>
                                Adicionar
                            </button>
                            <button class="btn-mini" @onclick="() => mostrarAdicionarItem = false">
                                Cancelar
                            </button>
                        </div>
                    }

                    <div class="checklist">
                        @foreach (var item in os.Checklist)
                        {
                            <div class="checklist-item @(item.Status == "Concluido" ? "concluido" : "")">
                                <div class="check-circle @CheckClass(item.Status) @(PodeMudarStatusChecklist ? "" : "check-desabilitado")"
                                     @onclick="() => CliqueCirculoChecklist(item)">
                                    @if (item.Status == "Concluido") { <span>✓</span> }
                                    else if (item.Status == "EmAndamento") { <span>●</span> }
                                </div>
                                @if (itemEmEdicao == item.Id)
                                {
                                    <input class="campo-input-inline" @bind="descricaoEdicao"
                                           @onkeydown="TeclaSalvarDescricao" />
                                    <button class="btn-mini azul" @onclick='() => PedirConfirmacao("Salvar item", "Deseja salvar a nova descrição deste item?", () => SalvarDescricaoItem(item))'>Salvar</button>
                                    <button class="btn-mini" @onclick="() => itemEmEdicao = Guid.Empty">Cancelar</button>
                                }
                                else
                                {
                                    <span class="check-descricao">@item.Descricao</span>
                                    <span class="check-origem @(item.Origem == "Manual" ? "origem-manual" : "origem-auto")">
                                        @item.Origem
                                    </span>
                                    <span class="check-status-label @CheckClass(item.Status)">@item.Status</span>
                                    @if (PodeEditarChecklist)
                                    {
                                        <button class="btn-mini" @onclick="() => IniciarEdicaoItem(item)">Editar</button>
                                        <button class="btn-mini btn-remover" @onclick='() => PedirConfirmacao("Remover item", "Deseja remover este item do checklist?", () => RemoverItemChecklist(item), destrutivo: true)'>×</button>
                                    }
                                }
                            </div>
                        }
                        @if (!os.Checklist.Any())
                        {
                            <p class="vazio">Nenhum item de checklist.</p>
                        }
                    </div>
                </div>

                <div class="info-card" data-tour="os-detalhe-pecas">
                    <div class="card-header-row">
                        <h2 class="card-titulo">Peças utilizadas</h2>
                        @if (PodeEditarItens)
                        {
                            <button class="btn-mini" @onclick="AbrirModalAdicionarPeca">
                                + Adicionar peça
                            </button>
                        }
                    </div>

                    <div class="itens-lista">
                        @foreach (var item in os.Itens)
                        {
                            var nome = item.DescricaoLivre ?? NomeComponente(item.ComponenteId);
                            <div class="item-peca">
                                <span class="item-qtd">@item.Quantidade×</span>
                                <span class="item-nome">@nome</span>
                                <span class="origem-tag @OrigemClass(item.Origem)">@OrigemLabel(item.Origem)</span>
                                @if (item.StatusItem == "AguardandoChegada")
                                {
                                    <span class="status-tag aguardando"
                                          title="Esperando chegar no estoque — atualiza automaticamente">
                                        ⏳ A caminho
                                    </span>
                                }
                                else if (item.StatusItem == "Recebido")
                                {
                                    <span class="status-tag recebido"
                                          title="@(item.DataRecebimento?.ToString("dd/MM HH:mm"))">
                                        ✓ Recebida
                                    </span>
                                }
                                <span class="item-valor">
                                    @item.ValorTotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                </span>
                                @if (PodeEditarItens)
                                {
                                    <button class="btn-mini-icone" title="Remover"
                                            @onclick='() => PedirConfirmacao("Remover peça", "Deseja remover esta peça da OS?", () => RemoverPeca(item.Id), destrutivo: true)'>×</button>
                                }
                            </div>
                        }
                        @if (!os.Itens.Any())
                        {
                            <p class="vazio">Nenhuma peça adicionada.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="detalhe-sidebar">
                <div class="progresso-card" data-tour="os-detalhe-progresso">
                    <span class="progresso-label">Progresso do checklist</span>
                    @{
                        var total = os.Checklist.Count;
                        var concluidos = os.Checklist.Count(c => c.Status == "Concluido");
                        var pct = total > 0 ? (int)((double)concluidos / total * 100) : 0;
                    }
                    <span class="progresso-pct">@pct%</span>
                    <div class="barra-fundo">
                        <div class="barra-fill" style="width: @pct%"></div>
                    </div>
                    <span class="progresso-detalhe">@concluidos de @total itens concluídos</span>
                </div>
            </div>
        </div>
    </div>
}

@if (modalPecaVisivel)
{
    <div class="modal-overlay" @onclick="() => modalPecaVisivel = false">
        <div class="modal-form" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-titulo">Adicionar peça à OS</span>
                <button class="modal-fechar" @onclick="() => modalPecaVisivel = false">×</button>
            </div>

            <div class="form-campo">
                <label class="campo-label">Origem *</label>
                <div class="origem-radios">
                    <label class="origem-radio @(pecaOrigem == "Estoque" ? "ativo" : "")">
                        <input type="radio" name="origem" value="Estoque"
                               checked="@(pecaOrigem == "Estoque")"
                               @onchange='() => { pecaOrigem = "Estoque"; nomePecaCliente = ""; }' />
                        <span class="origem-nome">📦 Estoque</span>
                        <span class="origem-desc">Oficina já tem</span>
                    </label>
                    <label class="origem-radio @(pecaOrigem == "Cliente" ? "ativo" : "")">
                        <input type="radio" name="origem" value="Cliente"
                               checked="@(pecaOrigem == "Cliente")"
                               @onchange='() => { pecaOrigem = "Cliente"; LimparComponenteSelecionado(); }' />
                        <span class="origem-nome">🧍 Cliente</span>
                        <span class="origem-desc">Cliente trouxe</span>
                    </label>
                </div>
                <span class="campo-ajuda">
                    Peça sob encomenda? Use "Não achei a peça que preciso" no painel de requisições, mais abaixo.
                </span>
            </div>

            @if (pecaOrigem == "Cliente")
            {
                <div class="form-campo">
                    <label class="campo-label">Nome da peça *</label>
                    <input type="text" class="campo-input" placeholder="Ex: farol dianteiro esquerdo"
                           @bind="nomePecaCliente" @bind:event="oninput" />
                    <span class="campo-ajuda">
                        Peça trazida pelo cliente: sem valor, sem conexão com o estoque — fica registrada só pelo nome.
                    </span>
                </div>
            }
            else
            {
                <div class="form-campo">
                    <label class="campo-label">Componente *</label>
                    <div class="peca-busca-wrapper">
                        <input type="text" class="campo-input"
                               placeholder="Buscar por nome, OEM, part number ou SKU..."
                               value="@(componenteSelecionadoBusca?.Nome ?? termoBuscaComponente)"
                               @oninput="OnTermoComponenteChanged"
                               @onfocus="OnBuscaComponenteFocus"
                               disabled="@(componenteSelecionadoBusca is not null)" />
                        @if (componenteSelecionadoBusca is not null)
                        {
                            <button type="button" class="peca-busca-limpar" @onclick="LimparComponenteSelecionado">Trocar</button>
                        }
                        @if (mostrarResultadosComponente && componenteSelecionadoBusca is null)
                        {
                            @if (resultadosBuscaComponente.Any())
                            {
                                <div class="peca-busca-dropdown">
                                    @foreach (var c in resultadosBuscaComponente)
                                    {
                                        <div class="peca-busca-item" @onclick="() => SelecionarComponenteBusca(c)">
                                            <div class="peca-busca-nome">@c.Nome</div>
                                            <div class="peca-busca-meta">
                                                @c.MarcaFabricante
                                                @if (!string.IsNullOrWhiteSpace(c.PartNumber)) { <text> · P/N @c.PartNumber</text> }
                                                <span class="peca-busca-estoque">@c.QuantidadeEmEstoque em estoque</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!buscandoComponente)
                            {
                                <div class="peca-busca-dropdown">
                                    <div class="peca-busca-vazio">
                                        Nenhum componente encontrado
                                        @(string.IsNullOrWhiteSpace(termoBuscaComponente) ? "" : $"para \"{termoBuscaComponente}\"").
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            <div class="form-grid">
                <div class="form-campo">
                    <label class="campo-label">Quantidade *</label>
                    <input type="number" min="1" class="campo-input" @bind="pecaQuantidade" />
                </div>
                @if (pecaOrigem != "Cliente")
                {
                    <div class="form-campo">
                        <label class="campo-label">Valor unitário</label>
                        <div class="info-auto">
                            💡 O valor é carregado automaticamente do cadastro do componente.
                        </div>
                    </div>
                }
            </div>

            @if (erroPeca is not null)
            {
                <div class="erro-banner">@erroPeca</div>
            }

            <div class="modal-acoes">
                <button class="btn-cancelar" @onclick="() => modalPecaVisivel = false">Cancelar</button>
                <button class="btn-confirmar"
                        @onclick='() => PedirConfirmacao("Adicionar peça", "Deseja adicionar esta peça à OS?", AdicionarPeca)'
                        disabled="@salvandoPeca">
                    @(salvandoPeca ? "Adicionando..." : "Adicionar")
                </button>
            </div>
        </div>
    </div>
}

@if (os is not null)
{
    <div style="max-width:1100px; margin:0 auto; padding: 0 24px 24px;" data-tour="os-detalhe-paineis">
        <PainelRequisicoesOS OrdemServicoId="@Id"
                             StatusOrdem="@os.Status"
                             OnAlteracaoEstado="CarregarOS" />
        <PainelAlertasOS OrdemServicoId="@Id"
                         StatusOrdem="@os.Status"
                         OnAlteracaoEstado="CarregarOS" />
        <PainelPagamentoOS OrdemServicoId="@Id" />
    </div>
}

@if (mensagem is not null)
{
    <div class="toast @(erroToast ? "toast-erro" : "toast-ok")">@mensagem</div>
}

<ConfirmacaoModal Visivel="confirmVisivel"
                   Titulo="@confirmTitulo"
                   Mensagem="@confirmMensagem"
                   Destrutivo="confirmDestrutivo"
                   OnConfirmar="ExecutarAcaoConfirmada"
                   OnCancelar="CancelarConfirmacao" />

@code {
    [Parameter] public Guid Id { get; set; }

    private OrdemServicoDTO? os;
    private bool carregando = true;
    private bool mostrarAdicionarItem = false;
    private string novoItemDescricao = string.Empty;
    private string? mensagem;
    private bool erroToast = false;

    // Adicionar peça
    private bool modalPecaVisivel = false;
    private List<ComponenteListaDTO> componentesDisponiveis = new(); // só pra exibir nome das peças já na OS
    private int pecaQuantidade = 1;
    private string pecaOrigem = "Estoque";
    private string nomePecaCliente = "";
    private string? erroPeca;
    private bool salvandoPeca = false;

    // Busca de componente (adicionar peça) — igual ao padrão de autocomplete
    // usado em EstoqueComponentes/ItensOrdemServicoSelector.
    private string termoBuscaComponente = "";
    private bool mostrarResultadosComponente;
    private bool buscandoComponente;
    private List<ComponenteBuscaDTO> resultadosBuscaComponente = new();
    private ComponenteBuscaDTO? componenteSelecionadoBusca;
    private System.Timers.Timer? debouncePecaTimer;

    // Confirmação de envio — genérica pra qualquer ação da página.
    private bool confirmVisivel = false;
    private string confirmTitulo = "Confirmar envio";
    private string confirmMensagem = "Deseja enviar o formulário como está?";
    private bool confirmDestrutivo = false;
    private Func<Task>? acaoConfirmada;

    // Auth state
    private bool ehAdmin, ehMecanico, ehRecepcionista, ehChefeOficina;
    private Guid meuUsuarioId;

    private (int numero, string label, string status)[] trilha = Array.Empty<(int, string, string)>();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        ehAdmin = state.User.IsInRole("Admin");
        ehMecanico = state.User.IsInRole("Mecanico");
        ehRecepcionista = state.User.IsInRole("Recepcionista");
        ehChefeOficina = state.User.IsInRole("ChefeOficina");
        var claim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (claim is not null) Guid.TryParse(claim.Value, out meuUsuarioId);

        var rComp = await ComponenteService.GetAllAsync();
        if (rComp.IsSuccess && rComp.Value is not null)
            componentesDisponiveis = rComp.Value.Where(c => c.Ativo).ToList();

        await CarregarOS();
    }

    public void Dispose()
    {
        debouncePecaTimer?.Stop();
        debouncePecaTimer?.Dispose();
    }

    private async Task CarregarOS()
    {
        carregando = true;
        var resultado = await OrdemService.GetByIdAsync(Id);
        os = resultado.IsSuccess ? resultado.Value : null;
        AtualizarTrilha();
        carregando = false;
    }

    private void AtualizarTrilha()
    {
        if (os is null) return;
        var s = os.Status;
        int atual = s switch
        {
            "Pendente"           => 1,
            "EmAnalise"          => 2,
            "AguardandoCliente"  => 3,
            "Aprovada"           => 4,
            "EmAndamento"        => 5,
            "PagamentoPendente"  => 6,
            "Finalizada"         => 7,
            "Entregue"           => 8,
            "Cancelada"          => 0,
            _                    => 1
        };

        var etapas = new[]
        {
            (1, "Orçamento", ""),
            (2, "Revisão mecânico", ""),
            (3, "Aguardando cliente", ""),
            (4, "Aprovado", ""),
            (5, "Em andamento", ""),
            (6, "Pagamento pendente", ""),
            (7, "Finalizada", ""),
            (8, "Entregue", "")
        };

        trilha = etapas.Select(e =>
        {
            var status = atual == 0
                ? "cancelada"
                : (e.Item1 < atual ? "ok"
                : e.Item1 == atual ? "atual"
                : "pendente");
            return (e.Item1, e.Item2, status);
        }).ToArray();
    }

    // ========== Permissões ==========

    private bool PodeEnviarRevisao =>
        os?.Status == "Pendente" && (ehAdmin || ehRecepcionista);

    private bool PodeAprovarMecanico =>
        os?.Status == "EmAnalise" && (ehAdmin || ehMecanico);

    private bool PodeMarcarClienteAprovou =>
        os?.Status == "AguardandoCliente" && (ehAdmin || ehRecepcionista);

    private bool PodeIniciar =>
        os?.Status == "Aprovada" && (ehAdmin || ehMecanico);

    // need_to_do.txt: só é possível avançar para a etapa 6 (Finalizar) depois de
    // concluir todos os itens da checklist.
    private bool ChecklistCompleto =>
        os is not null && os.Checklist.Count > 0 && os.Checklist.All(c => c.Status == "Concluido");

    private bool PodeFinalizar =>
        os?.Status == "EmAndamento" && (ehAdmin || ehMecanico) && ChecklistCompleto;

    // Recepção é quem cobra e entrega — mecânico não tem acesso a essa etapa.
    private bool PodeEntregar =>
        os?.Status == "Finalizada" && (ehAdmin || ehRecepcionista);

    private bool PodeCancelar =>
        os is not null
        && os.Status != "PagamentoPendente" && os.Status != "Finalizada"
        && os.Status != "Entregue" && os.Status != "Cancelada"
        && (ehAdmin || ehRecepcionista);

    private bool OsAberta =>
        os is not null
        && os.Status != "PagamentoPendente"
        && os.Status != "Finalizada"
        && os.Status != "Entregue"
        && os.Status != "Cancelada";

    // Adicionar/remover/editar descrição do checklist é de responsabilidade
    // exclusiva do mecânico designado pra esta OS específica — Recepcionista
    // não mexe (só visualiza). Mudar o STATUS de um item já existente é mais
    // permissivo: Admin e ChefeOficina também podem, além do mecânico responsável.
    private bool SouOMecanicoDaOS => os is not null && ehMecanico && os.MecanicoId == meuUsuarioId;
    private bool PodeEditarChecklist => OsAberta && SouOMecanicoDaOS;
    // need_to_do.txt: os itens da checklist só podem ser marcados durante a etapa 5
    // (serviço em andamento).
    private bool PodeMudarStatusChecklist =>
        os?.Status == "EmAndamento" && (SouOMecanicoDaOS || ehAdmin || ehChefeOficina);
    private bool PodeEditarItens     => OsAberta && (ehAdmin || ehMecanico || ehRecepcionista);

    // ========== Transições ==========

    private async Task EnviarRevisao()
        => await TratarResultado(await OrdemService.EnviarParaRevisaoAsync(Id), "Enviado para revisão.");

    private async Task AprovarMecanico()
        => await TratarResultado(await OrdemService.AprovarPeloMecanicoAsync(Id), "Orçamento aprovado pelo mecânico.");

    private async Task Devolver()
        => await TratarResultado(await OrdemService.DevolverParaAjustesAsync(Id), "Devolvido pra ajustes.");

    private async Task ClienteAprovou()
        => await TratarResultado(await OrdemService.RegistrarAprovacaoDoClienteAsync(Id), "Aprovação do cliente registrada.");

    private async Task IniciarOS()
        => await TratarResultado(await OrdemService.IniciarAsync(Id), "Serviço iniciado.");

    private async Task FinalizarOS()
        => await TratarResultado(await OrdemService.FinalizarAsync(Id), "Serviço finalizado. OS aguardando cobrança/entrega na recepção.");

    private async Task EntregarOS()
        => await TratarResultado(await OrdemService.EntregarAsync(Id), "OS entregue ao cliente.");

    private async Task CancelarOS()
        => await TratarResultado(await OrdemService.CancelarAsync(Id), "OS cancelada.");

    // ========== Itens da OS (peças) ==========

    private void AbrirModalAdicionarPeca()
    {
        LimparComponenteSelecionado();
        pecaQuantidade = 1;
        pecaOrigem = "Estoque";
        nomePecaCliente = "";
        erroPeca = null;
        modalPecaVisivel = true;
    }

    private async Task AdicionarPeca()
    {
        if (pecaQuantidade < 1) { erroPeca = "Quantidade inválida."; return; }

        var dto = new AdicionarItemOrdemServicoDTO
        {
            OrdemServicoId = Id,
            Quantidade = pecaQuantidade,
            Origem = pecaOrigem
        };

        if (pecaOrigem == "Cliente")
        {
            if (string.IsNullOrWhiteSpace(nomePecaCliente)) { erroPeca = "Informe o nome da peça trazida pelo cliente."; return; }
            dto.DescricaoLivre = nomePecaCliente.Trim();
        }
        else
        {
            if (componenteSelecionadoBusca is null) { erroPeca = "Busque e selecione um componente."; return; }
            dto.ComponenteId = componenteSelecionadoBusca.Id;
            dto.ValorUnitario = 0; // ignorado pelo service — valor vem sempre do componente
        }

        var statusAntes = os?.Status;

        salvandoPeca = true;
        var r = await OrdemService.AdicionarItemAsync(dto);
        salvandoPeca = false;

        if (r.IsSuccess)
        {
            modalPecaVisivel = false;
            await CarregarOS();
            // Se a OS estava EmAndamento, o service pausa automaticamente e cria alerta.
            var avisoExtra = statusAntes == "EmAndamento"
                ? " OS pausada — recepção será notificada para o cliente reaprovar."
                : "";
            await MostrarMensagem("Peça adicionada." + avisoExtra, false);
        }
        else
        {
            erroPeca = r.Error;
        }
    }

    private async Task RemoverPeca(Guid itemId)
    {
        var r = await OrdemService.RemoverItemAsync(Id, itemId);
        if (r.IsSuccess) await CarregarOS();
        else await MostrarMensagem(r.Error ?? "Erro ao remover.", true);
    }

    private string NomeComponente(Guid? id)
        => id is null ? "(peça trazida pelo cliente)" : componentesDisponiveis.FirstOrDefault(c => c.Id == id)?.Nome ?? id.Value.ToString()[..8];

    // ---- Busca de componente (adicionar peça) ----

    private void OnBuscaComponenteFocus()
    {
        mostrarResultadosComponente = true;
        if (string.IsNullOrWhiteSpace(termoBuscaComponente) && !resultadosBuscaComponente.Any())
            _ = ExecutarBuscaComponenteAsync();
    }

    private void OnTermoComponenteChanged(ChangeEventArgs e)
    {
        termoBuscaComponente = e.Value?.ToString() ?? "";
        mostrarResultadosComponente = true;
        componenteSelecionadoBusca = null;

        debouncePecaTimer?.Stop();
        debouncePecaTimer?.Dispose();
        debouncePecaTimer = new System.Timers.Timer(220) { AutoReset = false };
        debouncePecaTimer.Elapsed += async (_, _) => await InvokeAsync(ExecutarBuscaComponenteAsync);
        debouncePecaTimer.Start();
    }

    private async Task ExecutarBuscaComponenteAsync()
    {
        buscandoComponente = true;
        var r = await ComponenteService.BuscarAsync(termoBuscaComponente, 20);
        resultadosBuscaComponente = r.IsSuccess && r.Value is not null ? r.Value.ToList() : new();
        buscandoComponente = false;
        StateHasChanged();
    }

    private void SelecionarComponenteBusca(ComponenteBuscaDTO c)
    {
        componenteSelecionadoBusca = c;
        mostrarResultadosComponente = false;
        resultadosBuscaComponente.Clear();
    }

    private void LimparComponenteSelecionado()
    {
        componenteSelecionadoBusca = null;
        termoBuscaComponente = "";
        mostrarResultadosComponente = false;
        resultadosBuscaComponente.Clear();
    }

    // ========== Checklist ==========

    private async Task AdicionarItemChecklist()
    {
        if (string.IsNullOrWhiteSpace(novoItemDescricao)) return;

        var resultado = await OrdemService.AdicionarItemChecklistAsync(
            new AdicionarChecklistItemDTO
            {
                OrdemServicoId = Id,
                Descricao = novoItemDescricao
            });

        if (resultado.IsSuccess)
        {
            novoItemDescricao = string.Empty;
            mostrarAdicionarItem = false;
            await CarregarOS();
        }
        else
        {
            await MostrarMensagem(resultado.Error ?? "Erro.", erro: true);
        }
    }

    // need_to_do.txt: cliques na checklist são aceitos automaticamente, sem
    // confirmação a cada clique.
    private async Task CliqueCirculoChecklist(ChecklistItemDTO item)
    {
        if (!PodeMudarStatusChecklist) return;
        if (item.Status == "Concluido") return;

        var novoStatus = item.Status == "Pendente" ? "EmAndamento" : "Concluido";
        await AvancarStatusChecklist(item, novoStatus);
    }

    private async Task AvancarStatusChecklist(ChecklistItemDTO item, string novoStatus)
    {
        if (!PodeMudarStatusChecklist) return;
        if (item.Status == "Concluido") return;

        var resultado = await OrdemService.AtualizarStatusChecklistAsync(
            new AtualizarStatusChecklistDTO
            {
                OrdemServicoId = Id,
                ItemId = item.Id,
                NovoStatus = novoStatus
            });

        if (resultado.IsSuccess) await CarregarOS();
    }

    private static string StatusChecklistLabel(string status) => status switch
    {
        "EmAndamento" => "em andamento",
        "Concluido" => "concluído",
        _ => "pendente"
    };

    private async Task TeclaAdicionarItem(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AdicionarItemChecklist();
        if (e.Key == "Escape") mostrarAdicionarItem = false;
    }

    private Guid itemEmEdicao = Guid.Empty;
    private string descricaoEdicao = "";

    private void IniciarEdicaoItem(ChecklistItemDTO item)
    {
        itemEmEdicao = item.Id;
        descricaoEdicao = item.Descricao;
    }

    private async Task SalvarDescricaoItem(ChecklistItemDTO item)
    {
        if (string.IsNullOrWhiteSpace(descricaoEdicao)) return;
        var r = await OrdemService.AtualizarDescricaoChecklistAsync(Id, item.Id, descricaoEdicao);
        if (r.IsSuccess) { itemEmEdicao = Guid.Empty; await CarregarOS(); }
        else await MostrarMensagem(r.Error ?? "Erro ao salvar.", erro: true);
    }

    private async Task TeclaSalvarDescricao(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") itemEmEdicao = Guid.Empty;
    }

    private async Task RemoverItemChecklist(ChecklistItemDTO item)
    {
        var r = await OrdemService.RemoverItemChecklistAsync(Id, item.Id);
        if (r.IsSuccess) await CarregarOS();
        else await MostrarMensagem(r.Error ?? "Erro ao remover.", erro: true);
    }

    // ========== Confirmação de envio ==========

    private void PedirConfirmacao(string titulo, string mensagem, Func<Task> acao, bool destrutivo = false)
    {
        confirmTitulo = titulo;
        confirmMensagem = mensagem;
        confirmDestrutivo = destrutivo;
        acaoConfirmada = acao;
        confirmVisivel = true;
    }

    private async Task ExecutarAcaoConfirmada()
    {
        confirmVisivel = false;
        var acao = acaoConfirmada;
        acaoConfirmada = null;
        if (acao is not null) await acao();
    }

    private void CancelarConfirmacao()
    {
        confirmVisivel = false;
        acaoConfirmada = null;
    }

    private async Task TratarResultado(
        CarStoreManager.Application.Common.Result resultado, string msg)
    {
        if (resultado.IsSuccess)
        {
            await MostrarMensagem(msg, erro: false);
            await CarregarOS();
        }
        else
        {
            await MostrarMensagem(resultado.Error ?? "Erro.", erro: true);
        }
    }

    private async Task MostrarMensagem(string msg, bool erro)
    {
        mensagem = msg;
        erroToast = erro;
        StateHasChanged();
        await Task.Delay(3000);
        mensagem = null;
        StateHasChanged();
    }

    // ========== UI helpers ==========

    private string StatusLabel(string s) => s switch
    {
        "Pendente"          => "Pendente",
        "EmAnalise"         => "Em revisão (mecânico)",
        "AguardandoCliente" => "Aguardando cliente",
        "Aprovada"          => "Aprovada",
        "EmAndamento"       => "Em andamento",
        "PagamentoPendente" => "Pagamento pendente",
        "Finalizada"        => "Finalizada",
        "Entregue"          => "Entregue",
        "Cancelada"         => "Cancelada",
        _                   => s
    };

    private string StatusClass(string status) => status switch
    {
        "Pendente"          => "status-pendente",
        "EmAnalise"         => "status-analise",
        "AguardandoCliente" => "status-aguardando",
        "Aprovada"          => "status-aprovada",
        "EmAndamento"       => "status-andamento",
        "PagamentoPendente" => "status-pagamento-pendente",
        "Finalizada"        => "status-finalizada",
        "Entregue"          => "status-entregue",
        "Cancelada"         => "status-cancelada",
        _                   => "status-pendente"
    };

    private string CheckClass(string status) => status switch
    {
        "Concluido"   => "check-concluido",
        "EmAndamento" => "check-andamento",
        _             => "check-pendente"
    };

    private string TrilhaClass(string status) => status switch
    {
        "ok"        => "trilha-ok",
        "atual"     => "trilha-atual",
        "cancelada" => "trilha-cancelada",
        _           => "trilha-pendente"
    };

    private string OrigemLabel(string origem) => origem switch
    {
        "Estoque"   => "📦 Estoque",
        "Cliente"   => "🧍 Cliente",
        "Encomenda" => "🚚 Encomenda",
        _           => origem
    };

    private string OrigemClass(string origem) => origem switch
    {
        "Cliente"   => "origem-cliente",
        "Encomenda" => "origem-encomenda",
        _           => "origem-estoque"
    };
}

