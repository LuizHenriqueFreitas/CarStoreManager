@page "/financeiro/a-receber"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "pagina:/financeiro/a-receber")]

@namespace CarStoreManager.Web.Components.Pages

@rendermode InteractiveServer
@inject IOrdemServicoService OrdemService
@inject IClienteService ClienteService
@inject NavigationManager Nav
@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.DTOs.Oficina.OrdemServico
@using CarStoreManager.Application.DTOs.Shared.Cliente
@using CarStoreManager.Web.Components.Shared
@using System.Globalization

<div class="pagina">
    <PageHeader Titulo="Contas a receber" Subtitulo="Serviços concluídos aguardando cobrança" />

    <SubNav Itens="SubNavFinanceiro.Itens" />

    @if (carregando)
    {
        <div class="estado-carregando">Carregando...</div>
    }
    else
    {
        <StatCardGrid MinColuna="200" data-tour="areceber-kpis">
            <MetricCard Rotulo="Total a receber" Valor="@FBRL(total)" Tom="atencao" />
            <MetricCard Rotulo="Ordens em aberto" Valor="@aReceber.Count.ToString()" />
            <MetricCard Rotulo="Aberto há mais tempo" Valor="@($"{maxDias} dia(s)")" Tom="@(maxDias > 7 ? "erro" : "")" />
        </StatCardGrid>

        <p class="muted intro">
            Aqui estão as ordens de serviço com o trabalho técnico concluído mas ainda não pagas
            (status "Aguardando cobrança"). Propostas de venda com pagamento pendente aparecem em
            <a href="/concessionaria/propostas">Propostas</a>.
        </p>

        @if (!aReceber.Any())
        {
            <EstadoVazio Mensagem="Nenhuma ordem aguardando cobrança. Tudo em dia! 🎉" Icone="💰" />
        }
        else
        {
            <div class="table-scroll" data-tour="areceber-lista">
                <table class="tab">
                    <thead>
                        <tr>
                            <ColunaOrdenavel Coluna="numero" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">OS</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="cliente" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Cliente</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="servico" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Serviço</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="aberta" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Aberta em</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="dias" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Dias</ColunaOrdenavel>
                            <ColunaOrdenavel Coluna="valor" Class="r" ColunaAtiva="@sortColuna" Ascendente="@sortAscendente" OnOrdenar="Ordenar">Valor</ColunaOrdenavel>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in aReceber)
                        {
                            <tr @onclick="() => Abrir(o.Id)" class="linha">
                                <td class="num">@o.NumeroPublico</td>
                                <td>@NomeCliente(o.ClienteId)</td>
                                <td>@o.Tipo</td>
                                <td>@o.DataCriacao.ToString("dd/MM/yyyy")</td>
                                <td class="@(Dias(o) > 7 ? "venc" : "")">@Dias(o)</td>
                                <td class="r valor">@FBRL(o.ValorTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private static readonly CultureInfo Cultura = new("pt-BR");
    private static string FBRL(decimal v) => v.ToString("C", Cultura);

    private List<OrdemServicoListaDTO> aReceber = new();
    private Dictionary<Guid, ClienteListaDTO> mapaClientes = new();
    private decimal total;
    private int maxDias;
    private bool carregando = true;

    // Ordenação da tabela — clique na coluna ordena crescente; clique de
    // novo na mesma coluna inverte pra decrescente (ver ColunaOrdenavel).
    private string sortColuna = "dias";
    private bool sortAscendente = false;

    protected override async Task OnInitializedAsync()
    {
        var tO = OrdemService.GetAllAsync();
        var tC = ClienteService.GetAllAsync();
        await Task.WhenAll(tO, tC);

        var ordens = tO.Result.IsSuccess ? tO.Result.Value?.ToList() ?? new() : new();
        if (tC.Result.IsSuccess && tC.Result.Value is not null)
            mapaClientes = tC.Result.Value.ToDictionary(c => c.Id);

        aReceber = ordens.Where(o => o.Status == "PagamentoPendente").ToList();
        total = aReceber.Sum(o => o.ValorTotal);
        maxDias = aReceber.Any() ? aReceber.Max(Dias) : 0;
        OrdenarLista();
        carregando = false;
    }

    private void Ordenar(string coluna)
    {
        if (sortColuna == coluna) sortAscendente = !sortAscendente;
        else { sortColuna = coluna; sortAscendente = true; }
        OrdenarLista();
    }

    private void OrdenarLista()
    {
        aReceber = sortColuna switch
        {
            "numero" => Ordenacao.Por(aReceber, o => o.NumeroPublico, sortAscendente),
            "cliente" => Ordenacao.Por(aReceber, o => NomeCliente(o.ClienteId), sortAscendente),
            "servico" => Ordenacao.Por(aReceber, o => o.Tipo, sortAscendente),
            "aberta" => Ordenacao.Por(aReceber, o => o.DataCriacao, sortAscendente),
            "valor" => Ordenacao.Por(aReceber, o => o.ValorTotal, sortAscendente),
            _ => Ordenacao.Por(aReceber, Dias, sortAscendente),
        };
    }

    private int Dias(OrdemServicoListaDTO o) => (DateTime.Today - o.DataCriacao.Date).Days;
    private string NomeCliente(Guid id) => mapaClientes.TryGetValue(id, out var c) ? c.Nome : "—";
    private void Abrir(Guid id) => Nav.NavigateTo($"/oficina/os/{id}");
}

<style>
    .intro { max-width: 700px; margin-bottom: var(--sp-5); }
    .tab { width: 100%; border-collapse: collapse; background: var(--cor-superficie); border: 1px solid var(--cor-linha); border-radius: var(--raio-lg); overflow: hidden; }
    .tab th, .tab td { padding: 11px 14px; text-align: left; border-bottom: 1px solid var(--cor-linha-suave); font-size: var(--txt-sm); }
    .tab th { background: var(--cor-fundo); font-size: var(--txt-xs); text-transform: uppercase; color: var(--cor-tinta-3); }
    .tab th.r, .tab td.r { text-align: right; }
    .tab tbody tr:nth-child(even) { background: var(--cor-zebra); }
    .linha { cursor: pointer; }
    .linha:hover { background: var(--cor-info-bg); }
    .num { font-family: monospace; font-weight: var(--peso-forte); color: var(--cor-acao); }
    .valor { font-weight: var(--peso-bold); }
    td.venc { color: var(--cor-erro-tx); font-weight: var(--peso-forte); }
</style>
