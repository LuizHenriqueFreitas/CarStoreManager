@page "/financeiro/despesas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,GerenteVendas,ChefeOficina")]

@namespace CarStoreManager.Web.Components.Pages

@rendermode InteractiveServer
@inject IBalancoMensalDespesaService BalancoService
@using CarStoreManager.Application.Interfaces.Sistema
@using CarStoreManager.Application.DTOs.Sistema
@using CarStoreManager.Web.Components.Shared

<div class="pagina">
    <PageHeader Titulo="Despesas — balanço mensal" Subtitulo="@subtitulo">
        <Acao>
            <div class="cluster">
                <select class="comp-select" @bind="competencia" @bind:after="Carregar">
                    @foreach (var c in competencias)
                    {
                        <option value="@c.chave">@c.label</option>
                    }
                </select>
            </div>
        </Acao>
    </PageHeader>

    <SubNav Itens="SubNavFinanceiro.Itens" />

    @if (!string.IsNullOrEmpty(msg)) { <div class="banner @(erro ? "erro" : "ok")">@msg</div> }

    <p class="muted intro">
        O balanço é preenchido a partir do
        <a href="/configuracoes/formulario-despesas">formulário mensal de despesas</a>.
        Ajuste os valores reais, adicione linhas que faltarem e <strong>feche</strong> o
        balanço quando terminar. Cada mês fica guardado para análises futuras.
    </p>

    @if (carregando)
    {
        <div class="estado-carregando">Carregando...</div>
    }
    else if (balanco is null)
    {
        <EstadoVazio Mensagem="Não foi possível carregar o balanço." Icone="⚠" />
    }
    else if (!balanco.ExisteNoBanco)
    {
        <div class="card iniciar">
            <p>Ainda não há balanço para <strong>@Mes(balanco.Mes)/@balanco.Ano</strong>.</p>
            <button class="btn btn-primario" @onclick="Gerar">Gerar a partir do formulário</button>
        </div>
    }
    else
    {
        <StatCardGrid MinColuna="180">
            <MetricCard Rotulo="Total do mês" Valor="@FBRL(balanco.Total)" Tom="alerta" />
            <MetricCard Rotulo="Geral" Valor="@FBRL(balanco.TotalGeral)" />
            <MetricCard Rotulo="Oficina" Valor="@FBRL(balanco.TotalOficina)" />
            <MetricCard Rotulo="Concessionária" Valor="@FBRL(balanco.TotalConcessionaria)" />
        </StatCardGrid>

        <div class="acoes-balanco">
            @if (balanco.Fechado)
            {
                <span class="tag-fechado">Balanço fechado em @balanco.DataFechamento?.ToLocalTime().ToString("dd/MM/yyyy")</span>
                <button class="btn btn-neutro" @onclick="Reabrir">Reabrir para editar</button>
            }
            else
            {
                <button class="btn btn-primario" @onclick="Fechar">Fechar balanço</button>
            }
        </div>

        <div class="table-scroll">
            <table class="tab">
                <thead>
                    <tr><th style="width:28%">Nome</th><th style="width:16%">Setor</th>
                        <th style="width:20%">Categoria</th><th style="width:16%">Valor</th><th style="width:16%"></th></tr>
                </thead>
                <tbody>
                    @foreach (var it in balanco.Itens)
                    {
                        <tr class="@(it.DoModelo ? "" : "extra")">
                            <td><input @bind="it.Nome" disabled="@balanco.Fechado" /></td>
                            <td>
                                <select @bind="it.Setor" disabled="@balanco.Fechado">
                                    <option value="Geral">Geral</option>
                                    <option value="Oficina">Oficina</option>
                                    <option value="Concessionaria">Concessionária</option>
                                </select>
                            </td>
                            <td><input @bind="it.Categoria" disabled="@balanco.Fechado" /></td>
                            <td><input type="number" step="0.01" @bind="it.Valor" disabled="@balanco.Fechado" /></td>
                            <td class="acoes">
                                @if (!balanco.Fechado)
                                {
                                    <button class="btn-mini ok" @onclick="() => SalvarItem(it)">Salvar</button>
                                    <button class="btn-mini neg" @onclick="() => RemoverItem(it.Id)">Excluir</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!balanco.Fechado)
                    {
                        <tr class="nova">
                            <td><input @bind="nova.Nome" placeholder="Nova linha..." /></td>
                            <td>
                                <select @bind="nova.Setor">
                                    <option value="Geral">Geral</option>
                                    <option value="Oficina">Oficina</option>
                                    <option value="Concessionaria">Concessionária</option>
                                </select>
                            </td>
                            <td><input @bind="nova.Categoria" placeholder="categoria" /></td>
                            <td><input type="number" step="0.01" @bind="nova.Valor" /></td>
                            <td class="acoes"><button class="btn-mini ok" @onclick="AdicionarItem">Adicionar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo Cultura = new("pt-BR");
    private static string FBRL(decimal v) => v.ToString("C", Cultura);

    private BalancoMensalDespesaDTO? balanco;
    private string competencia = "";
    private bool carregando = true;
    private string subtitulo = "";
    private string? msg; private bool erro;
    private SalvarItemBalancoDTO nova = new() { Setor = "Geral" };

    private List<(string chave, string label)> competencias = new();

    protected override async Task OnInitializedAsync()
    {
        var hoje = DateTime.Today;
        for (var i = 0; i < 15; i++)
        {
            var d = hoje.AddMonths(-i);
            competencias.Add(($"{d.Year}-{d.Month}", $"{Mes(d.Month)} / {d.Year}"));
        }
        competencia = competencias[0].chave;
        await Carregar();
    }

    private (int ano, int mes) Comp()
    {
        var p = competencia.Split('-');
        return (int.Parse(p[0]), int.Parse(p[1]));
    }

    private async Task Carregar()
    {
        carregando = true;
        var (ano, mes) = Comp();
        var r = await BalancoService.ObterAsync(ano, mes);
        balanco = r.IsSuccess ? r.Value : null;
        subtitulo = $"Competência {Mes(mes)}/{ano}" + (balanco?.Fechado == true ? " · fechado" : "");
        nova = new() { Setor = "Geral" };
        carregando = false;
    }

    private async Task Gerar()
    {
        var (ano, mes) = Comp();
        var r = await BalancoService.GerarDoModeloAsync(ano, mes);
        Msg(r.IsSuccess ? "Balanço gerado a partir do formulário." : r.Error ?? "Erro", !r.IsSuccess);
        await Carregar();
    }

    private async Task SalvarItem(ItemBalancoDespesaDTO it)
    {
        var (ano, mes) = Comp();
        var r = await BalancoService.SalvarItemAsync(new SalvarItemBalancoDTO
        {
            Ano = ano, Mes = mes, ItemId = it.Id, Nome = it.Nome, Setor = it.Setor,
            Categoria = it.Categoria, Valor = it.Valor
        });
        Msg(r.IsSuccess ? "Linha salva." : r.Error ?? "Erro", !r.IsSuccess);
        await Carregar();
    }

    private async Task AdicionarItem()
    {
        if (string.IsNullOrWhiteSpace(nova.Nome)) { Msg("Informe o nome da despesa.", true); return; }
        var (ano, mes) = Comp();
        nova.Ano = ano; nova.Mes = mes; nova.ItemId = null;
        var r = await BalancoService.SalvarItemAsync(nova);
        Msg(r.IsSuccess ? "Linha adicionada." : r.Error ?? "Erro", !r.IsSuccess);
        await Carregar();
    }

    private async Task RemoverItem(Guid id)
    {
        var (ano, mes) = Comp();
        var r = await BalancoService.RemoverItemAsync(ano, mes, id);
        Msg(r.IsSuccess ? "Linha removida." : r.Error ?? "Erro", !r.IsSuccess);
        await Carregar();
    }

    private async Task Fechar()
    {
        var (ano, mes) = Comp();
        var r = await BalancoService.FecharAsync(ano, mes);
        Msg(r.IsSuccess ? "Balanço fechado." : r.Error ?? "Erro", !r.IsSuccess);
        await Carregar();
    }

    private async Task Reabrir()
    {
        var (ano, mes) = Comp();
        var r = await BalancoService.ReabrirAsync(ano, mes);
        Msg(r.IsSuccess ? "Balanço reaberto." : r.Error ?? "Erro", !r.IsSuccess);
        await Carregar();
    }

    private void Msg(string m, bool e) { msg = m; erro = e; }

    private static string Mes(int m) => new[] { "", "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
        "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" }[m];
}

<style>
    .intro { max-width: 760px; margin-bottom: var(--sp-5); }
    .comp-select { border: 1px solid var(--cor-linha); border-radius: var(--raio-md); padding: 7px 10px; font-size: var(--txt-sm); font-family: inherit; }
    .iniciar { text-align: center; padding: var(--sp-8); }
    .iniciar p { margin: 0 0 var(--sp-4); }

    .acoes-balanco { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-4); flex-wrap: wrap; }
    .tag-fechado { font-size: var(--txt-sm); color: var(--cor-ok-tx); background: var(--cor-ok-bg); padding: 4px 12px; border-radius: var(--raio-full); }

    .tab { width: 100%; border-collapse: collapse; background: var(--cor-superficie); border: 1px solid var(--cor-linha); border-radius: var(--raio-lg); overflow: hidden; }
    .tab th, .tab td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--cor-linha-suave); font-size: var(--txt-sm); }
    .tab th { background: var(--cor-fundo); font-size: var(--txt-xs); text-transform: uppercase; color: var(--cor-tinta-3); }
    .tab input, .tab select { width: 100%; border: 1px solid var(--cor-linha); border-radius: var(--raio-sm); padding: 5px 7px; font-size: var(--txt-sm); font-family: inherit; }
    .tab input:disabled, .tab select:disabled { background: var(--cor-superficie-2); color: var(--cor-tinta-2); }
    .tab .extra td:first-child { border-left: 3px solid var(--cor-acao); }
    .tab .nova { background: var(--cor-info-bg); }
    .acoes { display: flex; gap: 4px; }
    .btn-mini { border: 1px solid var(--cor-linha); border-radius: var(--raio-sm); padding: 4px 9px; font-size: var(--txt-xs); cursor: pointer; background: var(--cor-superficie-2); }
    .btn-mini.ok { background: var(--cor-ok-bg); color: var(--cor-ok-tx); border-color: transparent; }
    .btn-mini.neg { background: var(--cor-erro-bg); color: var(--cor-erro-tx); border-color: transparent; }

    .banner { margin-bottom: var(--sp-4); padding: var(--sp-3); border-radius: var(--raio-md); font-size: var(--txt-sm); }
    .banner.ok { background: var(--cor-ok-bg); color: var(--cor-ok-tx); }
    .banner.erro { background: var(--cor-erro-bg); color: var(--cor-erro-tx); }
</style>
