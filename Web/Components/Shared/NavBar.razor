@namespace CarStoreManager.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using CarStoreManager.Application.Interfaces
@using CarStoreManager.Application.Interfaces.Sistema
@using CarStoreManager.Web.Tours
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject IPermissaoAcessoService PermissaoService
@inject IJSRuntime JS
@inject TourEstadoService TourEstado
@implements IDisposable

@* Navegação global — 5 áreas primárias + utilitários.
   Ver docs/redesign/01-arquitetura-informacao.md §2 e 04 §5. *@

<nav class="navbar">
    <a href="/" class="navbar-logo">
        <span class="logo-a">DE</span><span class="logo-b">LORE</span>
    </a>

    <div class="navbar-links @(menuMobileAberto ? "aberto" : "")">
        <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" ActiveClass="nav-link-active" @onclick="FecharMobile">
            Início
        </NavLink>

        <AuthorizeView Roles="Admin,GerenteVendas,Vendedor" Context="c1">
            <NavArea Titulo="Concessionária" RotaBase="/concessionaria"
                     Itens="@ItensConcessionaria" OnNavegar="FecharMobile" />
        </AuthorizeView>

        <AuthorizeView Roles="Admin,ChefeOficina,Mecanico,Recepcionista" Context="c2">
            <NavArea Titulo="Oficina" RotaBase="/oficina"
                     Itens="@itensOficinaAtual" OnNavegar="FecharMobile" />
        </AuthorizeView>

        <AuthorizeView Roles="Admin,GerenteVendas,Vendedor,ChefeOficina,Recepcionista" Context="cCli">
            <NavLink href="/clientes" class="nav-link" ActiveClass="nav-link-active" @onclick="FecharMobile">
                Clientes
            </NavLink>
        </AuthorizeView>

        @* NavLink comum usaria prefixo — "/financeiro/relatorios" ficaria
           destacado aqui TAMBÉM, já que Relatórios tem link próprio agora
           (linha abaixo). Por isso classe calculada na mão, excluindo esse
           sub-caminho especificamente. *@
        <AuthorizeView Roles="Admin,GerenteVendas,ChefeOficina" Context="c3">
            <a href="/financeiro" class="@ClasseFinanceiro" @onclick="FecharMobile">
                Financeiro
            </a>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,GerenteVendas,ChefeOficina" Context="c4">
            <NavLink href="/dashboard" class="nav-link" ActiveClass="nav-link-active" @onclick="FecharMobile">
                Análises
            </NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,GerenteVendas,ChefeOficina" Context="c6">
            <NavLink href="/financeiro/relatorios" class="nav-link" ActiveClass="nav-link-active" @onclick="FecharMobile">
                Relatórios
            </NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin" Context="cEq">
            <NavLink href="/equipe" class="nav-link" ActiveClass="nav-link-active" @onclick="FecharMobile">
                Equipe
            </NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,GerenteVendas,ChefeOficina" Context="c5">
            <NavArea Titulo="Configurações" RotaBase="/configuracoes"
                     Itens="@itensConfiguracoesAtual" OnNavegar="FecharMobile" />
        </AuthorizeView>
    </div>

    <div class="navbar-direita">
        <button type="button" class="tour-btn-ajuda" @onclick="AbrirTourAsync" title="Ajuda desta tela" aria-label="Ajuda desta tela">
            ?
        </button>

        <div class="navbar-user">
            <button type="button" class="navbar-user-btn" @onclick="ToggleDropdown"
                    aria-haspopup="true" aria-expanded="@dropdownAberto.ToString().ToLower()">
                <span class="navbar-avatar">@(NomeUsuario.Length > 0 ? NomeUsuario[0].ToString().ToUpper() : "?")</span>
                <span class="navbar-user-nome">@NomeUsuario</span>
                <span class="dropdown-seta">▾</span>
            </button>

            @if (dropdownAberto)
            {
                <div class="dropdown-menu" @onclick:stopPropagation>
                    <div class="dropdown-header">
                        <div class="dropdown-nome">@NomeUsuario</div>
                        <div class="dropdown-role">@Role</div>
                    </div>
                    <button type="button" class="dropdown-item" @onclick="IrParaConta">Minha conta</button>
                    <button type="button" class="dropdown-item" @onclick="Logout">Sair</button>
                </div>
            }
        </div>

        <button type="button" class="navbar-hamburguer" @onclick="ToggleMenuMobile"
                title="Menu" aria-label="Abrir menu" aria-expanded="@menuMobileAberto.ToString().ToLower()">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

@code {
    [Parameter] public string NomeUsuario { get; set; } = "Usuário";
    [Parameter] public string Role { get; set; } = string.Empty;

    private bool dropdownAberto;
    private bool menuMobileAberto;

    private static readonly NavArea.Item[] ItensConcessionaria =
    {
        new("/concessionaria", "Visão geral"),
        new("/concessionaria/salao", "Salão"),
        new("/concessionaria/propostas", "Propostas"),
        new("/concessionaria/test-drives", "Test drives"),
        new("/concessionaria/consignacoes", "Consignações"),
    };

    private NavArea.Item[] itensOficinaAtual = Array.Empty<NavArea.Item>();
    private NavArea.Item[] itensConfiguracoesAtual = Array.Empty<NavArea.Item>();
    private string? roleJaCalculada;

    /// <summary>
    /// "Fornecedores" (e qualquer item futuro sujeito à matriz de
    /// permissões) só aparece se `PermissaoService` liberar aquele papel —
    /// antes disso, o item aparecia pra todo não-mecânico (inclusive
    /// Recepcionista, que a própria rota já bloqueia — ver docs/redesign/
    /// 23-permissoes-dinamicas-por-papel.md).
    /// </summary>
    private async Task<NavArea.Item[]> ObterItensOficinaAsync(CarStoreManager.Domain.Enums.RoleUsuario role)
    {
        var mecanico = role == CarStoreManager.Domain.Enums.RoleUsuario.Mecanico;
        var lista = new List<NavArea.Item> { new("/oficina", "Visão geral") };
        if (!mecanico)
            lista.Add(new("/oficina/recepcao", "Recepção"));
        lista.Add(new("/oficina/ordens", "Ordens de serviço"));
        lista.Add(new("/oficina/componentes", "Estoque de peças"));
        if (!mecanico && await PermissaoService.PodeAcessarAsync(role, "pagina:/oficina/fornecedores"))
            lista.Add(new("/oficina/fornecedores", "Fornecedores"));
        return lista.ToArray();
    }

    private async Task<NavArea.Item[]> ObterItensConfiguracoesAsync(CarStoreManager.Domain.Enums.RoleUsuario role)
    {
        var lista = new List<NavArea.Item>();
        if (await PermissaoService.PodeAcessarAsync(role, "pagina:/configuracoes"))
            lista.Add(new("/configuracoes", "Sistema"));
        lista.Add(new("/configuracoes/formulario-despesas", "Formulário de despesas"));
        return lista.ToArray();
    }

    private async Task RecalcularItensAsync()
    {
        if (Role == roleJaCalculada) return; // evita reconsultar o serviço a cada re-render sem mudança de papel
        if (!Enum.TryParse<CarStoreManager.Domain.Enums.RoleUsuario>(Role, out var role)) return;

        itensOficinaAtual = await ObterItensOficinaAsync(role);
        itensConfiguracoesAtual = await ObterItensConfiguracoesAsync(role);
        roleJaCalculada = Role;
    }

    // Ativo em qualquer sub-rota de /financeiro (despesas, a-receber, etc.),
    // exceto /financeiro/relatorios — essa tem o próprio link na navbar.
    private string ClasseFinanceiro
    {
        get
        {
            var caminho = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
            var ativo = (caminho == "/financeiro" || caminho.StartsWith("/financeiro/"))
                && !caminho.StartsWith("/financeiro/relatorios");
            return ativo ? "nav-link nav-link-active" : "nav-link";
        }
    }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLoc;
    protected override async Task OnParametersSetAsync() => await RecalcularItensAsync();
    private void OnLoc(object? s, EventArgs e) { dropdownAberto = false; menuMobileAberto = false; InvokeAsync(StateHasChanged); }
    public void Dispose() => Navigation.LocationChanged -= OnLoc;

    private void ToggleDropdown() => dropdownAberto = !dropdownAberto;
    private void ToggleMenuMobile() => menuMobileAberto = !menuMobileAberto;
    private void FecharMobile() => menuMobileAberto = false;

    private async Task AbrirTourAsync() => await TourEstado.SolicitarTourAsync();

    private void IrParaConta()
    {
        dropdownAberto = false;
        Navigation.NavigateTo("/conta");
    }

    private async Task Logout()
    {
        dropdownAberto = false;
        try { await JS.InvokeVoidAsync("carstoreLogout"); }
        catch (Exception ex) { Console.WriteLine($"Erro ao limpar sessão: {ex.Message}"); }
        Navigation.NavigateTo("/login?logout=true", forceLoad: true);
    }
}

<style>
    .navbar {
        background: var(--cor-tinta);
        padding: 0 var(--sp-6);
        min-height: var(--altura-navbar);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-3);
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .navbar-logo {
        font-size: 18px;
        font-weight: var(--peso-forte);
        letter-spacing: 1px;
        text-decoration: none;
        flex-shrink: 0;
    }
    .logo-a { color: #fff; }
    .logo-b { color: var(--cor-marca); }

    .navbar-links {
        display: flex;
        align-items: center;
        gap: var(--sp-5);
        flex-wrap: wrap;
    }

    .navbar-direita { display: flex; align-items: center; gap: var(--sp-2); flex-shrink: 0; }

    .navbar-hamburguer {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        width: 32px; height: 32px;
        background: transparent; border: none; cursor: pointer; padding: 0;
    }
    .navbar-hamburguer span { display: block; width: 20px; height: 2px; background: #ccc; margin: 0 auto; }

    .nav-link {
        color: #aaa;
        font-size: var(--txt-sm);
        padding: 4px 0;
        border-bottom: 2px solid transparent;
        transition: color .2s;
        text-decoration: none;
        white-space: nowrap;
    }
    .nav-link:hover { color: #fff; }
    .nav-link-active { color: #fff !important; border-bottom: 2px solid var(--cor-marca); }

    .tour-btn-ajuda {
        width: 26px; height: 26px;
        border-radius: 50%;
        border: 1px solid #555;
        background: transparent;
        color: #ccc;
        font-size: var(--txt-sm);
        font-weight: var(--peso-forte);
        cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .tour-btn-ajuda:hover { background: #2a2a2a; color: #fff; border-color: #888; }

    .navbar-user { position: relative; }
    .navbar-user-btn {
        display: flex; align-items: center; gap: var(--sp-2);
        background: transparent; border: none; cursor: pointer;
        color: #ccc; font-size: var(--txt-sm); font-family: inherit;
    }
    .navbar-avatar {
        width: 28px; height: 28px;
        border-radius: 50%;
        background: var(--cor-marca);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: var(--txt-xs); font-weight: var(--peso-forte);
    }
    .dropdown-seta { font-size: 10px; color: #888; }

    .dropdown-menu {
        position: absolute;
        top: 130%;
        right: 0;
        background: var(--cor-superficie);
        border: 1px solid var(--cor-linha);
        border-radius: var(--raio-md);
        min-width: 180px;
        box-shadow: var(--sombra-menu);
        padding: var(--sp-2) 0;
        z-index: 200;
    }
    .dropdown-header { padding: var(--sp-2) var(--sp-4); border-bottom: 1px solid var(--cor-linha-suave); margin-bottom: var(--sp-1); }
    .dropdown-nome { font-weight: var(--peso-medio); color: var(--cor-tinta); }
    .dropdown-role { font-size: var(--txt-xs); color: var(--cor-tinta-3); margin-top: 2px; }
    .dropdown-item {
        display: block; width: 100%; text-align: left;
        padding: var(--sp-2) var(--sp-4);
        background: none; border: none;
        color: var(--cor-tinta-2); font-size: var(--txt-sm); cursor: pointer; font-family: inherit;
    }
    .dropdown-item:hover { background: var(--cor-superficie-2); }

    @@media (max-width: 900px) {
        .navbar { padding: 0 var(--sp-3); flex-wrap: wrap; }
        .navbar-hamburguer { display: flex; order: 3; }
        .navbar-links {
            order: 4;
            display: none;
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            width: 100%;
            background: var(--cor-tinta);
            border-top: 1px solid #333;
        }
        .navbar-links.aberto { display: flex; }
        .navbar-links > .nav-link { padding: 12px 4px; border-bottom: 1px solid #2a2a2a; }
        .navbar-links .nav-link-active { border-bottom: 1px solid #2a2a2a; border-left: 3px solid var(--cor-marca); padding-left: 12px; }
    }

    @@media (max-width: 420px) {
        .navbar-user-nome { display: none; }
        .dropdown-menu { right: -12px; }
    }
</style>
